#SQL/Snowflake/crt/CreateAttributeTriggers.js
#SQL/Snowflake/crt/CreateAnchorTriggers.js
#SQL/Snowflake/crt/AddTieRestatementConstraints.js
#SQL/Snowflake/biz/DropTieBusinessPerspectives.js
SQL/Snowflake/crt/CreateTiePerspectives.sisula
#SQL/Snowflake/biz/CreateTieBusinessPerspectives.js
#SQL/Snowflake/crt/CreateTieTriggers.js
#SQL/Snowflake/CreateSchemaTracking.js
