# This is the processing directive for concurrent-reliance-temporal Anchor Modeling in Snowflake
#
# The templates are in the Sisula language (docs/SISULA.md) and render the JSON bindings that the
# modeler builds (Generate > JSON bindings). The scripts first in the list prepare the schema that the
# bindings are made from; they run once, before the templates. A line starting with # is not run.
# Snowflake_crt.legacy.directive is the previous version of this list, in the original dialect. The
# golden files in sisula/examples/anchor-snowflake come from it.
SQL/Helpers.js
SQL/NamingConvention.js
SQL/Snowflake/NamingConvention.js
SQL/Snowflake/derive.js
SQL/Snowflake/crt/CreatePositorAndDefault.sisula
SQL/Snowflake/crt/CreateKnots.sisula
SQL/Snowflake/crt/CreateAnchors.sisula
SQL/Snowflake/crt/CreateNexuses.sisula
SQL/Snowflake/crt/CreateAttributes.sisula
SQL/Snowflake/crt/CreateAttributeAssembledViews.sisula
SQL/Snowflake/crt/CreateAttributeRewinders.sisula
SQL/Snowflake/crt/CreateTies.sisula
SQL/Snowflake/crt/CreateTieAssembledViews.sisula
SQL/Snowflake/crt/CreateTieRewinders.sisula
# to be ported next in native CRT form
#SQL/Snowflake/crt/AddAttributeRestatementConstraints.js
#SQL/Snowflake/crt/CreateKeyGenerators.js
#SQL/Snowflake/biz/DropAnchorBusinessPerspectives.js
# Native CRT perspectives
SQL/Snowflake/crt/CreateAnchorPerspectives.sisula
SQL/Snowflake/crt/CreateNexusPerspectives.sisula
