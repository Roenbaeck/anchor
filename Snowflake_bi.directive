# This is the processing directive for bi-temporal Anchor Modeling in Snowflake
#
# The templates are in the Sisula language (docs/SISULA.md) and render the JSON bindings that the
# modeler builds (Generate > JSON bindings). The scripts first in the list prepare the schema that the
# bindings are made from; they run once, before the templates. A line starting with # is not run.
# Snowflake_bi.legacy.directive is the previous version of this list, in the original dialect. The
# golden files in sisula/examples/anchor-snowflake come from it.
SQL/Helpers.js
SQL/NamingConvention.js
SQL/Snowflake/NamingConvention.js
SQL/Snowflake/derive.js
SQL/Snowflake/bi/CreateKnots.sisula
SQL/Snowflake/bi/CreateAnchors.sisula
SQL/Snowflake/bi/CreateNexuses.sisula
SQL/Snowflake/bi/CreateAttributes.sisula
#SQL/Snowflake/bi/CreateAttributeAssembledViews.js
SQL/Snowflake/bi/CreateAttributeRewinders.sisula
#SQL/Snowflake/bi/AddAttributeRestatementConstraints.js
#SQL/Snowflake/biz/DropAnchorBusinessPerspectives.js
SQL/Snowflake/bi/CreateAnchorPerspectives.sisula
#SQL/Snowflake/biz/CreateAnchorBusinessPerspectives.js
#SQL/Snowflake/biz/DropNexusBusinessPerspectives.js
SQL/Snowflake/bi/CreateNexusPerspectives.sisula
#SQL/Snowflake/biz/CreateNexusBusinessPerspectives.js
#SQL/Snowflake/bi/CreateKeyGenerators.js
#SQL/Snowflake/bi/CreateAttributeTriggers.js
#SQL/Snowflake/bi/CreateAnchorTriggers.js
#SQL/Snowflake/bi/CreateNexusTriggers.js
