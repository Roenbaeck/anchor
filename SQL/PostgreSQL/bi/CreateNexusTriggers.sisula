$/ if schema.TRIGGERS
-- NEXUS TRIGGERS ---------------------------------------------------------------------------------------------------
--
-- The following triggers on the latest view make it behave like a table.
-- There are three different 'instead of' triggers: insert, update, and delete.
-- They will ensure that such operations are propagated to the assembled views of the attributes (whose triggers keep the
-- posit and annex tables) in a consistent way. Default values are used for some columns if not provided by the
-- corresponding SQL statements: the changing and positing times are now, the reliability is 1.
--
-- For idempotent attributes, only changes that represent a value different from
-- the previous or following value are stored. Others are silently ignored in
-- order to avoid unnecessary temporal duplicates (the triggers of the attributes see to that).
--
-- PostgreSQL runs a trigger of this kind for each row, so a statement is a row at a time. Whether a column is set in an UPDATE
-- is told from whether it has another value than the row had.
--
$/ foreach nexus in schema.nexuses
$/ if nexus.attributes
-- Insert trigger -----------------------------------------------------------------------------------------------------
-- it_l$nexus.name$ instead of INSERT trigger on l$nexus.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $nexus.capsule$."it_l$nexus.name$"()
RETURNS trigger
AS
$$
DECLARE
    _now $schema.metadata.chronon$ := $schema.metadata.now$::$schema.metadata.chronon$;
    _id $nexus.identity$;
$/ foreach attribute in nexus.attributes
$/ if attribute.isKnotted
    _$attribute.mnemonic$ $attribute.knot.identity$;
$/ endif
$/ endfor
BEGIN
    _id := NEW."$nexus.identityColumnName$";
    IF _id IS NULL THEN
        INSERT INTO $nexus.capsule$."$nexus.name$" (
$/ foreach role in nexus.roles
            "$role.columnName$",
$/ endfor
$/ if schema.METADATA
            "$nexus.metadataColumnName$"
$/ else
            "$nexus.dummyColumnName$"
$/ endif
        )
        VALUES (
$/ foreach role in nexus.roles
            NEW."$role.columnName$",
$/ endfor
$/ if schema.METADATA
            NEW."$nexus.metadataColumnName$"
$/ else
            null
$/ endif
        )
        RETURNING "$nexus.identityColumnName$" INTO _id;
    END IF;
$/ foreach attribute in nexus.attributes
$/ if attribute.isKnotted
    _$attribute.mnemonic$ := NEW."$attribute.valueColumnName$";
    IF _$attribute.mnemonic$ IS NULL AND NEW."$attribute.knotValueColumnName$" IS NOT NULL THEN
        SELECT
            k."$attribute.knot.identityColumnName$"
        INTO
            _$attribute.mnemonic$
        FROM
            $attribute.knot.capsule$."$attribute.knot.name$" k
        WHERE
$/ if attribute.knot.hasChecksum
            k."$attribute.knot.checksumColumnName$" = decode(md5(NEW."$attribute.knotValueColumnName$"::text), 'hex')
$/ else
            k."$attribute.knot.valueColumnName$" = NEW."$attribute.knotValueColumnName$"
$/ endif
        LIMIT 1;
    END IF;
    IF _$attribute.mnemonic$ IS NOT NULL THEN
$/ else
    IF NEW."$attribute.valueColumnName$" IS NOT NULL THEN
$/ endif
        INSERT INTO $attribute.capsule$."$attribute.name$" (
$/ if schema.METADATA
            "$attribute.metadataColumnName$",
$/ endif
            "$attribute.entityReferenceName$",
            "$attribute.valueColumnName$",
$/ if attribute.isHistorized
            "$attribute.changingColumnName$",
$/ endif
            "$attribute.positingColumnName$",
            "$attribute.reliabilityColumnName$"
        )
        VALUES (
$/ if schema.METADATA
            coalesce(NEW."$attribute.metadataColumnName$", NEW."$nexus.metadataColumnName$"),
$/ endif
$/ if schema.IMPROVED
            coalesce(NEW."$attribute.entityReferenceName$", _id),
$/ else
            _id,
$/ endif
$/ if attribute.isKnotted
            _$attribute.mnemonic$,
$/ else
            NEW."$attribute.valueColumnName$",
$/ endif
$/ if attribute.isHistorized
            coalesce(NEW."$attribute.changingColumnName$", _now),
$/ endif
            coalesce(NEW."$attribute.positingColumnName$", _now),
            coalesce(NEW."$attribute.reliabilityColumnName$", NEW."$schema.metadata.reliabilitySuffix$", 1)
        );
    END IF;
$/ endfor
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;
DROP TRIGGER IF EXISTS "it_l$nexus.name$" ON $nexus.capsule$."l$nexus.name$";
CREATE TRIGGER "it_l$nexus.name$"
INSTEAD OF INSERT ON $nexus.capsule$."l$nexus.name$"
FOR EACH ROW EXECUTE FUNCTION $nexus.capsule$."it_l$nexus.name$"();
-- UPDATE trigger -----------------------------------------------------------------------------------------------------
-- ut_l$nexus.name$ instead of UPDATE trigger on l$nexus.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $nexus.capsule$."ut_l$nexus.name$"()
RETURNS trigger
AS
$$
DECLARE
    _now $schema.metadata.chronon$ := $schema.metadata.now$::$schema.metadata.chronon$;
    _reliability $schema.metadata.reliabilityRange$;
    _positing $schema.metadata.positingRange$;
$/ foreach attribute in nexus.attributes
$/ if attribute.isKnotted
    _$attribute.mnemonic$ $attribute.knot.identity$;
$/ endif
$/ endfor
BEGIN
    IF NEW."$nexus.identityColumnName$" IS DISTINCT FROM OLD."$nexus.identityColumnName$" THEN
        RAISE EXCEPTION 'The identity column $nexus.identityColumnName$ is not updatable.';
    END IF;
$/ foreach role in nexus.roles
    IF NEW."$role.columnName$" IS DISTINCT FROM OLD."$role.columnName$" THEN
        RAISE EXCEPTION 'The role column $role.columnName$ is not updatable.';
    END IF;
$/ if role.knot
    IF NEW."$role.knotValueColumnName$" IS DISTINCT FROM OLD."$role.knotValueColumnName$" THEN
        RAISE EXCEPTION 'The role column $role.knotValueColumnName$ is not updatable.';
    END IF;
$/ endif
$/ endfor
$/ foreach attribute in nexus.attributes
    IF NEW."$attribute.identityColumnName$" IS DISTINCT FROM OLD."$attribute.identityColumnName$" THEN
        RAISE EXCEPTION 'The identity column $attribute.identityColumnName$ is not updatable.';
    END IF;
$/ if schema.IMPROVED
    IF NEW."$attribute.entityReferenceName$" IS DISTINCT FROM OLD."$attribute.entityReferenceName$" THEN
        RAISE EXCEPTION 'The foreign key column $attribute.entityReferenceName$ is not updatable.';
    END IF;
$/ endif
    -- what the update says about the reliability of $attribute.name$, and when it posits
    _reliability := CASE
        WHEN NEW."$attribute.reliabilityColumnName$" IS DISTINCT FROM OLD."$attribute.reliabilityColumnName$" THEN NEW."$attribute.reliabilityColumnName$"
        WHEN NEW."$schema.metadata.reliabilitySuffix$" IS DISTINCT FROM OLD."$schema.metadata.reliabilitySuffix$" THEN NEW."$schema.metadata.reliabilitySuffix$"
        ELSE NEW."$attribute.reliabilityColumnName$"
    END;
    _positing := CASE
        WHEN NEW."$attribute.positingColumnName$" IS DISTINCT FROM OLD."$attribute.positingColumnName$" THEN NEW."$attribute.positingColumnName$"
$/ if attribute.isHistorized
        WHEN NEW."$attribute.changingColumnName$" IS DISTINCT FROM OLD."$attribute.changingColumnName$" AND NEW."$attribute.valueColumnName$" IS NULL THEN NEW."$attribute.changingColumnName$"
$/ endif
        ELSE _now
    END;
$/ if attribute.isKnotted
    _$attribute.mnemonic$ := NEW."$attribute.valueColumnName$";
    IF _$attribute.mnemonic$ IS NOT DISTINCT FROM OLD."$attribute.valueColumnName$" AND NEW."$attribute.knotValueColumnName$" IS DISTINCT FROM OLD."$attribute.knotValueColumnName$" THEN
        _$attribute.mnemonic$ := NULL;
        IF NEW."$attribute.knotValueColumnName$" IS NOT NULL THEN
            SELECT
                k."$attribute.knot.identityColumnName$"
            INTO
                _$attribute.mnemonic$
            FROM
                $attribute.knot.capsule$."$attribute.knot.name$" k
            WHERE
$/ if attribute.knot.hasChecksum
                k."$attribute.knot.checksumColumnName$" = decode(md5(NEW."$attribute.knotValueColumnName$"::text), 'hex')
$/ else
                k."$attribute.knot.valueColumnName$" = NEW."$attribute.knotValueColumnName$"
$/ endif
            LIMIT 1;
        END IF;
    END IF;
    IF NEW."$attribute.valueColumnName$" IS DISTINCT FROM OLD."$attribute.valueColumnName$"
    OR NEW."$attribute.knotValueColumnName$" IS DISTINCT FROM OLD."$attribute.knotValueColumnName$"
$/ else
    IF NEW."$attribute.valueColumnName$" IS DISTINCT FROM OLD."$attribute.valueColumnName$"
$/ endif
$/ if attribute.isHistorized
    OR NEW."$attribute.changingColumnName$" IS DISTINCT FROM OLD."$attribute.changingColumnName$"
$/ endif
    OR NEW."$attribute.positingColumnName$" IS DISTINCT FROM OLD."$attribute.positingColumnName$"
    OR NEW."$attribute.reliabilityColumnName$" IS DISTINCT FROM OLD."$attribute.reliabilityColumnName$"
    OR NEW."$schema.metadata.reliabilitySuffix$" IS DISTINCT FROM OLD."$schema.metadata.reliabilitySuffix$"
    THEN
$/ if attribute.isKnotted
        IF _$attribute.mnemonic$ IS NOT NULL THEN
$/ else
        IF NEW."$attribute.valueColumnName$" IS NOT NULL THEN
$/ endif
            -- a statement that leaves everything as it is states nothing
            IF OLD."$attribute.valueColumnName$" IS NULL
$/ if attribute.isHistorized
            OR NEW."$attribute.changingColumnName$" IS DISTINCT FROM OLD."$attribute.changingColumnName$"
$/ endif
            OR NEW."$attribute.positingColumnName$" IS DISTINCT FROM OLD."$attribute.positingColumnName$"
            OR OLD."$attribute.reliabilityColumnName$" IS DISTINCT FROM coalesce(_reliability, 1)
$/ if attribute.isKnotted
            OR OLD."$attribute.valueColumnName$" <> _$attribute.mnemonic$
$/ else
$/ if attribute.hasChecksum
            OR md5(OLD."$attribute.valueColumnName$"::text) <> md5(NEW."$attribute.valueColumnName$"::text)
$/ else
$/ if attribute.isComparable
            OR OLD."$attribute.valueColumnName$" <> NEW."$attribute.valueColumnName$"
$/ else
            OR OLD."$attribute.valueColumnName$"::text <> NEW."$attribute.valueColumnName$"::text
$/ endif
$/ endif
$/ endif
            THEN
                INSERT INTO $attribute.capsule$."$attribute.name$" (
$/ if schema.METADATA
                    "$attribute.metadataColumnName$",
$/ endif
                    "$attribute.entityReferenceName$",
                    "$attribute.valueColumnName$",
$/ if attribute.isHistorized
                    "$attribute.changingColumnName$",
$/ endif
                    "$attribute.positingColumnName$",
                    "$attribute.reliabilityColumnName$"
                )
                VALUES (
$/ if schema.METADATA
                    coalesce(
                        CASE
                            WHEN NEW."$nexus.metadataColumnName$" IS DISTINCT FROM OLD."$nexus.metadataColumnName$"
                             AND NEW."$attribute.metadataColumnName$" IS NOT DISTINCT FROM OLD."$attribute.metadataColumnName$"
                            THEN NEW."$nexus.metadataColumnName$"
                            ELSE NEW."$attribute.metadataColumnName$"
                        END, NEW."$nexus.metadataColumnName$"),
$/ endif
$/ if schema.IMPROVED
                    coalesce(NEW."$attribute.entityReferenceName$", NEW."$nexus.identityColumnName$"),
$/ else
                    NEW."$nexus.identityColumnName$",
$/ endif
$/ if attribute.isKnotted
                    _$attribute.mnemonic$,
$/ else
                    NEW."$attribute.valueColumnName$",
$/ endif
$/ if attribute.isHistorized
                    -- the shown version asserted again keeps its changing time, as does one that is given
                    CASE
                        WHEN NEW."$attribute.changingColumnName$" IS DISTINCT FROM OLD."$attribute.changingColumnName$" THEN NEW."$attribute.changingColumnName$"
$/ if attribute.isKnotted
                        WHEN OLD."$attribute.valueColumnName$" = _$attribute.mnemonic$ THEN NEW."$attribute.changingColumnName$"
$/ else
$/ if attribute.hasChecksum
                        WHEN md5(OLD."$attribute.valueColumnName$"::text) = md5(NEW."$attribute.valueColumnName$"::text) THEN NEW."$attribute.changingColumnName$"
$/ else
$/ if attribute.isComparable
                        WHEN OLD."$attribute.valueColumnName$" = NEW."$attribute.valueColumnName$" THEN NEW."$attribute.changingColumnName$"
$/ else
                        WHEN OLD."$attribute.valueColumnName$"::text = NEW."$attribute.valueColumnName$"::text THEN NEW."$attribute.changingColumnName$"
$/ endif
$/ endif
$/ endif
                        ELSE _now
                    END,
$/ endif
                    _positing,
                    coalesce(_reliability, 1)
                );
            END IF;
        END IF;
$/ if attribute.isKnotted
        -- logical delete by setting the value to null
        IF OLD."$attribute.valueColumnName$" IS NOT NULL AND (
            NEW."$attribute.valueColumnName$" IS NULL OR (
                NEW."$attribute.valueColumnName$" = OLD."$attribute.valueColumnName$"
                AND NEW."$attribute.knotValueColumnName$" IS NULL AND OLD."$attribute.knotValueColumnName$" IS NOT NULL
            )
        ) THEN
$/ else
        -- logical delete by setting the value to null
        IF NEW."$attribute.valueColumnName$" IS NULL AND OLD."$attribute.valueColumnName$" IS NOT NULL THEN
$/ endif
            INSERT INTO $attribute.capsule$."$attribute.name$" (
$/ if schema.METADATA
                "$attribute.metadataColumnName$",
$/ endif
                "$attribute.entityReferenceName$",
                "$attribute.valueColumnName$",
$/ if attribute.isHistorized
                "$attribute.changingColumnName$",
$/ endif
                "$attribute.positingColumnName$",
                "$attribute.reliabilityColumnName$"
            )
            SELECT
$/ if schema.METADATA
                coalesce(
                    CASE
                        WHEN NEW."$nexus.metadataColumnName$" IS DISTINCT FROM OLD."$nexus.metadataColumnName$"
                         AND NEW."$attribute.metadataColumnName$" IS NOT DISTINCT FROM OLD."$attribute.metadataColumnName$"
                        THEN NEW."$nexus.metadataColumnName$"
                        ELSE NEW."$attribute.metadataColumnName$"
                    END, NEW."$nexus.metadataColumnName$"),
$/ endif
                p."$attribute.entityReferenceName$",
                p."$attribute.valueColumnName$",
$/ if attribute.isHistorized
                p."$attribute.changingColumnName$",
$/ endif
                _positing,
                0
            FROM
                $attribute.capsule$."$attribute.positName$" p
            WHERE
                p."$attribute.identityColumnName$" = OLD."$attribute.identityColumnName$";
        END IF;
    END IF;
$/ endfor
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;
DROP TRIGGER IF EXISTS "ut_l$nexus.name$" ON $nexus.capsule$."l$nexus.name$";
CREATE TRIGGER "ut_l$nexus.name$"
INSTEAD OF UPDATE ON $nexus.capsule$."l$nexus.name$"
FOR EACH ROW EXECUTE FUNCTION $nexus.capsule$."ut_l$nexus.name$"();
-- DELETE trigger -----------------------------------------------------------------------------------------------------
-- dt_l$nexus.name$ instead of DELETE trigger on l$nexus.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $nexus.capsule$."dt_l$nexus.name$"()
RETURNS trigger
AS
$$
DECLARE
    _now $schema.metadata.chronon$ := $schema.metadata.now$::$schema.metadata.chronon$;
BEGIN
$/ foreach attribute in nexus.attributes
    -- what is shown of $attribute.name$ is retracted
    INSERT INTO $attribute.capsule$."$attribute.annexName$" (
$/ if schema.METADATA
        "$attribute.metadataColumnName$",
$/ endif
        "$attribute.identityColumnName$",
        "$attribute.positingColumnName$",
        "$attribute.reliabilityColumnName$"
    )
    SELECT
$/ if schema.METADATA
        OLD."$attribute.metadataColumnName$",
$/ endif
        OLD."$attribute.identityColumnName$",
        _now,
        0
    WHERE
        OLD."$attribute.identityColumnName$" IS NOT NULL
    ON CONFLICT DO NOTHING;
$/ endfor
    RETURN OLD;
END;
$$ LANGUAGE plpgsql;
DROP TRIGGER IF EXISTS "dt_l$nexus.name$" ON $nexus.capsule$."l$nexus.name$";
CREATE TRIGGER "dt_l$nexus.name$"
INSTEAD OF DELETE ON $nexus.capsule$."l$nexus.name$"
FOR EACH ROW EXECUTE FUNCTION $nexus.capsule$."dt_l$nexus.name$"();
$/ endif
$/ endfor
$/ endif
