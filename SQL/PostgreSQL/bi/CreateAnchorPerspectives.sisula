-- ANCHOR TEMPORAL PERSPECTIVES ---------------------------------------------------------------------------------------
--
-- BI anchor perspectives: time traveling (t), latest (l), point-in-time (p),
-- now (n), and difference (d).
--
$/ foreach anchor in schema.anchors
$/ if anchor.attributes
CREATE OR REPLACE FUNCTION $anchor.capsule$."t$anchor.name$" (
    changingTimepoint $schema.metadata.chronon$,
    positingTimepoint $schema.metadata.positingRange$
)
RETURNS TABLE (
    "$anchor.identityColumnName$" $anchor.identity$,
$/ if schema.METADATA
    "$anchor.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.entityReferenceName$" $anchor.identity$,
$/ endif
$/ if schema.METADATA
    "$attribute.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
    "$attribute.identityColumnName$" $attribute.identity$,
$/ if attribute.timeRange
    "$attribute.changingColumnName$" $attribute.timeRange$,
$/ endif
    "$attribute.positingColumnName$" $schema.metadata.positingRange$,
    "$attribute.reliabilityColumnName$" $schema.metadata.reliabilityRange$,
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "$attribute.knotChecksumColumnName$" bytea,
$/ endif
    "$attribute.knotValueColumnName$" $attribute.knot.dataRange$,
$/ if schema.METADATA
    "$attribute.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.checksumColumnName$" bytea,
$/ endif
$/ if attribute.isKnotted
    "$attribute.valueColumnName$" $attribute.knot.identity$$/ if not attribute.last() ,$/ endif
$/ else
    "$attribute.valueColumnName$" $attribute.dataRange$$/ if not attribute.last() ,$/ endif
$/ endif
$/ endfor
)
AS
$$
SELECT
    "$anchor.mnemonic$"."$anchor.identityColumnName$",
$/ if schema.METADATA
    "$anchor.mnemonic$"."$anchor.metadataColumnName$",
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.mnemonic$"."$attribute.entityReferenceName$",
$/ endif
$/ if schema.METADATA
    "$attribute.mnemonic$"."$attribute.metadataColumnName$",
$/ endif
    "$attribute.mnemonic$"."$attribute.identityColumnName$",
$/ if attribute.timeRange
    "$attribute.mnemonic$"."$attribute.changingColumnName$",
$/ endif
    "$attribute.mnemonic$"."$attribute.positingColumnName$",
    "$attribute.mnemonic$"."$attribute.reliabilityColumnName$",
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "k$attribute.mnemonic$"."$attribute.knot.checksumColumnName$" AS "$attribute.knotChecksumColumnName$",
$/ endif
    "k$attribute.mnemonic$"."$attribute.knot.valueColumnName$" AS "$attribute.knotValueColumnName$",
$/ if schema.METADATA
    "k$attribute.mnemonic$"."$attribute.knot.metadataColumnName$" AS "$attribute.knotMetadataColumnName$",
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.mnemonic$"."$attribute.checksumColumnName$",
$/ endif
    "$attribute.mnemonic$"."$attribute.valueColumnName$"$/ if not attribute.last() ,$/ endif
$/ endfor
FROM
    $anchor.capsule$."$anchor.name$" "$anchor.mnemonic$"
$/ foreach attribute in anchor.attributes
LEFT JOIN (
    -- the latest asserted posit for each anchor, picked by a window
    SELECT DISTINCT ON (r."$attribute.entityReferenceName$")
        r.*
    FROM
        $attribute.capsule$."r$attribute.name$"(
$/ if attribute.isHistorized
            changingTimepoint::$attribute.timeRange$,
$/ endif
            positingTimepoint::$schema.metadata.positingRange$
        ) r
    WHERE
        r."$attribute.reliabilityColumnName$" = 1
    ORDER BY
    r."$attribute.entityReferenceName$",
$/ if attribute.isHistorized
    r."$attribute.changingColumnName$" DESC,
$/ endif
    r."$attribute.positingColumnName$" DESC
) "$attribute.mnemonic$"
ON
    "$attribute.mnemonic$"."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
$/ if attribute.isKnotted
LEFT JOIN
    $attribute.knot.capsule$."$attribute.knot.name$" "k$attribute.mnemonic$"
ON
    "k$attribute.mnemonic$"."$attribute.knot.identityColumnName$" = "$attribute.mnemonic$"."$attribute.knotReferenceName$"
$/ endif
$/ if attribute.last()
$$ LANGUAGE sql STABLE;
$/ endif
$/ endfor
CREATE OR REPLACE VIEW $anchor.capsule$."l$anchor.name$" AS
SELECT
    cast(null as $schema.metadata.reliabilityRange$) as "$schema.metadata.reliabilitySuffix$",
    "$anchor.mnemonic$".*
FROM
    $anchor.capsule$."t$anchor.name$"(
        $schema.EOT$::$schema.metadata.chronon$,
        $schema.EOT$::$schema.metadata.positingRange$
    ) "$anchor.mnemonic$"
;
CREATE OR REPLACE FUNCTION $anchor.capsule$."p$anchor.name$" (
    changingTimepoint $schema.metadata.chronon$
)
RETURNS TABLE (
    "$schema.metadata.reliabilitySuffix$" $schema.metadata.reliabilityRange$,
    "$anchor.identityColumnName$" $anchor.identity$,
$/ if schema.METADATA
    "$anchor.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.entityReferenceName$" $anchor.identity$,
$/ endif
$/ if schema.METADATA
    "$attribute.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
    "$attribute.identityColumnName$" $attribute.identity$,
$/ if attribute.timeRange
    "$attribute.changingColumnName$" $attribute.timeRange$,
$/ endif
    "$attribute.positingColumnName$" $schema.metadata.positingRange$,
    "$attribute.reliabilityColumnName$" $schema.metadata.reliabilityRange$,
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "$attribute.knotChecksumColumnName$" bytea,
$/ endif
    "$attribute.knotValueColumnName$" $attribute.knot.dataRange$,
$/ if schema.METADATA
    "$attribute.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.checksumColumnName$" bytea,
$/ endif
$/ if attribute.isKnotted
    "$attribute.valueColumnName$" $attribute.knot.identity$$/ if not attribute.last() ,$/ endif
$/ else
    "$attribute.valueColumnName$" $attribute.dataRange$$/ if not attribute.last() ,$/ endif
$/ endif
$/ endfor
)
AS
$$
SELECT
    cast(null as $schema.metadata.reliabilityRange$) as "$schema.metadata.reliabilitySuffix$",
    "$anchor.mnemonic$"."$anchor.identityColumnName$",
$/ if schema.METADATA
    "$anchor.mnemonic$"."$anchor.metadataColumnName$",
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$anchor.mnemonic$"."$attribute.entityReferenceName$",
$/ endif
$/ if schema.METADATA
    "$anchor.mnemonic$"."$attribute.metadataColumnName$",
$/ endif
    "$anchor.mnemonic$"."$attribute.identityColumnName$",
$/ if attribute.timeRange
    "$anchor.mnemonic$"."$attribute.changingColumnName$",
$/ endif
    "$anchor.mnemonic$"."$attribute.positingColumnName$",
    "$anchor.mnemonic$"."$attribute.reliabilityColumnName$",
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "$anchor.mnemonic$"."$attribute.knotChecksumColumnName$",
$/ endif
    "$anchor.mnemonic$"."$attribute.knotValueColumnName$",
$/ if schema.METADATA
    "$anchor.mnemonic$"."$attribute.knotMetadataColumnName$",
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$anchor.mnemonic$"."$attribute.checksumColumnName$",
$/ endif
    "$anchor.mnemonic$"."$attribute.valueColumnName$"$/ if not attribute.last() ,$/ endif
$/ endfor
FROM
    $anchor.capsule$."t$anchor.name$"(
        changingTimepoint::$schema.metadata.chronon$,
        $schema.EOT$::$schema.metadata.positingRange$
    ) "$anchor.mnemonic$"
$$ LANGUAGE sql STABLE;
CREATE OR REPLACE VIEW $anchor.capsule$."n$anchor.name$" AS
SELECT
    cast(null as $schema.metadata.reliabilityRange$) as "$schema.metadata.reliabilitySuffix$",
    "$anchor.mnemonic$".*
FROM
    $anchor.capsule$."t$anchor.name$"(
        $schema.metadata.now$::$schema.metadata.chronon$,
        $schema.EOT$::$schema.metadata.positingRange$
    ) "$anchor.mnemonic$"
;
$/ if anchor.historizedAttributes
CREATE OR REPLACE FUNCTION $anchor.capsule$."d$anchor.name$" (
    intervalStart $schema.metadata.chronon$,
    intervalEnd $schema.metadata.chronon$,
    selection text
)
RETURNS TABLE (
    inspectedTimepoint $schema.metadata.chronon$,
    "$anchor.identityColumnName$" $anchor.identity$,
$/ if schema.METADATA
    "$anchor.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.entityReferenceName$" $anchor.identity$,
$/ endif
$/ if schema.METADATA
    "$attribute.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
    "$attribute.identityColumnName$" $attribute.identity$,
$/ if attribute.timeRange
    "$attribute.changingColumnName$" $attribute.timeRange$,
$/ endif
    "$attribute.positingColumnName$" $schema.metadata.positingRange$,
    "$attribute.reliabilityColumnName$" $schema.metadata.reliabilityRange$,
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "$attribute.knotChecksumColumnName$" bytea,
$/ endif
    "$attribute.knotValueColumnName$" $attribute.knot.dataRange$,
$/ if schema.METADATA
    "$attribute.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.checksumColumnName$" bytea,
$/ endif
$/ if attribute.isKnotted
    "$attribute.valueColumnName$" $attribute.knot.identity$$/ if not attribute.last() ,$/ endif
$/ else
    "$attribute.valueColumnName$" $attribute.dataRange$$/ if not attribute.last() ,$/ endif
$/ endif
$/ endfor
)
AS
$$
-- each change in the interval, with what the time-traveling perspective shows then as it is known now: every latest
-- asserted posit is joined with the changing time until which it holds, when the next one does. The time-traveling
-- perspective is not called for each change; the posits are worked out for all of them in one pass.
SELECT
    timepoints.inspectedTimepoint,
    "$anchor.mnemonic$"."$anchor.identityColumnName$",
$/ if schema.METADATA
    "$anchor.mnemonic$"."$anchor.metadataColumnName$",
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.mnemonic$"."$attribute.entityReferenceName$",
$/ endif
$/ if schema.METADATA
    "$attribute.mnemonic$"."$attribute.metadataColumnName$",
$/ endif
    "$attribute.mnemonic$"."$attribute.identityColumnName$",
$/ if attribute.timeRange
    "$attribute.mnemonic$"."$attribute.changingColumnName$",
$/ endif
    "$attribute.mnemonic$"."$attribute.positingColumnName$",
    "$attribute.mnemonic$"."$attribute.reliabilityColumnName$",
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "k$attribute.mnemonic$"."$attribute.knot.checksumColumnName$" AS "$attribute.knotChecksumColumnName$",
$/ endif
    "k$attribute.mnemonic$"."$attribute.knot.valueColumnName$" AS "$attribute.knotValueColumnName$",
$/ if schema.METADATA
    "k$attribute.mnemonic$"."$attribute.knot.metadataColumnName$" AS "$attribute.knotMetadataColumnName$",
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.mnemonic$"."$attribute.checksumColumnName$",
$/ endif
    "$attribute.mnemonic$"."$attribute.valueColumnName$"$/ if not attribute.last() ,$/ endif
$/ endfor
FROM (
$/ foreach historized in anchor.historizedAttributes
    SELECT DISTINCT
        "$historized.entityReferenceName$" AS "$anchor.identityColumnName$",
        "$historized.changingColumnName$"::$schema.metadata.chronon$ AS inspectedTimepoint,
        '$historized.mnemonic$' AS mnemonic
    FROM
        $historized.capsule$."$historized.name$"
    WHERE
        (selection IS NULL OR selection LIKE '%$historized.mnemonic$%')
    AND
        "$historized.changingColumnName$" BETWEEN intervalStart AND intervalEnd
$/ if not historized.last()
    UNION
$/ endif
$/ endfor
) timepoints
JOIN
    $anchor.capsule$."$anchor.name$" "$anchor.mnemonic$"
ON
    "$anchor.mnemonic$"."$anchor.identityColumnName$" = timepoints."$anchor.identityColumnName$"
$/ foreach attribute in anchor.attributes
LEFT JOIN (
$/ if attribute.isHistorized
    SELECT
        x.*,
        lead(x."$attribute.changingColumnName$") OVER (
            PARTITION BY x."$attribute.entityReferenceName$"
            ORDER BY x."$attribute.changingColumnName$"
        ) AS "until"
    FROM (
        -- the latest asserted posit at each changing time
        SELECT DISTINCT ON (r."$attribute.entityReferenceName$", r."$attribute.changingColumnName$")
            r.*
        FROM
            $attribute.capsule$."r$attribute.name$"(
                $schema.EOT$::$attribute.timeRange$,
                $schema.EOT$::$schema.metadata.positingRange$
            ) r
        WHERE
            r."$attribute.reliabilityColumnName$" = 1
        ORDER BY
    r."$attribute.entityReferenceName$", r."$attribute.changingColumnName$",
    r."$attribute.positingColumnName$" DESC
    ) x
$/ else
    SELECT DISTINCT ON (r."$attribute.entityReferenceName$")
        r.*
    FROM
        $attribute.capsule$."r$attribute.name$"(
            $schema.EOT$::$schema.metadata.positingRange$
        ) r
    WHERE
        r."$attribute.reliabilityColumnName$" = 1
    ORDER BY
    r."$attribute.entityReferenceName$",
    r."$attribute.positingColumnName$" DESC
$/ endif
) "$attribute.mnemonic$"
ON
    "$attribute.mnemonic$"."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
$/ if attribute.isHistorized
AND
    "$attribute.mnemonic$"."$attribute.changingColumnName$" <= timepoints.inspectedTimepoint::$attribute.timeRange$
AND (
    "$attribute.mnemonic$"."until" IS NULL
OR
    "$attribute.mnemonic$"."until" > timepoints.inspectedTimepoint::$attribute.timeRange$
)
$/ endif
$/ if attribute.isKnotted
LEFT JOIN
    $attribute.knot.capsule$."$attribute.knot.name$" "k$attribute.mnemonic$"
ON
    "k$attribute.mnemonic$"."$attribute.knot.identityColumnName$" = "$attribute.mnemonic$"."$attribute.knotReferenceName$"
$/ endif
$/ endfor
$$ LANGUAGE sql STABLE;
$/ endif
$/ endif
$/ endfor
