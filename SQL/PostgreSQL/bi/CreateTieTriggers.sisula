$/ if schema.TRIGGERS
-- TIE TRIGGERS -------------------------------------------------------------------------------------------------------
--
-- The following triggers on the assembled and latest views make them behave like tables.
-- The assembled view has an 'instead of' trigger for insert, which keeps the posit and annex tables. The latest view has
-- three: insert, update, and delete. They propagate such operations to the assembled view in a consistent way. Default
-- values are used for some columns if not provided by the corresponding SQL statements: the changing and positing times
-- are now, the reliability is 1.
--
-- The rules are the ones of the attributes (see the attribute triggers). A tie that has identifiers and other roles, which
-- are its values, is decisive about the values of the identifiers (at a changing time): an assertion of other values retracts,
-- at its own positing time, the posit that is in effect, which is a correction.
--
-- For idempotent ties, only changes that represent values different from the previous or following value are stored.
-- Others are silently ignored in order to avoid unnecessary temporal duplicates.
--
-- PostgreSQL runs a trigger of this kind for each row, so a statement is a row at a time. Whether a column is set in an UPDATE
-- is told from whether it has another value than the row had.
--
$/ foreach tie in schema.ties
-- In effect ------------------------------------------------------------------------------------------------------------
-- ie_$tie.name$ tells whether a posit is asserted at a positing time: its latest annex row up to then asserts it
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."ie_$tie.name$"(
    _id $tie.identity$,
    _positing $schema.metadata.positingRange$
)
RETURNS boolean
AS
$$
    SELECT
        coalesce((
            SELECT
                a."$tie.reliabilityColumnName$" = 1
            FROM
                $tie.capsule$."$tie.annexName$" a
            WHERE
                a."$tie.identityColumnName$" = _id
            AND
                a."$tie.positingColumnName$" <= _positing
            ORDER BY
                a."$tie.positingColumnName$" DESC
            LIMIT 1
        ), false)
$$ LANGUAGE sql STABLE;
-- Insert trigger -----------------------------------------------------------------------------------------------------
-- it_$tie.name$ instead of INSERT trigger on $tie.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."it_$tie.name$"()
RETURNS trigger
AS
$$
DECLARE
    _now $schema.metadata.chronon$ := $schema.metadata.now$::$schema.metadata.chronon$;
    _positing $schema.metadata.positingRange$;
    _reliability $schema.metadata.reliabilityRange$;
$/ if tie.isHistorized
    _changing $tie.timeRange$;
$/ endif
    _posit $tie.identity$;
    _other $tie.identity$;
    _following $tie.identity$;
BEGIN
    _positing := coalesce(NEW."$tie.positingColumnName$", _now);
    _reliability := coalesce(NEW."$tie.reliabilityColumnName$", 1);
$/ if tie.isHistorized
    _changing := coalesce(NEW."$tie.changingColumnName$", _now);
$/ endif
    -- the posit, if there is one
    SELECT
        p."$tie.identityColumnName$"
    INTO
        _posit
    FROM
        $tie.capsule$."$tie.positName$" p
    WHERE
$/ foreach role in tie.roles
        p."$role.columnName$" = NEW."$role.columnName$"
    AND
$/ endfor
$/ if tie.isHistorized
        p."$tie.changingColumnName$" = _changing
$/ else
        true
$/ endif
    LIMIT 1;
    -- another reliability at a positing time that already has an assertion of the posit is a contradiction
    IF _posit IS NOT NULL AND EXISTS (
        SELECT
            1
        FROM
            $tie.capsule$."$tie.annexName$" a
        WHERE
            a."$tie.identityColumnName$" = _posit
        AND
            a."$tie.positingColumnName$" = _positing
        AND
            a."$tie.reliabilityColumnName$" <> _reliability
    ) THEN
        RAISE EXCEPTION 'Contradiction in $tie.name$ for: %', concat_ws(', ',
$/ foreach role in tie.roles
            NEW."$role.columnName$",
$/ endfor
$/ if tie.isHistorized
            _changing,
$/ endif
            _positing);
    END IF;
$/ if tie.identifiers and tie.values
    -- other values for identifiers that already have values at that time, asserted at the positing time, are a contradiction
    IF _reliability = 1 AND EXISTS (
        SELECT
            1
        FROM
            $tie.capsule$."$tie.positName$" p
        JOIN
            $tie.capsule$."$tie.annexName$" a
        ON
            a."$tie.identityColumnName$" = p."$tie.identityColumnName$"
        WHERE
$/ foreach role in tie.identifiers
            p."$role.columnName$" = NEW."$role.columnName$"
        AND
$/ endfor
$/ if tie.isHistorized
            p."$tie.changingColumnName$" = _changing
        AND
$/ endif
            NOT (
$/ foreach role in tie.values
                p."$role.columnName$" = NEW."$role.columnName$"
$/ if not role.last()
                AND
$/ endif
$/ endfor
            )
        AND
            a."$tie.positingColumnName$" = _positing
        AND
            a."$tie.reliabilityColumnName$" = 1
    ) THEN
        RAISE EXCEPTION 'Contradiction in $tie.name$ for: %', concat_ws(', ',
$/ foreach role in tie.roles
            NEW."$role.columnName$",
$/ endfor
$/ if tie.isHistorized
            _changing,
$/ endif
            _positing);
    END IF;
$/ endif
    -- the identical (the posit and the assertion are there already) states nothing
    IF _posit IS NOT NULL AND EXISTS (
        SELECT
            1
        FROM
            $tie.capsule$."$tie.annexName$" a
        WHERE
            a."$tie.identityColumnName$" = _posit
        AND
            a."$tie.positingColumnName$" = _positing
    ) THEN
        RETURN NULL;
    END IF;
    IF _reliability = 0 THEN
        -- a retraction of what is not asserted states nothing
        IF _posit IS NULL OR NOT $tie.capsule$."ie_$tie.name$"(_posit, _positing) THEN
            RETURN NULL;
        END IF;
        INSERT INTO $tie.capsule$."$tie.annexName$" (
$/ if schema.METADATA
            "$tie.metadataColumnName$",
$/ endif
            "$tie.identityColumnName$",
            "$tie.positingColumnName$",
            "$tie.reliabilityColumnName$"
        )
        VALUES (
$/ if schema.METADATA
            coalesce(NEW."$tie.metadataColumnName$", 0),
$/ endif
            _posit,
            _positing,
            _reliability
        );
        RETURN NEW;
    END IF;
$/ if not tie.isAssertive
    -- an assertion that is asserted already is skipped unless the tie is assertive
    IF _posit IS NOT NULL AND $tie.capsule$."ie_$tie.name$"(_posit, _positing) THEN
        RETURN NULL;
    END IF;
$/ endif
$/ if tie.identifiers and tie.values
    -- an assertion corrects what is asserted at the positing time for the same identifiers (and changing time), when that has
    -- other values: it is retracted at the positing time of the assertion, so that one posit at a time is asserted
    FOR _other IN
        SELECT
            p."$tie.identityColumnName$"
        FROM
            $tie.capsule$."$tie.positName$" p
        WHERE
$/ foreach role in tie.identifiers
            p."$role.columnName$" = NEW."$role.columnName$"
        AND
$/ endfor
$/ if tie.isHistorized
            p."$tie.changingColumnName$" = _changing
        AND
$/ endif
            NOT (
$/ foreach role in tie.values
                p."$role.columnName$" = NEW."$role.columnName$"
$/ if not role.last()
                AND
$/ endif
$/ endfor
            )
        AND
            $tie.capsule$."ie_$tie.name$"(p."$tie.identityColumnName$", _positing)
    LOOP
        INSERT INTO $tie.capsule$."$tie.annexName$" (
$/ if schema.METADATA
            "$tie.metadataColumnName$",
$/ endif
            "$tie.identityColumnName$",
            "$tie.positingColumnName$",
            "$tie.reliabilityColumnName$"
        )
        VALUES (
$/ if schema.METADATA
            coalesce(NEW."$tie.metadataColumnName$", 0),
$/ endif
            _other,
            _positing,
            0
        )
        ON CONFLICT DO NOTHING;
    END LOOP;
$/ endif
$/ if tie.isHistorized
$/ if tie.isIdempotent or not tie.isRestatable
    -- the same values as the version before it, which is asserted at the positing time, is a restatement
    IF EXISTS (
        SELECT
            1
        FROM (
            SELECT
$/ foreach role in tie.roles
                p."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
            FROM
                $tie.capsule$."$tie.positName$" p
            WHERE
$/ if tie.identifiers
$/ foreach role in tie.identifiers
                p."$role.columnName$" = NEW."$role.columnName$"
            AND
$/ endfor
$/ else
$/ foreach role in tie.values
                p."$role.columnName$" = NEW."$role.columnName$"
            AND
$/ endfor
$/ endif
                p."$tie.changingColumnName$" < _changing
            AND
                $tie.capsule$."ie_$tie.name$"(p."$tie.identityColumnName$", _positing)
            ORDER BY
                p."$tie.changingColumnName$" DESC
            LIMIT 1
        ) pre
        WHERE
$/ foreach role in tie.roles
            pre."$role.columnName$" = NEW."$role.columnName$"
$/ if not role.last()
        AND
$/ endif
$/ endfor
    ) THEN
$/ if tie.isIdempotent
        -- (an idempotent tie does not store it)
        RETURN NULL;
$/ else
        RAISE EXCEPTION 'Restatement in $tie.name$ for: %', concat_ws(', ',
$/ foreach role in tie.roles
            NEW."$role.columnName$",
$/ endfor
            _changing, _positing);
$/ endif
    END IF;
    -- the same values as the version after it make that version a restatement
    SELECT
        f."$tie.identityColumnName$"
    INTO
        _following
    FROM
        $tie.capsule$."$tie.positName$" f
    WHERE
$/ if tie.identifiers
$/ foreach role in tie.identifiers
        f."$role.columnName$" = NEW."$role.columnName$"
    AND
$/ endfor
$/ else
$/ foreach role in tie.values
        f."$role.columnName$" = NEW."$role.columnName$"
    AND
$/ endfor
$/ endif
        f."$tie.changingColumnName$" > _changing
    AND
        $tie.capsule$."ie_$tie.name$"(f."$tie.identityColumnName$", _positing)
    ORDER BY
        f."$tie.changingColumnName$" ASC
    LIMIT 1;
    IF _following IS NOT NULL AND EXISTS (
        SELECT
            1
        FROM
            $tie.capsule$."$tie.positName$" x
        WHERE
            x."$tie.identityColumnName$" = _following
$/ foreach role in tie.roles
        AND
            x."$role.columnName$" = NEW."$role.columnName$"
$/ endfor
    ) THEN
$/ if tie.isIdempotent
        -- (an idempotent tie retracts it)
        INSERT INTO $tie.capsule$."$tie.annexName$" (
$/ if schema.METADATA
            "$tie.metadataColumnName$",
$/ endif
            "$tie.identityColumnName$",
            "$tie.positingColumnName$",
            "$tie.reliabilityColumnName$"
        )
        VALUES (
$/ if schema.METADATA
            coalesce(NEW."$tie.metadataColumnName$", 0),
$/ endif
            _following,
            _positing,
            0
        )
        ON CONFLICT DO NOTHING;
$/ else
        RAISE EXCEPTION 'Restatement in $tie.name$ for: %', concat_ws(', ',
$/ foreach role in tie.roles
            NEW."$role.columnName$",
$/ endfor
            _changing, _positing);
$/ endif
    END IF;
$/ endif
$/ endif
    -- the posit, which is new when it was not found
    IF _posit IS NULL THEN
        INSERT INTO $tie.capsule$."$tie.positName$" (
$/ foreach role in tie.roles
            "$role.columnName$",
$/ endfor
$/ if tie.isHistorized
            "$tie.changingColumnName$"
$/ else
            "$tie.identityColumnName$"
$/ endif
        )
        VALUES (
$/ foreach role in tie.roles
            NEW."$role.columnName$",
$/ endfor
$/ if tie.isHistorized
            _changing
$/ else
            DEFAULT
$/ endif
        )
        RETURNING "$tie.identityColumnName$" INTO _posit;
    END IF;
    INSERT INTO $tie.capsule$."$tie.annexName$" (
$/ if schema.METADATA
        "$tie.metadataColumnName$",
$/ endif
        "$tie.identityColumnName$",
        "$tie.positingColumnName$",
        "$tie.reliabilityColumnName$"
    )
    VALUES (
$/ if schema.METADATA
        coalesce(NEW."$tie.metadataColumnName$", 0),
$/ endif
        _posit,
        _positing,
        _reliability
    );
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;
DROP TRIGGER IF EXISTS "it_$tie.name$" ON $tie.capsule$."$tie.name$";
CREATE TRIGGER "it_$tie.name$"
INSTEAD OF INSERT ON $tie.capsule$."$tie.name$"
FOR EACH ROW EXECUTE FUNCTION $tie.capsule$."it_$tie.name$"();
-- Insert trigger -----------------------------------------------------------------------------------------------------
-- it_l$tie.name$ instead of INSERT trigger on l$tie.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."it_l$tie.name$"()
RETURNS trigger
AS
$$
DECLARE
    _now $schema.metadata.chronon$ := $schema.metadata.now$::$schema.metadata.chronon$;
BEGIN
    INSERT INTO $tie.capsule$."$tie.name$" (
$/ if schema.METADATA
        "$tie.metadataColumnName$",
$/ endif
$/ foreach role in tie.roles
        "$role.columnName$",
$/ endfor
$/ if tie.isHistorized
        "$tie.changingColumnName$",
$/ endif
        "$tie.positingColumnName$",
        "$tie.reliabilityColumnName$"
    )
    VALUES (
$/ if schema.METADATA
        NEW."$tie.metadataColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
        coalesce(NEW."$role.columnName$", (
            SELECT
                k."$role.knot.identityColumnName$"
            FROM
                $role.knot.capsule$."$role.knot.name$" k
            WHERE
                k."$role.knot.valueColumnName$" = NEW."$role.knotValueColumnName$"
            LIMIT 1
        )),
$/ else
        NEW."$role.columnName$",
$/ endif
$/ endfor
$/ if tie.isHistorized
        coalesce(NEW."$tie.changingColumnName$", _now),
$/ endif
        coalesce(NEW."$tie.positingColumnName$", _now),
        coalesce(NEW."$tie.reliabilityColumnName$", 1)
    );
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;
DROP TRIGGER IF EXISTS "it_l$tie.name$" ON $tie.capsule$."l$tie.name$";
CREATE TRIGGER "it_l$tie.name$"
INSTEAD OF INSERT ON $tie.capsule$."l$tie.name$"
FOR EACH ROW EXECUTE FUNCTION $tie.capsule$."it_l$tie.name$"();
$/ if tie.values
-- UPDATE trigger -----------------------------------------------------------------------------------------------------
-- ut_l$tie.name$ instead of UPDATE trigger on l$tie.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."ut_l$tie.name$"()
RETURNS trigger
AS
$$
DECLARE
    _now $schema.metadata.chronon$ := $schema.metadata.now$::$schema.metadata.chronon$;
    _positing $schema.metadata.positingRange$;
$/ foreach role in tie.knotRoles
    _$role.name$ $role.knot.identity$;
$/ endfor
BEGIN
$/ foreach role in tie.identifiers
    IF NEW."$role.columnName$" IS DISTINCT FROM OLD."$role.columnName$" THEN
        RAISE EXCEPTION 'The identity column $role.columnName$ is not updatable.';
    END IF;
$/ endfor
$/ foreach role in tie.roles
$/ if role.knot
    _$role.name$ := NEW."$role.columnName$";
    IF NEW."$role.knotValueColumnName$" IS DISTINCT FROM OLD."$role.knotValueColumnName$" AND NEW."$role.columnName$" IS NOT DISTINCT FROM OLD."$role.columnName$" THEN
        _$role.name$ := NULL;
        IF NEW."$role.knotValueColumnName$" IS NOT NULL THEN
            SELECT
                k."$role.knot.identityColumnName$"
            INTO
                _$role.name$
            FROM
                $role.knot.capsule$."$role.knot.name$" k
            WHERE
                k."$role.knot.valueColumnName$" = NEW."$role.knotValueColumnName$"
            LIMIT 1;
        END IF;
    END IF;
$/ endif
$/ endfor
    _positing := CASE
        WHEN NEW."$tie.positingColumnName$" IS DISTINCT FROM OLD."$tie.positingColumnName$" THEN NEW."$tie.positingColumnName$"
        ELSE _now
    END;
$/ if tie.values
    IF
$/ foreach role in tie.roles
$/ if role.knot
        _$role.name$ IS DISTINCT FROM OLD."$role.columnName$" OR
$/ else
        NEW."$role.columnName$" IS DISTINCT FROM OLD."$role.columnName$" OR
$/ endif
$/ endfor
$/ if tie.isHistorized
        NEW."$tie.changingColumnName$" IS DISTINCT FROM OLD."$tie.changingColumnName$" OR
$/ endif
        NEW."$tie.positingColumnName$" IS DISTINCT FROM OLD."$tie.positingColumnName$" OR
        NEW."$tie.reliabilityColumnName$" IS DISTINCT FROM OLD."$tie.reliabilityColumnName$"
    THEN
        IF
$/ foreach role in tie.roles
$/ if role.knot
            _$role.name$ IS NOT NULL
$/ else
            NEW."$role.columnName$" IS NOT NULL
$/ endif
$/ if not role.last()
        AND
$/ endif
$/ endfor
        THEN
            INSERT INTO $tie.capsule$."$tie.name$" (
$/ if schema.METADATA
                "$tie.metadataColumnName$",
$/ endif
$/ foreach role in tie.roles
                "$role.columnName$",
$/ endfor
$/ if tie.isHistorized
                "$tie.changingColumnName$",
$/ endif
                "$tie.positingColumnName$",
                "$tie.reliabilityColumnName$"
            )
            VALUES (
$/ if schema.METADATA
                NEW."$tie.metadataColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
                _$role.name$,
$/ else
                NEW."$role.columnName$",
$/ endif
$/ endfor
$/ if tie.isHistorized
                -- the shown version asserted again keeps its changing time, as does one that is given
                CASE
                    WHEN NEW."$tie.changingColumnName$" IS DISTINCT FROM OLD."$tie.changingColumnName$" THEN NEW."$tie.changingColumnName$"
                    WHEN
$/ foreach role in tie.roles
$/ if role.knot
                        _$role.name$ = OLD."$role.columnName$"
$/ else
                        NEW."$role.columnName$" = OLD."$role.columnName$"
$/ endif
$/ if not role.last()
                    AND
$/ endif
$/ endfor
                    THEN NEW."$tie.changingColumnName$"
                    ELSE _now
                END,
$/ endif
                _positing,
                coalesce(NEW."$tie.reliabilityColumnName$", 1)
            );
        ELSE
            -- logical delete by setting a value to null: the shown version is retracted
            INSERT INTO $tie.capsule$."$tie.name$" (
$/ if schema.METADATA
                "$tie.metadataColumnName$",
$/ endif
$/ foreach role in tie.roles
                "$role.columnName$",
$/ endfor
$/ if tie.isHistorized
                "$tie.changingColumnName$",
$/ endif
                "$tie.positingColumnName$",
                "$tie.reliabilityColumnName$"
            )
            VALUES (
$/ if schema.METADATA
                NEW."$tie.metadataColumnName$",
$/ endif
$/ foreach role in tie.roles
                OLD."$role.columnName$",
$/ endfor
$/ if tie.isHistorized
                OLD."$tie.changingColumnName$",
$/ endif
                _positing,
                0
            );
        END IF;
    END IF;
$/ endif
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;
DROP TRIGGER IF EXISTS "ut_l$tie.name$" ON $tie.capsule$."l$tie.name$";
CREATE TRIGGER "ut_l$tie.name$"
INSTEAD OF UPDATE ON $tie.capsule$."l$tie.name$"
FOR EACH ROW EXECUTE FUNCTION $tie.capsule$."ut_l$tie.name$"();
$/ endif
-- DELETE trigger -----------------------------------------------------------------------------------------------------
-- dt_l$tie.name$ instead of DELETE trigger on l$tie.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."dt_l$tie.name$"()
RETURNS trigger
AS
$$
DECLARE
    _now $schema.metadata.chronon$ := $schema.metadata.now$::$schema.metadata.chronon$;
BEGIN
    -- what is shown is retracted
    INSERT INTO $tie.capsule$."$tie.annexName$" (
$/ if schema.METADATA
        "$tie.metadataColumnName$",
$/ endif
        "$tie.identityColumnName$",
        "$tie.positingColumnName$",
        "$tie.reliabilityColumnName$"
    )
    SELECT
$/ if schema.METADATA
        OLD."$tie.metadataColumnName$",
$/ endif
        OLD."$tie.identityColumnName$",
        _now,
        0
    WHERE
        OLD."$tie.identityColumnName$" IS NOT NULL
    ON CONFLICT DO NOTHING;
    RETURN OLD;
END;
$$ LANGUAGE plpgsql;
DROP TRIGGER IF EXISTS "dt_l$tie.name$" ON $tie.capsule$."l$tie.name$";
CREATE TRIGGER "dt_l$tie.name$"
INSTEAD OF DELETE ON $tie.capsule$."l$tie.name$"
FOR EACH ROW EXECUTE FUNCTION $tie.capsule$."dt_l$tie.name$"();
$/ endfor
$/ endif
