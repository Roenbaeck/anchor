-- TIE TEMPORAL PERSPECTIVES ------------------------------------------------------------------------------------------
--
-- CRT tie perspectives: time traveling (t), latest (l), point-in-time (p),
-- now (n), and difference (d).
--
$/ foreach tie in schema.ties
$- only do perspectives if there are roles
$/ if tie.roles
-- Time traveling perspective -----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."t$tie.name$" (
    positor $schema.metadata.positorRange$,
    changingTimepoint $schema.metadata.chronon$,
    positingTimepoint $schema.metadata.positingRange$,
    assertion char(1)
)
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" bytea,
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$,$/ else $role.knot.identity$,$/ endif
$/ endfor
$/ if tie.isHistorized
    "$tie.changingColumnName$" $tie.timeRange$,
$/ endif
    "$tie.positingColumnName$" $schema.metadata.positingRange$,
    "$tie.positorColumnName$" $schema.metadata.positorRange$,
    "$tie.reliabilityColumnName$" $schema.metadata.reliabilityRange$,
    "$tie.assertionColumnName$" char(1)
)
AS
$$
SELECT
$/ if schema.METADATA
    t."$tie.metadataColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "k$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "k$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if schema.METADATA
    "k$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    t."$role.columnName$",
$/ endfor
$/ if tie.isHistorized
    t."$tie.changingColumnName$",
$/ endif
    t."$tie.positingColumnName$",
    t."$tie.positorColumnName$",
    t."$tie.reliabilityColumnName$",
    t."$tie.assertionColumnName$"
FROM (
    -- the views of all positors are worked out, and the one asked for is picked last: the latest, point-in-time and now
    -- perspectives call this one for each positor
    SELECT
        s.*,
$/ if tie.identifiers
        -- the latest posit for the identifiers
        row_number() OVER (
            PARTITION BY
                s."$tie.positorColumnName$",
$/ foreach role in tie.identifiers
                s."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
            ORDER BY
$/ if tie.isHistorized
                s."$tie.changingColumnName$" DESC,
$/ endif
                s."$tie.positingColumnName$" DESC,
                s."$tie.reliabilityColumnName$" DESC,
                s."$tie.identityColumnName$" DESC
        ) AS "latest"
$/ else
        -- a tie without identifiers is one to one: the latest posit for each of its anchors
$/ foreach role in tie.anchorRoles
        row_number() OVER (
            PARTITION BY s."$tie.positorColumnName$", s."$role.columnName$"
            ORDER BY
$/ if tie.isHistorized
                s."$tie.changingColumnName$" DESC,
$/ endif
                s."$tie.positingColumnName$" DESC,
                s."$tie.reliabilityColumnName$" DESC,
                s."$tie.identityColumnName$" DESC
        ) AS "latest$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
    FROM (
        SELECT
            r.*$/ if tie.isHistorized ,$/ endif
$/ if tie.isHistorized
            -- the latest changing time with an assertion that is not a retraction, which supersedes those before it
            -- whatever its sign
            max(CASE WHEN r."$tie.assertionColumnName$" <> '?' THEN r."$tie.changingColumnName$" END) OVER (
                PARTITION BY
                    r."$tie.positorColumnName$",
$/ if tie.identifiers
$/ foreach role in tie.identifiers
                    r."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
$/ else
$/ foreach role in tie.roles
                    r."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
            ) AS "inEffect"
$/ endif
        FROM
            $tie.capsule$."r$tie.name$"(
                null::$schema.metadata.positorRange$,
$/ if tie.isHistorized
                changingTimepoint::$tie.timeRange$,
$/ endif
                positingTimepoint::$schema.metadata.positingRange$
            ) r
    ) s
    WHERE
        s."$tie.assertionColumnName$" = coalesce(assertion, s."$tie.assertionColumnName$")
$/ if tie.isHistorized
    AND ( -- asked for positive or negative assertions, only those at that changing time
        coalesce(assertion, '?') = '?'
    OR
        s."$tie.changingColumnName$" = s."inEffect"
    )
$/ endif
) t
$/ foreach role in tie.knotRoles
LEFT JOIN
    $role.knot.capsule$."$role.knot.name$" "k$role.name$"
ON
    "k$role.name$"."$role.knot.identityColumnName$" = t."$role.columnName$"
$/ endfor
WHERE
    t."$tie.positorColumnName$" = positor
$/ if tie.identifiers
AND
    t."latest" = 1
$/ else
$/ foreach role in tie.anchorRoles
AND
    t."latest$role.columnName$" = 1
$/ endfor
$/ endif
$$ LANGUAGE sql STABLE;
-- Latest perspective -------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $tie.capsule$."l$tie.name$" AS
SELECT
    p."$schema.metadata.positorSuffix$",
    cast(null as $schema.metadata.reliabilityRange$) AS "$schema.metadata.reliabilitySuffix$",
    t.*
FROM
    $schema.metadata.encapsulation$."_$schema.metadata.positorSuffix$" p,
    $tie.capsule$."t$tie.name$"(
        p."$schema.metadata.positorSuffix$",
        $schema.EOT$::$schema.metadata.chronon$,
        $schema.EOT$::$schema.metadata.positingRange$,
        '+'
    ) t
;
-- Point-in-time perspective ------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."p$tie.name$" (
    changingTimepoint $schema.metadata.chronon$
)
RETURNS TABLE (
    "$schema.metadata.positorSuffix$" $schema.metadata.positorRange$,
    "$schema.metadata.reliabilitySuffix$" $schema.metadata.reliabilityRange$,
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" bytea,
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$,$/ else $role.knot.identity$,$/ endif
$/ endfor
$/ if tie.isHistorized
    "$tie.changingColumnName$" $tie.timeRange$,
$/ endif
    "$tie.positingColumnName$" $schema.metadata.positingRange$,
    "$tie.positorColumnName$" $schema.metadata.positorRange$,
    "$tie.reliabilityColumnName$" $schema.metadata.reliabilityRange$,
    "$tie.assertionColumnName$" char(1)
)
AS
$$
SELECT
    p."$schema.metadata.positorSuffix$",
    cast(null as $schema.metadata.reliabilityRange$) AS "$schema.metadata.reliabilitySuffix$",
$/ if schema.METADATA
    t."$tie.metadataColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    t."$role.knotChecksumColumnName$",
$/ endif
    t."$role.knotValueColumnName$",
$/ if schema.METADATA
    t."$role.knotMetadataColumnName$",
$/ endif
$/ endif
    t."$role.columnName$",
$/ endfor
$/ if tie.isHistorized
    t."$tie.changingColumnName$",
$/ endif
    t."$tie.positingColumnName$",
    t."$tie.positorColumnName$",
    t."$tie.reliabilityColumnName$",
    t."$tie.assertionColumnName$"
FROM
    $schema.metadata.encapsulation$."_$schema.metadata.positorSuffix$" p,
    $tie.capsule$."t$tie.name$"(
        p."$schema.metadata.positorSuffix$",
        changingTimepoint::$schema.metadata.chronon$,
        $schema.EOT$::$schema.metadata.positingRange$,
        '+'
    ) t
$$ LANGUAGE sql STABLE;
-- Now perspective ----------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $tie.capsule$."n$tie.name$" AS
SELECT
    p."$schema.metadata.positorSuffix$",
    cast(null as $schema.metadata.reliabilityRange$) AS "$schema.metadata.reliabilitySuffix$",
    t.*
FROM
    $schema.metadata.encapsulation$."_$schema.metadata.positorSuffix$" p,
    $tie.capsule$."t$tie.name$"(
        p."$schema.metadata.positorSuffix$",
        $schema.metadata.now$::$schema.metadata.chronon$,
        $schema.EOT$::$schema.metadata.positingRange$,
        '+'
    ) t
;
$/ if tie.isHistorized
-- Difference perspective ---------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."d$tie.name$" (
    intervalStart $schema.metadata.chronon$,
    intervalEnd $schema.metadata.chronon$
)
RETURNS TABLE (
    "$schema.metadata.positorSuffix$" $schema.metadata.positorRange$,
    inspectedTimepoint $schema.metadata.chronon$,
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" bytea,
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$,$/ else $role.knot.identity$,$/ endif
$/ endfor
    "$tie.changingColumnName$" $tie.timeRange$,
    "$tie.positingColumnName$" $schema.metadata.positingRange$,
    "$tie.positorColumnName$" $schema.metadata.positorRange$,
    "$tie.reliabilityColumnName$" $schema.metadata.reliabilityRange$,
    "$tie.assertionColumnName$" char(1)
)
AS
$$
-- each change in the interval, with what the time-traveling perspective shows then as it is known now, for each
-- positor: the posit shown at each changing time is joined with the changing time until which it holds, when the next
-- changing time with an assertion that is not a retraction is. The time-traveling perspective is not called
-- for each change; the posits are worked out for all of them in one pass.
$/ if not tie.identifiers
-- A tie without identifiers is one to one: of the posits shown at the time, the latest for each of its anchors is kept, by a
-- window over the rows that are joined and the filter after it.
SELECT
    q."$schema.metadata.positorSuffix$",
    q.inspectedTimepoint,
$/ if schema.METADATA
    q."$tie.metadataColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    q."$role.knotChecksumColumnName$",
$/ endif
    q."$role.knotValueColumnName$",
$/ if schema.METADATA
    q."$role.knotMetadataColumnName$",
$/ endif
$/ endif
    q."$role.columnName$",
$/ endfor
    q."$tie.changingColumnName$",
    q."$tie.positingColumnName$",
    q."$tie.positorColumnName$",
    q."$tie.reliabilityColumnName$",
    q."$tie.assertionColumnName$"
FROM (
$/ endif
SELECT
    p."$schema.metadata.positorSuffix$",
    tp.inspectedTimepoint,
$/ if schema.METADATA
    t."$tie.metadataColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "k$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "k$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if schema.METADATA
    "k$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    t."$role.columnName$",
$/ endfor
    t."$tie.changingColumnName$",
    t."$tie.positingColumnName$",
    t."$tie.positorColumnName$",
    t."$tie.reliabilityColumnName$",
    t."$tie.assertionColumnName$"$/ if not tie.identifiers ,$/ endif
$/ if not tie.identifiers
$/ foreach role in tie.anchorRoles
    row_number() OVER (
        PARTITION BY tp.positor, tp.inspectedTimepoint, t."$role.columnName$"
        ORDER BY
            t."$tie.changingColumnName$" DESC,
            t."$tie.positingColumnName$" DESC,
            t."$tie.reliabilityColumnName$" DESC,
            t."$tie.identityColumnName$" DESC
    ) AS "latest$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
FROM
    $schema.metadata.encapsulation$."_$schema.metadata.positorSuffix$" p
JOIN (
    SELECT DISTINCT
        "$tie.positorColumnName$" AS positor,
        "$tie.changingColumnName$"::$schema.metadata.chronon$ AS inspectedTimepoint
    FROM
        $tie.capsule$."$tie.name$"
    WHERE
        "$tie.changingColumnName$" BETWEEN intervalStart AND intervalEnd
) tp
ON
    tp.positor = p."$schema.metadata.positorSuffix$"
JOIN (
    SELECT
        y.*,
        lead(y."$tie.changingColumnName$") OVER (
            PARTITION BY
                y."$tie.positorColumnName$",
$/ if tie.identifiers
$/ foreach role in tie.identifiers
                y."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
$/ else
$/ foreach role in tie.roles
                y."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
            ORDER BY y."$tie.changingColumnName$"
        ) AS "until"
    FROM (
        -- one posit for each changing time with an assertion that is not a retraction: the positive one that is shown
        -- if there is one, and otherwise a negative one, which means that nothing is shown from that time on
        SELECT DISTINCT ON (r."$tie.positorColumnName$",
$/ if tie.identifiers
$/ foreach role in tie.identifiers
                    r."$role.columnName$",
$/ endfor
$/ else
$/ foreach role in tie.roles
                    r."$role.columnName$",
$/ endfor
$/ endif
                    r."$tie.changingColumnName$")
            r.*
        FROM
            $tie.capsule$."r$tie.name$"(
                null::$schema.metadata.positorRange$,
                $schema.EOT$::$tie.timeRange$,
                $schema.EOT$::$schema.metadata.positingRange$
            ) r
        WHERE
            r."$tie.assertionColumnName$" <> '?'
        ORDER BY
    r."$tie.positorColumnName$",
$/ if tie.identifiers
$/ foreach role in tie.identifiers
                    r."$role.columnName$",
$/ endfor
$/ else
$/ foreach role in tie.roles
                    r."$role.columnName$",
$/ endfor
$/ endif
                    r."$tie.changingColumnName$",
    CASE WHEN r."$tie.assertionColumnName$" = '+' THEN 0 ELSE 1 END,
    r."$tie.positingColumnName$" DESC,
    r."$tie.reliabilityColumnName$" DESC,
    r."$tie.identityColumnName$" DESC
    ) y
) t
ON
    t."$tie.positorColumnName$" = tp.positor
AND
    t."$tie.assertionColumnName$" = '+'
AND
    t."$tie.changingColumnName$" <= tp.inspectedTimepoint::$tie.timeRange$
AND (
    t."until" IS NULL
OR
    t."until" > tp.inspectedTimepoint::$tie.timeRange$
)
$/ foreach role in tie.knotRoles
LEFT JOIN
    $role.knot.capsule$."$role.knot.name$" "k$role.name$"
ON
    "k$role.name$"."$role.knot.identityColumnName$" = t."$role.columnName$"
$/ endfor
$/ if not tie.identifiers
) q
WHERE
$/ foreach role in tie.anchorRoles
    q."latest$role.columnName$" = 1
$/ if not role.last()
AND
$/ endif
$/ endfor
$/ endif
$$ LANGUAGE sql STABLE;
$/ endif
$/ endif
$/ endfor
