-- TIE TEMPORAL PERSPECTIVES ------------------------------------------------------------------------------------------
--
-- tie perspectives: latest (l), point-in-time (p), now (n), difference (d),
-- and equivalence variants (el, ep, en, ed).
--
$/ foreach tie in schema.ties
-- Latest perspective -------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $tie.capsule$."l$tie.name$" (
$/ if schema.METADATA
    "$tie.metadataColumnName$",
$/ endif
$/ if tie.isHistorized
    "$tie.changingColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$",
$/ endif
    "$role.knotValueColumnName$",
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    "$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
)
AS
SELECT
$/ if schema.METADATA
    tie."$tie.metadataColumnName$",
$/ endif
$/ if tie.isHistorized
    tie."$tie.changingColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if role.knot.isEquivalent
    "$role.name$"."$role.knot.equivalentColumnName$" AS "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
FROM
$/ if tie.isHistorized
    (
        -- the latest changing time of the identifiers (of each anchor, in a tie without identifiers), as a column
        SELECT
            t.*,
$/ if tie.identifiers
            max(t."$tie.changingColumnName$") OVER (
                PARTITION BY
$/ foreach role in tie.identifiers
                    t."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
            ) AS "latest"
$/ else
$/ foreach role in tie.anchorRoles
            max(t."$tie.changingColumnName$") OVER (PARTITION BY t."$role.columnName$") AS "latest$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
        FROM
            $tie.capsule$."$tie.name$" t
    ) tie
$/ else
    $tie.capsule$."$tie.name$" tie
$/ endif
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    $role.knot.capsule$."e$role.knot.name$"(0::$schema.metadata.equivalentRange$) "$role.name$"
$/ else
    $role.knot.capsule$."$role.knot.name$" "$role.name$"
$/ endif
ON
    "$role.name$"."$role.knot.identityColumnName$" = tie."$role.columnName$"
$/ endfor
$/ if tie.isHistorized
WHERE
$/ if tie.identifiers
    tie."$tie.changingColumnName$" = tie."latest"
$/ else
$/ foreach role in tie.anchorRoles
    tie."$tie.changingColumnName$" = tie."latest$role.columnName$"
$/ if not role.last()
AND
$/ endif
$/ endfor
$/ endif
$/ endif
;
-- Point-in-time perspective ------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."p$tie.name$" (
    changingTimepoint $schema.metadata.chronon$
)
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if tie.isHistorized
    "$tie.changingColumnName$" $tie.timeRange$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" bytea,
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
$/ if schema.METADATA
    tie."$tie.metadataColumnName$",
$/ endif
$/ if tie.isHistorized
    tie."$tie.changingColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if role.knot.isEquivalent
    "$role.name$"."$role.knot.equivalentColumnName$" AS "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
FROM
$/ if tie.isHistorized
    (
        -- the latest changing time of the identifiers (of each anchor, in a tie without identifiers), as a column
        SELECT
            t.*,
$/ if tie.identifiers
            max(t."$tie.changingColumnName$") OVER (
                PARTITION BY
$/ foreach role in tie.identifiers
                    t."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
            ) AS "latest"
$/ else
$/ foreach role in tie.anchorRoles
            max(t."$tie.changingColumnName$") OVER (PARTITION BY t."$role.columnName$") AS "latest$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
        FROM
            $tie.capsule$."$tie.name$" t
        WHERE
            t."$tie.changingColumnName$" <= changingTimepoint
    ) tie
$/ else
    $tie.capsule$."$tie.name$" tie
$/ endif
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    $role.knot.capsule$."e$role.knot.name$"(0::$schema.metadata.equivalentRange$) "$role.name$"
$/ else
    $role.knot.capsule$."$role.knot.name$" "$role.name$"
$/ endif
ON
    "$role.name$"."$role.knot.identityColumnName$" = tie."$role.columnName$"
$/ endfor
$/ if tie.isHistorized
WHERE
$/ if tie.identifiers
    tie."$tie.changingColumnName$" = tie."latest"
$/ else
$/ foreach role in tie.anchorRoles
    tie."$tie.changingColumnName$" = tie."latest$role.columnName$"
$/ if not role.last()
AND
$/ endif
$/ endfor
$/ endif
$/ endif
$$ LANGUAGE sql STABLE;
-- Now perspective ----------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $tie.capsule$."n$tie.name$" AS
SELECT
    *
FROM
    $tie.capsule$."p$tie.name$"($schema.metadata.now$::$schema.metadata.chronon$)
;
$/ if tie.isHistorized
-- Difference perspective ---------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."d$tie.name$" (
    intervalStart $schema.metadata.chronon$,
    intervalEnd $schema.metadata.chronon$
)
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
    "$tie.changingColumnName$" $tie.timeRange$,
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" bytea,
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
$/ if schema.METADATA
    tie."$tie.metadataColumnName$",
$/ endif
    tie."$tie.changingColumnName$",
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if role.knot.isEquivalent
    "$role.name$"."$role.knot.equivalentColumnName$" AS "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
FROM
    $tie.capsule$."$tie.name$" tie
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    $role.knot.capsule$."e$role.knot.name$"(0::$schema.metadata.equivalentRange$) "$role.name$"
$/ else
    $role.knot.capsule$."$role.knot.name$" "$role.name$"
$/ endif
ON
    "$role.name$"."$role.knot.identityColumnName$" = tie."$role.columnName$"
$/ endfor
WHERE
    tie."$tie.changingColumnName$" BETWEEN intervalStart AND intervalEnd
$$ LANGUAGE sql STABLE;
$/ endif
$/ if schema.EQUIVALENCE
-- Point-in-time equivalence perspective ------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."ep$tie.name$" (
    equivalent $schema.metadata.equivalentRange$,
    changingTimepoint $schema.metadata.chronon$
)
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if tie.isHistorized
    "$tie.changingColumnName$" $tie.timeRange$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" bytea,
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
$/ if schema.METADATA
    tie."$tie.metadataColumnName$",
$/ endif
$/ if tie.isHistorized
    tie."$tie.changingColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if role.knot.isEquivalent
    "$role.name$"."$role.knot.equivalentColumnName$" AS "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
FROM
$/ if tie.isHistorized
    (
        -- the latest changing time of the identifiers (of each anchor, in a tie without identifiers), as a column
        SELECT
            t.*,
$/ if tie.identifiers
            max(t."$tie.changingColumnName$") OVER (
                PARTITION BY
$/ foreach role in tie.identifiers
                    t."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
            ) AS "latest"
$/ else
$/ foreach role in tie.anchorRoles
            max(t."$tie.changingColumnName$") OVER (PARTITION BY t."$role.columnName$") AS "latest$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
        FROM
            $tie.capsule$."$tie.name$" t
        WHERE
            t."$tie.changingColumnName$" <= changingTimepoint
    ) tie
$/ else
    $tie.capsule$."$tie.name$" tie
$/ endif
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    $role.knot.capsule$."e$role.knot.name$"(equivalent) "$role.name$"
$/ else
    $role.knot.capsule$."$role.knot.name$" "$role.name$"
$/ endif
ON
    "$role.name$"."$role.knot.identityColumnName$" = tie."$role.columnName$"
$/ endfor
$/ if tie.isHistorized
WHERE
$/ if tie.identifiers
    tie."$tie.changingColumnName$" = tie."latest"
$/ else
$/ foreach role in tie.anchorRoles
    tie."$tie.changingColumnName$" = tie."latest$role.columnName$"
$/ if not role.last()
AND
$/ endif
$/ endfor
$/ endif
$/ endif
$$ LANGUAGE sql STABLE;
-- Latest equivalence perspective -------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."el$tie.name$" (
    equivalent $schema.metadata.equivalentRange$
)
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if tie.isHistorized
    "$tie.changingColumnName$" $tie.timeRange$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" bytea,
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
    *
FROM
    $tie.capsule$."ep$tie.name$"(equivalent, $schema.metadata.now$::$schema.metadata.chronon$)
$$ LANGUAGE sql STABLE;
-- Now equivalence perspective ----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."en$tie.name$" (
    equivalent $schema.metadata.equivalentRange$
)
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if tie.isHistorized
    "$tie.changingColumnName$" $tie.timeRange$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" bytea,
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
    *
FROM
    $tie.capsule$."ep$tie.name$"(equivalent, $schema.metadata.now$::$schema.metadata.chronon$)
$$ LANGUAGE sql STABLE;
$/ if tie.isHistorized
-- Difference equivalence perspective ---------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."ed$tie.name$" (
    equivalent $schema.metadata.equivalentRange$,
    intervalStart $schema.metadata.chronon$,
    intervalEnd $schema.metadata.chronon$
)
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
    "$tie.changingColumnName$" $tie.timeRange$,
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" bytea,
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
$/ if schema.METADATA
    tie."$tie.metadataColumnName$",
$/ endif
    tie."$tie.changingColumnName$",
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if role.knot.isEquivalent
    "$role.name$"."$role.knot.equivalentColumnName$" AS "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
FROM
    $tie.capsule$."$tie.name$" tie
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    $role.knot.capsule$."e$role.knot.name$"(equivalent) "$role.name$"
$/ else
    $role.knot.capsule$."$role.knot.name$" "$role.name$"
$/ endif
ON
    "$role.name$"."$role.knot.identityColumnName$" = tie."$role.columnName$"
$/ endfor
WHERE
    tie."$tie.changingColumnName$" BETWEEN intervalStart AND intervalEnd
$$ LANGUAGE sql STABLE;
$/ endif
$/ endif
$/ endfor
