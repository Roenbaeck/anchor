-- ANCHOR TEMPORAL PERSPECTIVES ---------------------------------------------------------------------------------------
--
-- anchor perspectives: latest (l), point-in-time (p), now (n), difference (d),
-- and their equivalence variants (el, ep, en, ed).
--
$/ foreach anchor in schema.anchors
$/ if anchor.attributes
-- Latest perspective -------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $anchor.capsule$."l$anchor.name$" (
    "$anchor.identityColumnName$",
$/ if schema.METADATA
    "$anchor.metadataColumnName$",
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.entityReferenceName$",
$/ endif
$/ if schema.METADATA
    "$attribute.metadataColumnName$",
$/ endif
$/ if attribute.isDeletable
    "$attribute.deletableColumnName$",
$/ endif
$/ if attribute.isHistorized
    "$attribute.changingColumnName$",
$/ endif
$/ if attribute.isEquivalent
    "$attribute.equivalentColumnName$",
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "$attribute.knotChecksumColumnName$",
$/ endif
$/ if attribute.knot.isEquivalent
    "$attribute.knotEquivalentColumnName$",
$/ endif
    "$attribute.knotValueColumnName$",
$/ if schema.METADATA
    "$attribute.knotMetadataColumnName$",
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.checksumColumnName$",
$/ endif
    "$attribute.valueColumnName$"$/ if not attribute.last() ,$/ endif
$/ endfor
)
AS
SELECT
    "$anchor.mnemonic$"."$anchor.identityColumnName$",
$/ if schema.METADATA
    "$anchor.mnemonic$"."$anchor.metadataColumnName$",
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.mnemonic$"."$attribute.entityReferenceName$",
$/ endif
$/ if schema.METADATA
    "$attribute.mnemonic$"."$attribute.metadataColumnName$",
$/ endif
$/ if attribute.isDeletable
    NULL::boolean,
$/ endif
$/ if attribute.isHistorized
    "$attribute.mnemonic$"."$attribute.changingColumnName$",
$/ endif
$/ if attribute.isEquivalent
    "$attribute.mnemonic$"."$attribute.equivalentColumnName$",
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "k$attribute.mnemonic$"."$attribute.knot.checksumColumnName$" AS "$attribute.knotChecksumColumnName$",
$/ endif
$/ if attribute.knot.isEquivalent
    "k$attribute.mnemonic$"."$attribute.knot.equivalentColumnName$" AS "$attribute.knotEquivalentColumnName$",
$/ endif
    "k$attribute.mnemonic$"."$attribute.knot.valueColumnName$" AS "$attribute.knotValueColumnName$",
$/ if schema.METADATA
    "k$attribute.mnemonic$"."$attribute.knot.metadataColumnName$" AS "$attribute.knotMetadataColumnName$",
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.mnemonic$"."$attribute.checksumColumnName$",
$/ endif
    "$attribute.mnemonic$"."$attribute.valueColumnName$"$/ if not attribute.last() ,$/ endif
$/ endfor
FROM
    $anchor.capsule$."$anchor.name$" "$anchor.mnemonic$"
$- the statement ends with a semicolon on the last line of the last attribute's joins
$/ foreach attribute in anchor.attributes
LEFT JOIN
$/ if attribute.isEquivalent and not attribute.isKnotted
    $attribute.capsule$."e$attribute.name$"(0::$schema.metadata.equivalentRange$) "$attribute.mnemonic$"
$/ else
    $attribute.capsule$."$attribute.name$" "$attribute.mnemonic$"
$/ endif
ON
    "$attribute.mnemonic$"."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"$/ if attribute.last() and not attribute.isHistorized and not attribute.isKnotted ;$/ endif
$/ if attribute.isHistorized
AND
    "$attribute.mnemonic$"."$attribute.changingColumnName$" = (
        SELECT
            max(sub."$attribute.changingColumnName$")
        FROM
            $/ if attribute.isEquivalent and not attribute.isKnotted $attribute.capsule$."e$attribute.name$"(0::$schema.metadata.equivalentRange$) sub $/ else $attribute.capsule$."$attribute.name$" sub$/ endif
        WHERE
            sub."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
   )$/ if attribute.last() and not attribute.isKnotted ;$/ endif
$/ endif
$/ if attribute.isKnotted
LEFT JOIN
$/ if attribute.knot.isEquivalent
    $attribute.knot.capsule$."e$attribute.knot.name$"(0::$schema.metadata.equivalentRange$) "k$attribute.mnemonic$"
$/ else
    $attribute.knot.capsule$."$attribute.knot.name$" "k$attribute.mnemonic$"
$/ endif
ON
    "k$attribute.mnemonic$"."$attribute.knot.identityColumnName$" = "$attribute.mnemonic$"."$attribute.knotReferenceName$"$/ if attribute.last() ;$/ endif
$/ endif
$/ endfor
-- Point-in-time perspective ------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $anchor.capsule$."p$anchor.name$" (
    changingTimepoint $schema.metadata.chronon$
)
RETURNS TABLE (
    "$anchor.identityColumnName$" $anchor.identity$,
$/ if schema.METADATA
    "$anchor.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.entityReferenceName$" $anchor.identity$,
$/ endif
$/ if schema.METADATA
    "$attribute.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if attribute.isHistorized
    "$attribute.changingColumnName$" $attribute.timeRange$,
$/ endif
$/ if attribute.isEquivalent
    "$attribute.equivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "$attribute.knotChecksumColumnName$" bytea,
$/ endif
$/ if attribute.knot.isEquivalent
    "$attribute.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
    "$attribute.knotValueColumnName$" $attribute.knot.dataRange$,
$/ if schema.METADATA
    "$attribute.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.checksumColumnName$" bytea,
$/ endif
$/ if attribute.isKnotted
    "$attribute.valueColumnName$" $attribute.knot.identity$$/ if not attribute.last() ,$/ endif
$/ else
    "$attribute.valueColumnName$" $attribute.dataRange$$/ if not attribute.last() ,$/ endif
$/ endif
$/ endfor
)
AS
$$
SELECT
    "$anchor.mnemonic$"."$anchor.identityColumnName$",
$/ if schema.METADATA
    "$anchor.mnemonic$"."$anchor.metadataColumnName$",
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.mnemonic$"."$attribute.entityReferenceName$",
$/ endif
$/ if schema.METADATA
    "$attribute.mnemonic$"."$attribute.metadataColumnName$",
$/ endif
$/ if attribute.isHistorized
    "$attribute.mnemonic$"."$attribute.changingColumnName$",
$/ endif
$/ if attribute.isEquivalent
    "$attribute.mnemonic$"."$attribute.equivalentColumnName$",
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "k$attribute.mnemonic$"."$attribute.knot.checksumColumnName$" AS "$attribute.knotChecksumColumnName$",
$/ endif
$/ if attribute.knot.isEquivalent
    "k$attribute.mnemonic$"."$attribute.knot.equivalentColumnName$" AS "$attribute.knotEquivalentColumnName$",
$/ endif
    "k$attribute.mnemonic$"."$attribute.knot.valueColumnName$" AS "$attribute.knotValueColumnName$",
$/ if schema.METADATA
    "k$attribute.mnemonic$"."$attribute.knot.metadataColumnName$" AS "$attribute.knotMetadataColumnName$",
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.mnemonic$"."$attribute.checksumColumnName$",
$/ endif
    "$attribute.mnemonic$"."$attribute.valueColumnName$"$/ if not attribute.last() ,$/ endif
$/ endfor
FROM
    $anchor.capsule$."$anchor.name$" "$anchor.mnemonic$"
$/ foreach attribute in anchor.attributes
$/ if attribute.isHistorized
LEFT JOIN
$/ if attribute.isEquivalent and not attribute.isKnotted
    $attribute.capsule$."r$attribute.name$"(0::$schema.metadata.equivalentRange$, changingTimepoint::$attribute.timeRange$) "$attribute.mnemonic$"
$/ else
    $attribute.capsule$."r$attribute.name$"(changingTimepoint::$attribute.timeRange$) "$attribute.mnemonic$"
$/ endif
ON
    "$attribute.mnemonic$"."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
AND
    "$attribute.mnemonic$"."$attribute.changingColumnName$" = (
        SELECT
            max(sub."$attribute.changingColumnName$")
        FROM
$/ if attribute.isEquivalent and not attribute.isKnotted
            $attribute.capsule$."r$attribute.name$"(0::$schema.metadata.equivalentRange$, changingTimepoint::$attribute.timeRange$) sub
$/ else
            $attribute.capsule$."r$attribute.name$"(changingTimepoint::$attribute.timeRange$) sub
$/ endif
        WHERE
            sub."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
   )
$/ else
LEFT JOIN
$/ if attribute.isEquivalent and not attribute.isKnotted
    $attribute.capsule$."e$attribute.name$"(0::$schema.metadata.equivalentRange$) "$attribute.mnemonic$"
$/ else
    $attribute.capsule$."$attribute.name$" "$attribute.mnemonic$"
$/ endif
ON
    "$attribute.mnemonic$"."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
$/ endif
$/ if attribute.isKnotted
LEFT JOIN
$/ if attribute.knot.isEquivalent
    $attribute.knot.capsule$."e$attribute.knot.name$"(0::$schema.metadata.equivalentRange$) "k$attribute.mnemonic$"
$/ else
    $attribute.knot.capsule$."$attribute.knot.name$" "k$attribute.mnemonic$"
$/ endif
ON
    "k$attribute.mnemonic$"."$attribute.knot.identityColumnName$" = "$attribute.mnemonic$"."$attribute.knotReferenceName$"
$/ endif
$/ endfor
$$ LANGUAGE sql STABLE;
-- Now perspective ----------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $anchor.capsule$."n$anchor.name$"
AS
SELECT
    *
FROM
    $anchor.capsule$."p$anchor.name$"($schema.metadata.now$::$schema.metadata.chronon$)
;
$/ if anchor.historizedAttributes
-- Difference perspective ---------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $anchor.capsule$."d$anchor.name$" (
    intervalStart $schema.metadata.chronon$,
    intervalEnd $schema.metadata.chronon$,
    selection text
)
RETURNS TABLE (
    inspectedTimepoint $schema.metadata.chronon$,
    mnemonic text,
    "$anchor.identityColumnName$" $anchor.identity$,
$/ if schema.METADATA
    "$anchor.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.entityReferenceName$" $anchor.identity$,
$/ endif
$/ if schema.METADATA
    "$attribute.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if attribute.isHistorized
    "$attribute.changingColumnName$" $attribute.timeRange$,
$/ endif
$/ if attribute.isEquivalent
    "$attribute.equivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "$attribute.knotChecksumColumnName$" bytea,
$/ endif
$/ if attribute.knot.isEquivalent
    "$attribute.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
    "$attribute.knotValueColumnName$" $attribute.knot.dataRange$,
$/ if schema.METADATA
    "$attribute.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.checksumColumnName$" bytea,
$/ endif
$/ if attribute.isKnotted
    "$attribute.valueColumnName$" $attribute.knot.identity$$/ if not attribute.last() ,$/ endif
$/ else
    "$attribute.valueColumnName$" $attribute.dataRange$$/ if not attribute.last() ,$/ endif
$/ endif
$/ endfor
)
AS
$$
-- each change in the interval, with the values in effect then: every value is joined with the time until which it
-- holds, when the next one does. The point-in-time perspective is not called for each change; the values are worked out
-- for all of them in one pass.
SELECT
    timepoints.inspectedTimepoint,
    timepoints.mnemonic,
    "$anchor.mnemonic$"."$anchor.identityColumnName$",
$/ if schema.METADATA
    "$anchor.mnemonic$"."$anchor.metadataColumnName$",
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.mnemonic$"."$attribute.entityReferenceName$",
$/ endif
$/ if schema.METADATA
    "$attribute.mnemonic$"."$attribute.metadataColumnName$",
$/ endif
$/ if attribute.isHistorized
    "$attribute.mnemonic$"."$attribute.changingColumnName$",
$/ endif
$/ if attribute.isEquivalent
    "$attribute.mnemonic$"."$attribute.equivalentColumnName$",
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "k$attribute.mnemonic$"."$attribute.knot.checksumColumnName$" AS "$attribute.knotChecksumColumnName$",
$/ endif
$/ if attribute.knot.isEquivalent
    "k$attribute.mnemonic$"."$attribute.knot.equivalentColumnName$" AS "$attribute.knotEquivalentColumnName$",
$/ endif
    "k$attribute.mnemonic$"."$attribute.knot.valueColumnName$" AS "$attribute.knotValueColumnName$",
$/ if schema.METADATA
    "k$attribute.mnemonic$"."$attribute.knot.metadataColumnName$" AS "$attribute.knotMetadataColumnName$",
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.mnemonic$"."$attribute.checksumColumnName$",
$/ endif
    "$attribute.mnemonic$"."$attribute.valueColumnName$"$/ if not attribute.last() ,$/ endif
$/ endfor
FROM (
$/ foreach historized in anchor.historizedAttributes
    SELECT DISTINCT
        h."$historized.entityReferenceName$" AS "$anchor.identityColumnName$",
        h."$historized.changingColumnName$"::$schema.metadata.chronon$ AS inspectedTimepoint,
        '$historized.mnemonic$' AS mnemonic
    FROM
$/ if historized.isEquivalent and not historized.isKnotted
        $historized.capsule$."e$historized.name$"(0::$schema.metadata.equivalentRange$) h
$/ else
        $historized.capsule$."$historized.name$" h
$/ endif
    WHERE
        (selection IS NULL OR selection LIKE '%$historized.mnemonic$%')
    AND
        h."$historized.changingColumnName$" BETWEEN intervalStart AND intervalEnd
$/ if not historized.last()
    UNION
$/ endif
$/ endfor
) timepoints
JOIN
    $anchor.capsule$."$anchor.name$" "$anchor.mnemonic$"
ON
    "$anchor.mnemonic$"."$anchor.identityColumnName$" = timepoints."$anchor.identityColumnName$"
$/ foreach attribute in anchor.attributes
$/ if attribute.isHistorized
LEFT JOIN (
    SELECT
        h.*,
        lead(h."$attribute.changingColumnName$") OVER (
            PARTITION BY h."$attribute.entityReferenceName$"
            ORDER BY h."$attribute.changingColumnName$"
        ) AS "until"
    FROM
$/ if attribute.isEquivalent and not attribute.isKnotted
        $attribute.capsule$."e$attribute.name$"(0::$schema.metadata.equivalentRange$) h
$/ else
        $attribute.capsule$."$attribute.name$" h
$/ endif
) "$attribute.mnemonic$"
ON
    "$attribute.mnemonic$"."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
AND
    "$attribute.mnemonic$"."$attribute.changingColumnName$" <= timepoints.inspectedTimepoint::$attribute.timeRange$
AND (
    "$attribute.mnemonic$"."until" IS NULL
OR
    "$attribute.mnemonic$"."until" > timepoints.inspectedTimepoint::$attribute.timeRange$
)
$/ else
LEFT JOIN
$/ if attribute.isEquivalent and not attribute.isKnotted
    $attribute.capsule$."e$attribute.name$"(0::$schema.metadata.equivalentRange$) "$attribute.mnemonic$"
$/ else
    $attribute.capsule$."$attribute.name$" "$attribute.mnemonic$"
$/ endif
ON
    "$attribute.mnemonic$"."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
$/ endif
$/ if attribute.isKnotted
LEFT JOIN
$/ if attribute.knot.isEquivalent
    $attribute.knot.capsule$."e$attribute.knot.name$"(0::$schema.metadata.equivalentRange$) "k$attribute.mnemonic$"
$/ else
    $attribute.knot.capsule$."$attribute.knot.name$" "k$attribute.mnemonic$"
$/ endif
ON
    "k$attribute.mnemonic$"."$attribute.knot.identityColumnName$" = "$attribute.mnemonic$"."$attribute.knotReferenceName$"
$/ endif
$/ endfor
$$ LANGUAGE sql STABLE;
$/ endif
$/ if schema.EQUIVALENCE
-- Point-in-time equivalence perspective ------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $anchor.capsule$."ep$anchor.name$" (
    equivalent $schema.metadata.equivalentRange$,
    changingTimepoint $schema.metadata.chronon$
)
RETURNS TABLE (
    "$anchor.identityColumnName$" $anchor.identity$,
$/ if schema.METADATA
    "$anchor.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.entityReferenceName$" $anchor.identity$,
$/ endif
$/ if schema.METADATA
    "$attribute.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if attribute.isHistorized
    "$attribute.changingColumnName$" $attribute.timeRange$,
$/ endif
$/ if attribute.isEquivalent
    "$attribute.equivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "$attribute.knotChecksumColumnName$" bytea,
$/ endif
$/ if attribute.knot.isEquivalent
    "$attribute.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
    "$attribute.knotValueColumnName$" $attribute.knot.dataRange$,
$/ if schema.METADATA
    "$attribute.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.checksumColumnName$" bytea,
$/ endif
$/ if attribute.isKnotted
    "$attribute.valueColumnName$" $attribute.knot.identity$$/ if not attribute.last() ,$/ endif
$/ else
    "$attribute.valueColumnName$" $attribute.dataRange$$/ if not attribute.last() ,$/ endif
$/ endif
$/ endfor
)
AS
$$
SELECT
    "$anchor.mnemonic$"."$anchor.identityColumnName$",
$/ if schema.METADATA
    "$anchor.mnemonic$"."$anchor.metadataColumnName$",
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.mnemonic$"."$attribute.entityReferenceName$",
$/ endif
$/ if schema.METADATA
    "$attribute.mnemonic$"."$attribute.metadataColumnName$",
$/ endif
$/ if attribute.isHistorized
    "$attribute.mnemonic$"."$attribute.changingColumnName$",
$/ endif
$/ if attribute.isEquivalent
    "$attribute.mnemonic$"."$attribute.equivalentColumnName$",
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "k$attribute.mnemonic$"."$attribute.knot.checksumColumnName$" AS "$attribute.knotChecksumColumnName$",
$/ endif
$/ if attribute.knot.isEquivalent
    "k$attribute.mnemonic$"."$attribute.knot.equivalentColumnName$" AS "$attribute.knotEquivalentColumnName$",
$/ endif
    "k$attribute.mnemonic$"."$attribute.knot.valueColumnName$" AS "$attribute.knotValueColumnName$",
$/ if schema.METADATA
    "k$attribute.mnemonic$"."$attribute.knot.metadataColumnName$" AS "$attribute.knotMetadataColumnName$",
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.mnemonic$"."$attribute.checksumColumnName$",
$/ endif
    "$attribute.mnemonic$"."$attribute.valueColumnName$"$/ if not attribute.last() ,$/ endif
$/ endfor
FROM
    $anchor.capsule$."$anchor.name$" "$anchor.mnemonic$"
$/ foreach attribute in anchor.attributes
$/ if attribute.isHistorized
LEFT JOIN
$/ if attribute.isEquivalent and not attribute.isKnotted
    $attribute.capsule$."r$attribute.name$"(equivalent, changingTimepoint::$attribute.timeRange$) "$attribute.mnemonic$"
$/ else
    $attribute.capsule$."r$attribute.name$"(changingTimepoint::$attribute.timeRange$) "$attribute.mnemonic$"
$/ endif
ON
    "$attribute.mnemonic$"."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
AND
    "$attribute.mnemonic$"."$attribute.changingColumnName$" = (
        SELECT
            max(sub."$attribute.changingColumnName$")
        FROM
$/ if attribute.isEquivalent and not attribute.isKnotted
            $attribute.capsule$."r$attribute.name$"(equivalent, changingTimepoint::$attribute.timeRange$) sub
$/ else
            $attribute.capsule$."r$attribute.name$"(changingTimepoint::$attribute.timeRange$) sub
$/ endif
        WHERE
            sub."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
   )
$/ else
LEFT JOIN
$/ if attribute.isEquivalent and not attribute.isKnotted
    $attribute.capsule$."e$attribute.name$"(equivalent) "$attribute.mnemonic$"
$/ else
    $attribute.capsule$."$attribute.name$" "$attribute.mnemonic$"
$/ endif
ON
    "$attribute.mnemonic$"."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
$/ endif
$/ if attribute.isKnotted
LEFT JOIN
$/ if attribute.knot.isEquivalent
    $attribute.knot.capsule$."e$attribute.knot.name$"(equivalent) "k$attribute.mnemonic$"
$/ else
    $attribute.knot.capsule$."$attribute.knot.name$" "k$attribute.mnemonic$"
$/ endif
ON
    "k$attribute.mnemonic$"."$attribute.knot.identityColumnName$" = "$attribute.mnemonic$"."$attribute.knotReferenceName$"
$/ endif
$/ endfor
$$ LANGUAGE sql STABLE;
-- Latest equivalence perspective -------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $anchor.capsule$."el$anchor.name$" (
    equivalent $schema.metadata.equivalentRange$
)
RETURNS TABLE (
    "$anchor.identityColumnName$" $anchor.identity$,
$/ if schema.METADATA
    "$anchor.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.entityReferenceName$" $anchor.identity$,
$/ endif
$/ if schema.METADATA
    "$attribute.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if attribute.isHistorized
    "$attribute.changingColumnName$" $attribute.timeRange$,
$/ endif
$/ if attribute.isEquivalent
    "$attribute.equivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "$attribute.knotChecksumColumnName$" bytea,
$/ endif
$/ if attribute.knot.isEquivalent
    "$attribute.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
    "$attribute.knotValueColumnName$" $attribute.knot.dataRange$,
$/ if schema.METADATA
    "$attribute.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.checksumColumnName$" bytea,
$/ endif
$/ if attribute.isKnotted
    "$attribute.valueColumnName$" $attribute.knot.identity$$/ if not attribute.last() ,$/ endif
$/ else
    "$attribute.valueColumnName$" $attribute.dataRange$$/ if not attribute.last() ,$/ endif
$/ endif
$/ endfor
)
AS
$$
SELECT
    *
FROM
    $anchor.capsule$."ep$anchor.name$"(equivalent, $schema.metadata.now$::$schema.metadata.chronon$)
$$ LANGUAGE sql STABLE;
-- Now equivalence perspective ----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $anchor.capsule$."en$anchor.name$" (
    equivalent $schema.metadata.equivalentRange$
)
RETURNS TABLE (
    "$anchor.identityColumnName$" $anchor.identity$,
$/ if schema.METADATA
    "$anchor.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.entityReferenceName$" $anchor.identity$,
$/ endif
$/ if schema.METADATA
    "$attribute.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if attribute.isHistorized
    "$attribute.changingColumnName$" $attribute.timeRange$,
$/ endif
$/ if attribute.isEquivalent
    "$attribute.equivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "$attribute.knotChecksumColumnName$" bytea,
$/ endif
$/ if attribute.knot.isEquivalent
    "$attribute.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
    "$attribute.knotValueColumnName$" $attribute.knot.dataRange$,
$/ if schema.METADATA
    "$attribute.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.checksumColumnName$" bytea,
$/ endif
$/ if attribute.isKnotted
    "$attribute.valueColumnName$" $attribute.knot.identity$$/ if not attribute.last() ,$/ endif
$/ else
    "$attribute.valueColumnName$" $attribute.dataRange$$/ if not attribute.last() ,$/ endif
$/ endif
$/ endfor
)
AS
$$
SELECT
    *
FROM
    $anchor.capsule$."ep$anchor.name$"(equivalent, $schema.metadata.now$::$schema.metadata.chronon$)
$$ LANGUAGE sql STABLE;
$/ if anchor.historizedAttributes
-- Difference equivalence perspective ---------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $anchor.capsule$."ed$anchor.name$" (
    equivalent $schema.metadata.equivalentRange$,
    intervalStart $schema.metadata.chronon$,
    intervalEnd $schema.metadata.chronon$,
    selection text
)
RETURNS TABLE (
    inspectedTimepoint $schema.metadata.chronon$,
    mnemonic text,
    "$anchor.identityColumnName$" $anchor.identity$,
$/ if schema.METADATA
    "$anchor.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.entityReferenceName$" $anchor.identity$,
$/ endif
$/ if schema.METADATA
    "$attribute.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if attribute.isHistorized
    "$attribute.changingColumnName$" $attribute.timeRange$,
$/ endif
$/ if attribute.isEquivalent
    "$attribute.equivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "$attribute.knotChecksumColumnName$" bytea,
$/ endif
$/ if attribute.knot.isEquivalent
    "$attribute.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
    "$attribute.knotValueColumnName$" $attribute.knot.dataRange$,
$/ if schema.METADATA
    "$attribute.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.checksumColumnName$" bytea,
$/ endif
$/ if attribute.isKnotted
    "$attribute.valueColumnName$" $attribute.knot.identity$$/ if not attribute.last() ,$/ endif
$/ else
    "$attribute.valueColumnName$" $attribute.dataRange$$/ if not attribute.last() ,$/ endif
$/ endif
$/ endfor
)
AS
$$
-- built as the difference perspective is, from the values of the equivalent
SELECT
    timepoints.inspectedTimepoint,
    timepoints.mnemonic,
    "$anchor.mnemonic$"."$anchor.identityColumnName$",
$/ if schema.METADATA
    "$anchor.mnemonic$"."$anchor.metadataColumnName$",
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
    "$attribute.mnemonic$"."$attribute.entityReferenceName$",
$/ endif
$/ if schema.METADATA
    "$attribute.mnemonic$"."$attribute.metadataColumnName$",
$/ endif
$/ if attribute.isHistorized
    "$attribute.mnemonic$"."$attribute.changingColumnName$",
$/ endif
$/ if attribute.isEquivalent
    "$attribute.mnemonic$"."$attribute.equivalentColumnName$",
$/ endif
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    "k$attribute.mnemonic$"."$attribute.knot.checksumColumnName$" AS "$attribute.knotChecksumColumnName$",
$/ endif
$/ if attribute.knot.isEquivalent
    "k$attribute.mnemonic$"."$attribute.knot.equivalentColumnName$" AS "$attribute.knotEquivalentColumnName$",
$/ endif
    "k$attribute.mnemonic$"."$attribute.knot.valueColumnName$" AS "$attribute.knotValueColumnName$",
$/ if schema.METADATA
    "k$attribute.mnemonic$"."$attribute.knot.metadataColumnName$" AS "$attribute.knotMetadataColumnName$",
$/ endif
$/ endif
$/ if attribute.hasChecksum
    "$attribute.mnemonic$"."$attribute.checksumColumnName$",
$/ endif
    "$attribute.mnemonic$"."$attribute.valueColumnName$"$/ if not attribute.last() ,$/ endif
$/ endfor
FROM (
$/ foreach historized in anchor.historizedAttributes
    SELECT DISTINCT
        h."$historized.entityReferenceName$" AS "$anchor.identityColumnName$",
        h."$historized.changingColumnName$"::$schema.metadata.chronon$ AS inspectedTimepoint,
        '$historized.mnemonic$' AS mnemonic
    FROM
$/ if historized.isEquivalent and not historized.isKnotted
        $historized.capsule$."e$historized.name$"(equivalent) h
$/ else
        $historized.capsule$."$historized.name$" h
$/ endif
    WHERE
        (selection IS NULL OR selection LIKE '%$historized.mnemonic$%')
    AND
        h."$historized.changingColumnName$" BETWEEN intervalStart AND intervalEnd
$/ if not historized.last()
    UNION
$/ endif
$/ endfor
) timepoints
JOIN
    $anchor.capsule$."$anchor.name$" "$anchor.mnemonic$"
ON
    "$anchor.mnemonic$"."$anchor.identityColumnName$" = timepoints."$anchor.identityColumnName$"
$/ foreach attribute in anchor.attributes
$/ if attribute.isHistorized
LEFT JOIN (
    SELECT
        h.*,
        lead(h."$attribute.changingColumnName$") OVER (
            PARTITION BY h."$attribute.entityReferenceName$"
            ORDER BY h."$attribute.changingColumnName$"
        ) AS "until"
    FROM
$/ if attribute.isEquivalent and not attribute.isKnotted
        $attribute.capsule$."e$attribute.name$"(equivalent) h
$/ else
        $attribute.capsule$."$attribute.name$" h
$/ endif
) "$attribute.mnemonic$"
ON
    "$attribute.mnemonic$"."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
AND
    "$attribute.mnemonic$"."$attribute.changingColumnName$" <= timepoints.inspectedTimepoint::$attribute.timeRange$
AND (
    "$attribute.mnemonic$"."until" IS NULL
OR
    "$attribute.mnemonic$"."until" > timepoints.inspectedTimepoint::$attribute.timeRange$
)
$/ else
LEFT JOIN
$/ if attribute.isEquivalent and not attribute.isKnotted
    $attribute.capsule$."e$attribute.name$"(equivalent) "$attribute.mnemonic$"
$/ else
    $attribute.capsule$."$attribute.name$" "$attribute.mnemonic$"
$/ endif
ON
    "$attribute.mnemonic$"."$attribute.entityReferenceName$" = "$anchor.mnemonic$"."$anchor.identityColumnName$"
$/ endif
$/ if attribute.isKnotted
LEFT JOIN
$/ if attribute.knot.isEquivalent
    $attribute.knot.capsule$."e$attribute.knot.name$"(equivalent) "k$attribute.mnemonic$"
$/ else
    $attribute.knot.capsule$."$attribute.knot.name$" "k$attribute.mnemonic$"
$/ endif
ON
    "k$attribute.mnemonic$"."$attribute.knot.identityColumnName$" = "$attribute.mnemonic$"."$attribute.knotReferenceName$"
$/ endif
$/ endfor
$$ LANGUAGE sql STABLE;
$/ endif
$/ endif
$/ endif
$/ endfor
