-- ATTRIBUTE EQUIVALENCE VIEWS ----------------------------------------------------------------------------------------
--
-- Equivalence views of attributes make it possible to retrieve data for only the given equivalent.
--
-- @equivalent the equivalent that you want to retrieve data for
--
$/ foreach attribute in schema.attributes
$/ if schema.EQUIVALENCE and attribute.isEquivalent and not attribute.isKnotted
-- Attribute equivalence view -----------------------------------------------------------------------------------------
-- $attribute.name$ parametrized view
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $attribute.capsule$.e$attribute.name$ (
    equivalent $schema.metadata.equivalentRange$
)
RETURNS TABLE (
    $attribute.entityReferenceName$ $attribute.parent.identity$,
$/ if attribute.isEquivalent
    $attribute.equivalentColumnName$ $schema.metadata.equivalentRange$,
$/ endif
$/ if attribute.hasChecksum
    $attribute.checksumColumnName$ numeric(19,0),
$/ endif
$/ if attribute.isHistorized
    $attribute.changingColumnName$ $attribute.timeRange$,
$/ endif
$/ if schema.METADATA
    $attribute.metadataColumnName$ $schema.metadata.metadataType$,
$/ endif
    $attribute.valueColumnName$ $attribute.dataRange$
)
AS
$$
    SELECT
        $attribute.entityReferenceName$,
$/ if attribute.isEquivalent
        $attribute.equivalentColumnName$,
$/ endif
$/ if attribute.hasChecksum
        $attribute.checksumColumnName$,
$/ endif
$/ if attribute.isHistorized
        $attribute.changingColumnName$,
$/ endif
$/ if schema.METADATA
        $attribute.metadataColumnName$,
$/ endif
        $attribute.valueColumnName$
    FROM
        $attribute.capsule$.$attribute.name$
    WHERE
        $attribute.equivalentColumnName$ = equivalent
$$
;
$/ endif
$/ endfor
