-- TIE TEMPORAL PERSPECTIVES ------------------------------------------------------------------------------------------
--
-- Snowflake-native tie perspectives: latest (l), point-in-time (p), now (n), difference (d),
-- and equivalence variants (el, ep, en, ed).
--
$/ foreach tie in schema.ties
-- Latest perspective -------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $tie.capsule$."l$tie.name$" (
$/ if schema.METADATA
    "$tie.metadataColumnName$",
$/ endif
$/ if tie.isHistorized
    "$tie.changingColumnName$",
$/ endif
$- the column list mirrors the select list below, since view column comments can only be given here
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$",
$/ endif
    $/ if role.hasComment "$role.knotValueColumnName$" COMMENT '$role.comment$'$/ else "$role.knotValueColumnName$"$/ endif,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    $/ if role.hasComment "$role.columnName$" COMMENT '$role.comment$'$/ else "$role.columnName$"$/ endif$/ if not role.last() ,$/ endif
$/ endfor
) COPY GRANTS $/ if tie.hasComment COMMENT = '$tie.comment$'$/ endif
AS
SELECT
$/ if schema.METADATA
    tie."$tie.metadataColumnName$",
$/ endif
$/ if tie.isHistorized
    tie."$tie.changingColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if role.knot.isEquivalent
    "$role.name$"."$role.knot.equivalentColumnName$" AS "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
FROM
    $tie.capsule$."$tie.name$" tie
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    TABLE($role.knot.capsule$."e$role.knot.name$"(0)) "$role.name$"
$/ else
    $role.knot.capsule$."$role.knot.name$" "$role.name$"
$/ endif
ON
    "$role.name$"."$role.knot.identityColumnName$" = tie."$role.columnName$"
$/ endfor
$/ if tie.isHistorized
QUALIFY -- picked by a window rather than by a subquery that refers to the outer row: for a tie without identifiers that
        -- subquery compares with OR, and then Snowflake keeps rows that it should not
$/ if tie.identifiers
    -- the latest value for the identifiers
    tie."$tie.changingColumnName$" = max(tie."$tie.changingColumnName$") OVER (
        PARTITION BY
$/ foreach role in tie.identifiers
            tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
    )
$/ else
    -- a tie without identifiers is one to one: the latest value for each of its anchors
$/ foreach role in tie.anchorRoles
    tie."$tie.changingColumnName$" = max(tie."$tie.changingColumnName$") OVER (PARTITION BY tie."$role.columnName$")
$/ if not role.last()
AND
$/ endif
$/ endfor
$/ endif
$/ endif
;
-- Point-in-time perspective ------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."p$tie.name$" (
    changingTimepoint $schema.metadata.chronon$
)
COPY GRANTS
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if tie.isHistorized
    "$tie.changingColumnName$" $tie.timeRange$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" numeric(19,0),
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
$/ if schema.METADATA
    tie."$tie.metadataColumnName$",
$/ endif
$/ if tie.isHistorized
    tie."$tie.changingColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if role.knot.isEquivalent
    "$role.name$"."$role.knot.equivalentColumnName$" AS "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
FROM
    $tie.capsule$."$tie.name$" tie
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    TABLE($role.knot.capsule$."e$role.knot.name$"(0)) "$role.name$"
$/ else
    $role.knot.capsule$."$role.knot.name$" "$role.name$"
$/ endif
ON
    "$role.name$"."$role.knot.identityColumnName$" = tie."$role.columnName$"
$/ endfor
$/ if tie.isHistorized
WHERE
    tie."$tie.changingColumnName$" <= changingTimepoint
QUALIFY -- picked by a window rather than by a subquery that refers to the outer row: for a tie without identifiers that
        -- subquery compares with OR, and then Snowflake keeps rows that it should not
$/ if tie.identifiers
    -- the latest value for the identifiers
    tie."$tie.changingColumnName$" = max(tie."$tie.changingColumnName$") OVER (
        PARTITION BY
$/ foreach role in tie.identifiers
            tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
    )
$/ else
    -- a tie without identifiers is one to one: the latest value for each of its anchors
$/ foreach role in tie.anchorRoles
    tie."$tie.changingColumnName$" = max(tie."$tie.changingColumnName$") OVER (PARTITION BY tie."$role.columnName$")
$/ if not role.last()
AND
$/ endif
$/ endfor
$/ endif
$/ endif
$$
;
-- Now perspective ----------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $tie.capsule$."n$tie.name$" COPY GRANTS AS
SELECT
    *
FROM
    TABLE($tie.capsule$."p$tie.name$"($schema.metadata.now$::$schema.metadata.chronon$))
;
$/ if tie.isHistorized
-- Difference perspective ---------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."d$tie.name$" (
    intervalStart $schema.metadata.chronon$,
    intervalEnd $schema.metadata.chronon$
)
COPY GRANTS
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
    "$tie.changingColumnName$" $tie.timeRange$,
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" numeric(19,0),
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
$/ if schema.METADATA
    tie."$tie.metadataColumnName$",
$/ endif
    tie."$tie.changingColumnName$",
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if role.knot.isEquivalent
    "$role.name$"."$role.knot.equivalentColumnName$" AS "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
FROM
    $tie.capsule$."$tie.name$" tie
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    TABLE($role.knot.capsule$."e$role.knot.name$"(0)) "$role.name$"
$/ else
    $role.knot.capsule$."$role.knot.name$" "$role.name$"
$/ endif
ON
    "$role.name$"."$role.knot.identityColumnName$" = tie."$role.columnName$"
$/ endfor
WHERE
    tie."$tie.changingColumnName$" BETWEEN intervalStart AND intervalEnd
$$
;
$/ endif
$/ if schema.EQUIVALENCE
-- Point-in-time equivalence perspective ------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."ep$tie.name$" (
    equivalent $schema.metadata.equivalentRange$,
    changingTimepoint $schema.metadata.chronon$
)
COPY GRANTS
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if tie.isHistorized
    "$tie.changingColumnName$" $tie.timeRange$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" numeric(19,0),
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
$/ if schema.METADATA
    tie."$tie.metadataColumnName$",
$/ endif
$/ if tie.isHistorized
    tie."$tie.changingColumnName$",
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if role.knot.isEquivalent
    "$role.name$"."$role.knot.equivalentColumnName$" AS "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
FROM
    $tie.capsule$."$tie.name$" tie
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    TABLE($role.knot.capsule$."e$role.knot.name$"(equivalent)) "$role.name$"
$/ else
    $role.knot.capsule$."$role.knot.name$" "$role.name$"
$/ endif
ON
    "$role.name$"."$role.knot.identityColumnName$" = tie."$role.columnName$"
$/ endfor
$/ if tie.isHistorized
WHERE
    tie."$tie.changingColumnName$" <= changingTimepoint
QUALIFY -- picked by a window rather than by a subquery that refers to the outer row: for a tie without identifiers that
        -- subquery compares with OR, and then Snowflake keeps rows that it should not
$/ if tie.identifiers
    -- the latest value for the identifiers
    tie."$tie.changingColumnName$" = max(tie."$tie.changingColumnName$") OVER (
        PARTITION BY
$/ foreach role in tie.identifiers
            tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
    )
$/ else
    -- a tie without identifiers is one to one: the latest value for each of its anchors
$/ foreach role in tie.anchorRoles
    tie."$tie.changingColumnName$" = max(tie."$tie.changingColumnName$") OVER (PARTITION BY tie."$role.columnName$")
$/ if not role.last()
AND
$/ endif
$/ endfor
$/ endif
$/ endif
$$
;
-- Latest equivalence perspective -------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."el$tie.name$" (
    equivalent $schema.metadata.equivalentRange$
)
COPY GRANTS
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if tie.isHistorized
    "$tie.changingColumnName$" $tie.timeRange$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" numeric(19,0),
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
    *
FROM
    TABLE($tie.capsule$."ep$tie.name$"(equivalent, $schema.metadata.now$::$schema.metadata.chronon$))
$$
;
-- Now equivalence perspective ----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."en$tie.name$" (
    equivalent $schema.metadata.equivalentRange$
)
COPY GRANTS
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ if tie.isHistorized
    "$tie.changingColumnName$" $tie.timeRange$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" numeric(19,0),
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
    *
FROM
    TABLE($tie.capsule$."ep$tie.name$"(equivalent, $schema.metadata.now$::$schema.metadata.chronon$))
$$
;
$/ if tie.isHistorized
-- Difference equivalence perspective ---------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.capsule$."ed$tie.name$" (
    equivalent $schema.metadata.equivalentRange$,
    intervalStart $schema.metadata.chronon$,
    intervalEnd $schema.metadata.chronon$
)
COPY GRANTS
RETURNS TABLE (
$/ if schema.METADATA
    "$tie.metadataColumnName$" $schema.metadata.metadataType$,
$/ endif
    "$tie.changingColumnName$" $tie.timeRange$,
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.knotChecksumColumnName$" numeric(19,0),
$/ endif
    "$role.knotValueColumnName$" $role.knot.dataRange$,
$/ if role.knot.isEquivalent
    "$role.knotEquivalentColumnName$" $schema.metadata.equivalentRange$,
$/ endif
$/ if schema.METADATA
    "$role.knotMetadataColumnName$" $schema.metadata.metadataType$,
$/ endif
$/ endif
    "$role.columnName$" $/ if role.entity $role.entity.identity$$/ else $role.knot.identity$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
AS
$$
SELECT
$/ if schema.METADATA
    tie."$tie.metadataColumnName$",
$/ endif
    tie."$tie.changingColumnName$",
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    "$role.name$"."$role.knot.checksumColumnName$" AS "$role.knotChecksumColumnName$",
$/ endif
    "$role.name$"."$role.knot.valueColumnName$" AS "$role.knotValueColumnName$",
$/ if role.knot.isEquivalent
    "$role.name$"."$role.knot.equivalentColumnName$" AS "$role.knotEquivalentColumnName$",
$/ endif
$/ if schema.METADATA
    "$role.name$"."$role.knot.metadataColumnName$" AS "$role.knotMetadataColumnName$",
$/ endif
$/ endif
    tie."$role.columnName$"$/ if not role.last() ,$/ endif
$/ endfor
FROM
    $tie.capsule$."$tie.name$" tie
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    TABLE($role.knot.capsule$."e$role.knot.name$"(equivalent)) "$role.name$"
$/ else
    $role.knot.capsule$."$role.knot.name$" "$role.name$"
$/ endif
ON
    "$role.name$"."$role.knot.identityColumnName$" = tie."$role.columnName$"
$/ endfor
WHERE
    tie."$tie.changingColumnName$" BETWEEN intervalStart AND intervalEnd
$$
;
$/ endif
$/ endif
$/ endfor
