-- INTEGRITY CHECKS ---------------------------------------------------------------------------------------------------
--
-- Snowflake does not enforce primary, unique or foreign keys, and every key here is declared RELY, which tells the
-- optimizer to trust it. A violation is therefore not an error, but wrong results. Every table has a view,
-- ic_<table>, that returns the rows that break what the table declares:
--
--   duplicate primary key, duplicate unique key   the same key more than once
--   no row in <table> for <column>                a reference to a row that does not exist
--   restatement                                   in an attribute or a tie that may not store them, a value
--                                                 that is the same as the one before it in changing time
--
-- A view that returns nothing has nothing wrong. IntegrityViolations is all of them together; it reads every table.
--
--   Construct     the table
--   Violation     what is wrong
--   ViolationKey  the key of the rows, as an object of column and value
--   Occurrences   how many rows
--
-- The orphan checks join to the table that is referred to and look for the rows without a match. They use a
-- column of the referred table in the WHERE clause, so a RELY foreign key cannot make the optimizer drop the join.
--
$/ foreach knot in schema.knots
$/ if schema.EQUIVALENCE and knot.isEquivalent
-- $knot.identityName$ integrity ------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $knot.capsule$.ic_$knot.identityName$ (
    Construct,
    Violation,
    ViolationKey,
    Occurrences
)
COPY GRANTS
AS
SELECT
    '$knot.identityName$',
    'duplicate primary key',
    OBJECT_CONSTRUCT('$knot.identityColumnName$', $knot.identityColumnName$),
    COUNT(*)
FROM
    $knot.capsule$.$knot.identityName$
GROUP BY
    $knot.identityColumnName$
HAVING
    COUNT(*) > 1;
-- $knot.equivalentName$ integrity ----------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $knot.capsule$.ic_$knot.equivalentName$ (
    Construct,
    Violation,
    ViolationKey,
    Occurrences
)
COPY GRANTS
AS
SELECT
    '$knot.equivalentName$',
    'duplicate primary key',
    OBJECT_CONSTRUCT('$knot.equivalentColumnName$', $knot.equivalentColumnName$, '$knot.identityColumnName$', $knot.identityColumnName$),
    COUNT(*)
FROM
    $knot.capsule$.$knot.equivalentName$
GROUP BY
    $knot.equivalentColumnName$,
    $knot.identityColumnName$
HAVING
    COUNT(*) > 1
UNION ALL
SELECT
    '$knot.equivalentName$',
    'duplicate unique key',
    OBJECT_CONSTRUCT('$knot.equivalentColumnName$', $knot.equivalentColumnName$, '$knot.uniqueColumnName$', $knot.uniqueColumnName$),
    COUNT(*)
FROM
    $knot.capsule$.$knot.equivalentName$
GROUP BY
    $knot.equivalentColumnName$,
    $knot.uniqueColumnName$
HAVING
    COUNT(*) > 1
UNION ALL
SELECT
    '$knot.equivalentName$',
    'no row in $knot.identityName$ for $knot.identityColumnName$',
    OBJECT_CONSTRUCT('$knot.identityColumnName$', c.$knot.identityColumnName$),
    COUNT(*)
FROM
    $knot.capsule$.$knot.equivalentName$ c
LEFT JOIN
    $knot.capsule$.$knot.identityName$ p
ON
    p.$knot.identityColumnName$ = c.$knot.identityColumnName$
WHERE
    p.$knot.identityColumnName$ IS NULL
GROUP BY
    c.$knot.identityColumnName$;
$/ else
-- $knot.name$ integrity --------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $knot.capsule$.ic_$knot.name$ (
    Construct,
    Violation,
    ViolationKey,
    Occurrences
)
COPY GRANTS
AS
SELECT
    '$knot.name$',
    'duplicate primary key',
    OBJECT_CONSTRUCT('$knot.identityColumnName$', $knot.identityColumnName$),
    COUNT(*)
FROM
    $knot.capsule$.$knot.name$
GROUP BY
    $knot.identityColumnName$
HAVING
    COUNT(*) > 1
UNION ALL
SELECT
    '$knot.name$',
    'duplicate unique key',
    OBJECT_CONSTRUCT('$knot.uniqueColumnName$', $knot.uniqueColumnName$),
    COUNT(*)
FROM
    $knot.capsule$.$knot.name$
GROUP BY
    $knot.uniqueColumnName$
HAVING
    COUNT(*) > 1;
$/ endif
$/ endfor
$/ foreach anchor in schema.anchors
-- $anchor.name$ integrity ------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $anchor.capsule$.ic_$anchor.name$ (
    Construct,
    Violation,
    ViolationKey,
    Occurrences
)
COPY GRANTS
AS
SELECT
    '$anchor.name$',
    'duplicate primary key',
    OBJECT_CONSTRUCT('$anchor.identityColumnName$', $anchor.identityColumnName$),
    COUNT(*)
FROM
    $anchor.capsule$.$anchor.name$
GROUP BY
    $anchor.identityColumnName$
HAVING
    COUNT(*) > 1;
$/ endfor
$/ foreach nexus in schema.nexuses
-- $nexus.name$ integrity -------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $nexus.capsule$.ic_$nexus.name$ (
    Construct,
    Violation,
    ViolationKey,
    Occurrences
)
COPY GRANTS
AS
SELECT
    '$nexus.name$',
    'duplicate primary key',
    OBJECT_CONSTRUCT('$nexus.identityColumnName$', $nexus.identityColumnName$),
    COUNT(*)
FROM
    $nexus.capsule$.$nexus.name$
GROUP BY
    $nexus.identityColumnName$
HAVING
    COUNT(*) > 1
$/ foreach role in nexus.roles
UNION ALL
SELECT
    '$nexus.name$',
$/ if role.entity
    'no row in $role.entity.name$ for $role.columnName$',
$/ else
$/ if role.knot.isEquivalent
    'no row in $role.knot.identityName$ for $role.columnName$',
$/ else
    'no row in $role.knot.name$ for $role.columnName$',
$/ endif
$/ endif
    OBJECT_CONSTRUCT('$role.columnName$', c.$role.columnName$),
    COUNT(*)
FROM
    $nexus.capsule$.$nexus.name$ c
LEFT JOIN
$/ if role.entity
    $role.entity.capsule$.$role.entity.name$ p
ON
    p.$role.entity.identityColumnName$ = c.$role.columnName$
WHERE
    p.$role.entity.identityColumnName$ IS NULL
$/ else
$/ if role.knot.isEquivalent
    $role.knot.capsule$.$role.knot.identityName$ p
$/ else
    $role.knot.capsule$.$role.knot.name$ p
$/ endif
ON
    p.$role.knot.identityColumnName$ = c.$role.columnName$
WHERE
    p.$role.knot.identityColumnName$ IS NULL
$/ endif
GROUP BY
    c.$role.columnName$
$/ endfor
;
$/ endfor
$/ foreach attribute in schema.attributes
-- $attribute.name$ integrity ---------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $attribute.capsule$.ic_$attribute.name$ (
    Construct,
    Violation,
    ViolationKey,
    Occurrences
)
COPY GRANTS
AS
SELECT
    '$attribute.name$',
    'duplicate primary key',
    OBJECT_CONSTRUCT(
$/ if attribute.isEquivalent
        '$attribute.equivalentColumnName$', $attribute.equivalentColumnName$,
$/ endif
        '$attribute.entityReferenceName$', $attribute.entityReferenceName$$/ if attribute.isHistorized ,$/ endif
$/ if attribute.isHistorized
        '$attribute.changingColumnName$', $attribute.changingColumnName$
$/ endif
    ),
    COUNT(*)
FROM
    $attribute.capsule$.$attribute.name$
GROUP BY
$/ if attribute.isEquivalent
    $attribute.equivalentColumnName$,
$/ endif
    $attribute.entityReferenceName$$/ if attribute.isHistorized ,$/ endif
$/ if attribute.isHistorized
    $attribute.changingColumnName$
$/ endif
HAVING
    COUNT(*) > 1
UNION ALL
SELECT
    '$attribute.name$',
    'no row in $attribute.parent.name$ for $attribute.entityReferenceName$',
    OBJECT_CONSTRUCT('$attribute.entityReferenceName$', c.$attribute.entityReferenceName$),
    COUNT(*)
FROM
    $attribute.capsule$.$attribute.name$ c
LEFT JOIN
    $attribute.parent.capsule$.$attribute.parent.name$ p
ON
    p.$attribute.parent.identityColumnName$ = c.$attribute.entityReferenceName$
WHERE
    p.$attribute.parent.identityColumnName$ IS NULL
GROUP BY
    c.$attribute.entityReferenceName$
$/ if attribute.isKnotted
UNION ALL
SELECT
    '$attribute.name$',
$/ if attribute.knot.isEquivalent
    'no row in $attribute.knot.identityName$ for $attribute.knotReferenceName$',
$/ else
    'no row in $attribute.knot.name$ for $attribute.knotReferenceName$',
$/ endif
    OBJECT_CONSTRUCT('$attribute.knotReferenceName$', c.$attribute.knotReferenceName$),
    COUNT(*)
FROM
    $attribute.capsule$.$attribute.name$ c
LEFT JOIN
$/ if attribute.knot.isEquivalent
    $attribute.knot.capsule$.$attribute.knot.identityName$ p
$/ else
    $attribute.knot.capsule$.$attribute.knot.name$ p
$/ endif
ON
    p.$attribute.knot.identityColumnName$ = c.$attribute.knotReferenceName$
WHERE
    p.$attribute.knot.identityColumnName$ IS NULL
GROUP BY
    c.$attribute.knotReferenceName$
$/ endif
$/ if attribute.isHistorized and not attribute.isRestatable and attribute.isComparable
UNION ALL
SELECT
    '$attribute.name$',
    'restatement',
    OBJECT_CONSTRUCT(
        '$attribute.entityReferenceName$', $attribute.entityReferenceName$,
$/ if attribute.isEquivalent
        '$attribute.equivalentColumnName$', $attribute.equivalentColumnName$,
$/ endif
        '$attribute.changingColumnName$', $attribute.changingColumnName$
    ),
    1
FROM (
    SELECT
        $attribute.entityReferenceName$,
$/ if attribute.isEquivalent
        $attribute.equivalentColumnName$,
$/ endif
        $attribute.changingColumnName$,
        $attribute.comparedColumnName$ AS compared,
        LAG($attribute.comparedColumnName$) OVER (
            PARTITION BY
                $attribute.entityReferenceName$$/ if attribute.isEquivalent ,$/ endif
$/ if attribute.isEquivalent
                $attribute.equivalentColumnName$
$/ endif
            ORDER BY
                $attribute.changingColumnName$
        ) AS previous
    FROM
        $attribute.capsule$.$attribute.name$
)
WHERE
    compared = previous
$/ endif
;
$/ endfor
$/ foreach tie in schema.ties
-- $tie.name$ integrity ---------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $tie.capsule$.ic_$tie.name$ (
    Construct,
    Violation,
    ViolationKey,
    Occurrences
)
COPY GRANTS
AS
SELECT
    '$tie.name$',
    'duplicate primary key',
    OBJECT_CONSTRUCT(
$/ if tie.identifiers
$/ foreach role in tie.identifiers
        '$role.columnName$', $role.columnName$$/ if not role.last() or tie.isHistorized ,$/ endif
$/ endfor
$/ else
$/ foreach role in tie.roles
        '$role.columnName$', $role.columnName$$/ if not role.last() or tie.isHistorized ,$/ endif
$/ endfor
$/ endif
$/ if tie.isHistorized
        '$tie.changingColumnName$', $tie.changingColumnName$
$/ endif
    ),
    COUNT(*)
FROM
    $tie.capsule$.$tie.name$
GROUP BY
$/ if tie.identifiers
$/ foreach role in tie.identifiers
    $role.columnName$$/ if not role.last() or tie.isHistorized ,$/ endif
$/ endfor
$/ else
$/ foreach role in tie.roles
    $role.columnName$$/ if not role.last() or tie.isHistorized ,$/ endif
$/ endfor
$/ endif
$/ if tie.isHistorized
    $tie.changingColumnName$
$/ endif
HAVING
    COUNT(*) > 1
$/ if not tie.identifiers
$/ foreach role in tie.roles where role.isAnchorRole
UNION ALL
SELECT
    '$tie.name$',
    'duplicate unique key ($role.name$)',
    OBJECT_CONSTRUCT(
        '$role.columnName$', $role.columnName$$/ if tie.isHistorized ,$/ endif
$/ if tie.isHistorized
        '$tie.changingColumnName$', $tie.changingColumnName$
$/ endif
    ),
    COUNT(*)
FROM
    $tie.capsule$.$tie.name$
GROUP BY
    $role.columnName$$/ if tie.isHistorized ,$/ endif
$/ if tie.isHistorized
    $tie.changingColumnName$
$/ endif
HAVING
    COUNT(*) > 1
$/ endfor
$/ endif
$/ foreach role in tie.roles
UNION ALL
SELECT
    '$tie.name$',
$/ if role.entity
    'no row in $role.entity.name$ for $role.columnName$',
$/ else
$/ if role.knot.isEquivalent
    'no row in $role.knot.identityName$ for $role.columnName$',
$/ else
    'no row in $role.knot.name$ for $role.columnName$',
$/ endif
$/ endif
    OBJECT_CONSTRUCT('$role.columnName$', c.$role.columnName$),
    COUNT(*)
FROM
    $tie.capsule$.$tie.name$ c
LEFT JOIN
$/ if role.entity
    $role.entity.capsule$.$role.entity.name$ p
ON
    p.$role.entity.identityColumnName$ = c.$role.columnName$
WHERE
    p.$role.entity.identityColumnName$ IS NULL
$/ else
$/ if role.knot.isEquivalent
    $role.knot.capsule$.$role.knot.identityName$ p
$/ else
    $role.knot.capsule$.$role.knot.name$ p
$/ endif
ON
    p.$role.knot.identityColumnName$ = c.$role.columnName$
WHERE
    p.$role.knot.identityColumnName$ IS NULL
$/ endif
GROUP BY
    c.$role.columnName$
$/ endfor
$/ if tie.isHistorized and tie.identifiers and tie.values and not tie.isRestatable
UNION ALL
SELECT
    '$tie.name$',
    'restatement',
    OBJECT_CONSTRUCT(
$/ foreach role in tie.identifiers
        '$role.columnName$', $role.columnName$,
$/ endfor
        '$tie.changingColumnName$', $tie.changingColumnName$
    ),
    1
FROM (
    SELECT
$/ foreach role in tie.identifiers
        $role.columnName$,
$/ endfor
$/ foreach role in tie.values
        $role.columnName$,
        LAG($role.columnName$) OVER (
            PARTITION BY
$/ foreach identifier in tie.identifiers
                $identifier.columnName$$/ if not identifier.last() ,$/ endif
$/ endfor
            ORDER BY
                $tie.changingColumnName$
        ) AS previous_$role.columnName$,
$/ endfor
        $tie.changingColumnName$
    FROM
        $tie.capsule$.$tie.name$
)
WHERE
$/ foreach role in tie.values
    $role.columnName$ = previous_$role.columnName$$/ if not role.last() AND$/ endif
$/ endfor
$/ endif
;
$/ endfor
-- IntegrityViolations ------------------------------------------------------------------------------------------------
-- Every integrity check of the model, in one view.
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $schema.metadata.encapsulation$.IntegrityViolations (
    Construct,
    Violation,
    ViolationKey,
    Occurrences
)
COPY GRANTS
AS
SELECT
    CAST(NULL AS VARCHAR),
    CAST(NULL AS VARCHAR),
    CAST(NULL AS OBJECT),
    CAST(NULL AS NUMBER)
WHERE
    FALSE
$/ foreach knot in schema.knots
$/ if schema.EQUIVALENCE and knot.isEquivalent
UNION ALL SELECT * FROM $knot.capsule$.ic_$knot.identityName$
UNION ALL SELECT * FROM $knot.capsule$.ic_$knot.equivalentName$
$/ else
UNION ALL SELECT * FROM $knot.capsule$.ic_$knot.name$
$/ endif
$/ endfor
$/ foreach anchor in schema.anchors
UNION ALL SELECT * FROM $anchor.capsule$.ic_$anchor.name$
$/ endfor
$/ foreach nexus in schema.nexuses
UNION ALL SELECT * FROM $nexus.capsule$.ic_$nexus.name$
$/ endfor
$/ foreach attribute in schema.attributes
UNION ALL SELECT * FROM $attribute.capsule$.ic_$attribute.name$
$/ endfor
$/ foreach tie in schema.ties
UNION ALL SELECT * FROM $tie.capsule$.ic_$tie.name$
$/ endfor
;
