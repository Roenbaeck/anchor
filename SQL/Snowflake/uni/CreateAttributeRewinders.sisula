-- ATTRIBUTE REWINDERS ------------------------------------------------------------------------------------------------
--
-- These table valued functions rewind an attribute table to the given
-- point in changing time. It does not pick a temporal perspective and
-- instead shows all rows that have been in effect before that point
-- in time.
--
-- @changingTimepoint the point in changing time to rewind to
--
$/ foreach attribute in schema.attributes
$/ if attribute.isHistorized
-- Attribute rewinder -------------------------------------------------------------------------------------------------
-- r$attribute.name$ rewinding over changing time function
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $attribute.capsule$.r$attribute.name$ (
$/ if attribute.isEquivalent and not attribute.isKnotted
    equivalent $schema.metadata.equivalentRange$,
$/ endif
    changingTimepoint $attribute.timeRange$
)
RETURNS TABLE (
$/ if schema.METADATA
    $attribute.metadataColumnName$ $schema.metadata.metadataType$,
$/ endif
    $attribute.entityReferenceName$ $attribute.parent.identity$,
$/ if attribute.isEquivalent
    $attribute.equivalentColumnName$ $schema.metadata.equivalentRange$,
$/ endif
$/ if not attribute.isKnotted and attribute.hasChecksum
    $attribute.checksumColumnName$ numeric(19,0),
$/ endif
    $/ if attribute.isKnotted $attribute.valueColumnName$ $attribute.knot.identity$, $/ else $attribute.valueColumnName$ $attribute.dataRange$,$/ endif
    $attribute.changingColumnName$ $attribute.timeRange$
)
AS
$$
    SELECT
$/ if schema.METADATA
        $attribute.metadataColumnName$,
$/ endif
        $attribute.entityReferenceName$,
$/ if attribute.isEquivalent
        $attribute.equivalentColumnName$,
$/ endif
$/ if not attribute.isKnotted and attribute.hasChecksum
        $attribute.checksumColumnName$,
$/ endif
        $attribute.valueColumnName$,
        $attribute.changingColumnName$
    FROM
        $/ if attribute.isEquivalent and not attribute.isKnotted TABLE($attribute.capsule$.e$attribute.name$(equivalent)) $/ else $attribute.capsule$.$attribute.name$$/ endif
    WHERE
        $attribute.changingColumnName$ <= changingTimepoint
$$
;
$/ endif
$/ endfor
