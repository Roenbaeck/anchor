-- NEXUSES ------------------------------------------------------------------------------------------------------------
--
-- Nexuses store immutable identities for event-like entities.
--
$/ foreach nexus in schema.nexuses
-- Nexus table --------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
$/ if nexus.isGenerator
CREATE SEQUENCE IF NOT EXISTS $nexus.capsule$.$nexus.identitySequenceName$ START 1 INCREMENT 1;
$/ endif
CREATE TABLE IF NOT EXISTS $nexus.capsule$.$nexus.name$ (
    $nexus.identityColumnName$ $/ if nexus.isGenerator $nexus.identity$ default $nexus.capsule$.$nexus.identitySequenceName$.nextval not null, $/ else $nexus.identity$ not null,$/ endif
$/ foreach role in nexus.roles
    $role.columnName$ $/ if role.entity $role.entity.identity$ not null, $/ else $role.knot.identity$ not null,$/ endif
$/ endfor
$/ foreach role in nexus.roles
    constraint $nexus.name$_fk$role.name$ foreign key (
        $role.columnName$
$/ if role.entity
    ) references $role.entity.capsule$.$role.entity.name$($role.entity.identityColumnName$) RELY, $--$
$/ else
    ) references $role.knot.capsule$.$role.knot.name$($role.knot.identityColumnName$) RELY,
$/ endif
$/ endfor
    $/ if schema.METADATA $nexus.metadataColumnName$ $schema.metadata.metadataType$ not null, $/ else $nexus.dummyColumnName$ boolean null,$/ endif
    constraint pk$nexus.name$ primary key (
        $nexus.identityColumnName$
    ) RELY
) CLUSTER BY ($nexus.identityColumnName$);
$/ endfor
