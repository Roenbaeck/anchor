-- ANCHORS ------------------------------------------------------------------------------------------------------------
--
-- Anchors are used to store the identities of entities.
-- Anchors are immutable.
--
$/ foreach anchor in schema.anchors
-- Anchor table -------------------------------------------------------------------------------------------------------
-- $anchor.name$ table (with $anchor.attributeCount$ attributes)
-----------------------------------------------------------------------------------------------------------------------
$/ if anchor.isGenerator
CREATE SEQUENCE IF NOT EXISTS $anchor.capsule$."$anchor.identitySequenceName$" START WITH 1 INCREMENT BY 1;
$/ endif
CREATE TABLE IF NOT EXISTS $anchor.capsule$."$anchor.name$" (
    "$anchor.identityColumnName$" $/ if anchor.isGenerator $anchor.identity$ default nextval('$anchor.capsule$."$anchor.identitySequenceName$"') not null, $/ else $anchor.identity$ not null,$/ endif
$/ if schema.METADATA
    "$anchor.metadataColumnName$" $schema.metadata.metadataType$ not null,
$/ endif
    constraint "pk$anchor.name$" primary key (
        "$anchor.identityColumnName$"
    )
) ORDER BY "$anchor.identityColumnName$" SEGMENTED BY MODULARHASH("$anchor.identityColumnName$") ALL NODES;
$/ endfor
