-- KNOTS --------------------------------------------------------------------------------------------------------------
--
-- Knots are immutable lookup tables for values.
--
$/ foreach knot in schema.knots
-- Knot table ---------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
$/ if knot.isGenerator
CREATE SEQUENCE IF NOT EXISTS $knot.capsule$."$knot.identitySequenceName$" START WITH 1 INCREMENT BY 1;
$/ endif
CREATE TABLE IF NOT EXISTS $knot.capsule$."$knot.name$" (
    "$knot.identityColumnName$" $/ if knot.isGenerator $knot.identity$ default nextval('$knot.capsule$."$knot.identitySequenceName$"') not null, $/ else $knot.identity$ not null,$/ endif
    "$knot.valueColumnName$" $knot.dataRange$ not null,
$/ if knot.hasChecksum
    "$knot.checksumColumnName$" int default hash("$knot.valueColumnName$"),
$/ endif
$/ if schema.METADATA
    "$knot.metadataColumnName$" $schema.metadata.metadataType$ not null,
$/ endif
    constraint "pk$knot.name$" primary key (
        "$knot.identityColumnName$"
    ),
    constraint "uq$knot.name$" unique (
        $/ if knot.hasChecksum "$knot.checksumColumnName$" $/ else "$knot.valueColumnName$"$/ endif
    )
) ORDER BY "$knot.identityColumnName$" UNSEGMENTED ALL NODES;
$/ endfor
