-- ANCHORS ------------------------------------------------------------------------------------------------------------
--
-- Anchors are used to store the identities of entities.
-- Anchors are immutable.
--
$/ foreach anchor in schema.anchors
-- Anchor table -------------------------------------------------------------------------------------------------------
-- $anchor.name$ table (with $anchor.attributeCount$ attributes)
-----------------------------------------------------------------------------------------------------------------------
$/ if anchor.isGenerator
BEGIN
    EXECUTE IMMEDIATE q'[CREATE SEQUENCE $anchor.qualifier$$anchor.identitySequenceName$ START WITH 1 INCREMENT BY 1]';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE <> -955 THEN RAISE; END IF;
END;
/
$/ endif
BEGIN
    EXECUTE IMMEDIATE q'[
        CREATE TABLE $anchor.qualifier$$anchor.name$ (
            $anchor.identityColumnName$ $/ if anchor.isGenerator $anchor.identity$ default $anchor.qualifier$$anchor.identitySequenceName$.nextval not null, $/ else $anchor.identity$ not null,$/ endif
$/ if schema.METADATA
            $anchor.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
            constraint pk$anchor.name$ primary key (
                $anchor.identityColumnName$
            )
        )
    ]';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE <> -955 THEN RAISE; END IF;
END;
/
$/ endfor
