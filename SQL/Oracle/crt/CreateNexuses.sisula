-- NEXUSES ------------------------------------------------------------------------------------------------------------
--
-- Nexuses are used to store identities for event-like entities.
-- Nexuses are immutable.
--
$/ foreach nexus in schema.nexuses
-- Nexus table --------------------------------------------------------------------------------------------------------
-- $nexus.name$ table (with $nexus.attributeCount$ attributes and $nexus.roleCount$ roles)
-----------------------------------------------------------------------------------------------------------------------
$/ if nexus.isGenerator
BEGIN
    EXECUTE IMMEDIATE q'[CREATE SEQUENCE $nexus.qualifier$$nexus.identitySequenceName$ START WITH 1 INCREMENT BY 1]';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE <> -955 THEN RAISE; END IF;
END;
/
$/ endif
BEGIN
    EXECUTE IMMEDIATE q'[
        CREATE TABLE $nexus.qualifier$$nexus.name$ (
            $nexus.identityColumnName$ $/ if nexus.isGenerator $nexus.identity$ default $nexus.qualifier$$nexus.identitySequenceName$.nextval not null, $/ else $nexus.identity$ not null,$/ endif
$/ foreach role in nexus.roles
            $role.columnName$ $/ if role.entity $role.entity.identity$ not null, $/ else $role.knot.identity$ not null,$/ endif
$/ endfor
            $/ if schema.METADATA $nexus.metadataColumnName$ $schema.metadata.metadataType$ not null, $/ else $nexus.dummyColumnName$ number(1) null,$/ endif
$/ foreach role in nexus.roles
            constraint $nexus.name$_fk$role.name$ foreign key (
                $role.columnName$
$/ if role.entity
            ) references $role.entity.qualifier$$role.entity.name$($role.entity.identityColumnName$),
$/ else
            ) references $role.knot.qualifier$$role.knot.name$($role.knot.identityColumnName$),
$/ endif
$/ endfor
            constraint pk$nexus.name$ primary key (
                $nexus.identityColumnName$
            )
        )
    ]';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE <> -955 THEN RAISE; END IF;
END;
/
$/ endfor
