-- ATTRIBUTE REWINDERS AND FORWARDERS ---------------------------------------------------------------------------------
--
-- These SQL table macros rewind an attribute posit table to the given
-- point in changing time, or an attribute annex table to the given point
-- in positing time. It does not pick a temporal perspective and
-- instead shows all rows that have been in effect before that point
-- in time. The forwarder is the opposite of the rewinder, such that the
-- union of the two will produce all rows in a posit table.
--
-- A SQL table macro (SQL_MACRO, Oracle Database 19.7 or later) is a function that returns the text of a query, in which
-- its parameters stand for the values given. It is called in the FROM clause of a query, like a table:
-- SELECT * FROM rAC_NAM_Actor_Name(CAST(NULL AS number), TIMESTAMP '2020-01-01 00:00:00', TIMESTAMP '2020-01-01 00:00:00').
--
-- The assembled rewinder and forwarder pick, for each posit and positor, the annex row that was last posited
-- at or before the positing time (the macros do not call each other, they do what the others do in their own query).
--
-- @positor the view of which positor to adopt, or null for the views of all of them
-- @changingTimepoint the point in changing time to rewind to
-- @positingTimepoint the point in positing time to rewind to
--
$/ foreach attribute in schema.attributes
$/ if attribute.isHistorized
-- Attribute posit rewinder -------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $attribute.qualifier$r$attribute.positName$ (
    changingTimepoint IN $attribute.timeRangeType$
)
RETURN VARCHAR2 SQL_MACRO
IS
BEGIN
    RETURN q'[
        SELECT
            $attribute.identityColumnName$,
            $attribute.entityReferenceName$,
$/ if attribute.compareByChecksum
            $attribute.checksumColumnName$,
$/ endif
            $attribute.valueColumnName$,
            $attribute.changingColumnName$
        FROM
            $attribute.qualifier$$attribute.positName$
        WHERE
            $attribute.changingColumnName$ <= changingTimepoint
    ]';
END r$attribute.positName$;
/
-- Attribute posit forwarder ------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $attribute.qualifier$f$attribute.positName$ (
    changingTimepoint IN $attribute.timeRangeType$
)
RETURN VARCHAR2 SQL_MACRO
IS
BEGIN
    RETURN q'[
        SELECT
            $attribute.identityColumnName$,
            $attribute.entityReferenceName$,
$/ if attribute.compareByChecksum
            $attribute.checksumColumnName$,
$/ endif
            $attribute.valueColumnName$,
            $attribute.changingColumnName$
        FROM
            $attribute.qualifier$$attribute.positName$
        WHERE
            $attribute.changingColumnName$ > changingTimepoint
    ]';
END f$attribute.positName$;
/
$/ endif
-- Attribute annex rewinder -------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $attribute.qualifier$r$attribute.annexName$ (
    positingTimepoint IN $schema.metadata.positingRangeType$
)
RETURN VARCHAR2 SQL_MACRO
IS
BEGIN
    RETURN q'[
        SELECT
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.identityColumnName$,
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$,
            $attribute.assertionColumnName$
        FROM
            $attribute.qualifier$$attribute.annexName$
        WHERE
            $attribute.positingColumnName$ <= positingTimepoint
    ]';
END r$attribute.annexName$;
/
$/ if attribute.isHistorized
-- Attribute assembled rewinder ---------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $attribute.qualifier$r$attribute.name$ (
    positor IN $schema.metadata.positorRangeType$,
    changingTimepoint IN $attribute.timeRangeType$,
    positingTimepoint IN $schema.metadata.positingRangeType$
)
RETURN VARCHAR2 SQL_MACRO
IS
BEGIN
    RETURN q'[
        SELECT
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.identityColumnName$,
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$,
            $attribute.assertionColumnName$,
            $attribute.entityReferenceName$,
$/ if attribute.compareByChecksum
            $attribute.checksumColumnName$,
$/ endif
            $attribute.valueColumnName$,
            $attribute.changingColumnName$
        FROM (
            SELECT
$/ if schema.METADATA
                a.$attribute.metadataColumnName$,
$/ endif
                p.$attribute.identityColumnName$,
                a.$attribute.positingColumnName$,
                a.$attribute.positorColumnName$,
                a.$attribute.reliabilityColumnName$,
                a.$attribute.assertionColumnName$,
                p.$attribute.entityReferenceName$,
$/ if attribute.compareByChecksum
                p.$attribute.checksumColumnName$,
$/ endif
                p.$attribute.valueColumnName$,
                p.$attribute.changingColumnName$,
                ROW_NUMBER() OVER (
                    PARTITION BY
                        p.$attribute.identityColumnName$,
                        a.$attribute.positorColumnName$
                    ORDER BY
                        a.$attribute.positingColumnName$ DESC
                ) AS rowNumber
            FROM
                $attribute.qualifier$$attribute.positName$ p
            JOIN
                $attribute.qualifier$$attribute.annexName$ a
            ON
                a.$attribute.identityColumnName$ = p.$attribute.identityColumnName$
            AND
                a.$attribute.positorColumnName$ = COALESCE(positor, a.$attribute.positorColumnName$)
            WHERE
                p.$attribute.changingColumnName$ <= changingTimepoint
            AND
                a.$attribute.positingColumnName$ <= positingTimepoint
        )
        WHERE
            rowNumber = 1
    ]';
END r$attribute.name$;
/
-- Attribute assembled forwarder --------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $attribute.qualifier$f$attribute.name$ (
    positor IN $schema.metadata.positorRangeType$,
    changingTimepoint IN $attribute.timeRangeType$,
    positingTimepoint IN $schema.metadata.positingRangeType$
)
RETURN VARCHAR2 SQL_MACRO
IS
BEGIN
    RETURN q'[
        SELECT
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.identityColumnName$,
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$,
            $attribute.assertionColumnName$,
            $attribute.entityReferenceName$,
$/ if attribute.compareByChecksum
            $attribute.checksumColumnName$,
$/ endif
            $attribute.valueColumnName$,
            $attribute.changingColumnName$
        FROM (
            SELECT
$/ if schema.METADATA
                a.$attribute.metadataColumnName$,
$/ endif
                p.$attribute.identityColumnName$,
                a.$attribute.positingColumnName$,
                a.$attribute.positorColumnName$,
                a.$attribute.reliabilityColumnName$,
                a.$attribute.assertionColumnName$,
                p.$attribute.entityReferenceName$,
$/ if attribute.compareByChecksum
                p.$attribute.checksumColumnName$,
$/ endif
                p.$attribute.valueColumnName$,
                p.$attribute.changingColumnName$,
                ROW_NUMBER() OVER (
                    PARTITION BY
                        p.$attribute.identityColumnName$,
                        a.$attribute.positorColumnName$
                    ORDER BY
                        a.$attribute.positingColumnName$ DESC
                ) AS rowNumber
            FROM
                $attribute.qualifier$$attribute.positName$ p
            JOIN
                $attribute.qualifier$$attribute.annexName$ a
            ON
                a.$attribute.identityColumnName$ = p.$attribute.identityColumnName$
            AND
                a.$attribute.positorColumnName$ = COALESCE(positor, a.$attribute.positorColumnName$)
            WHERE
                p.$attribute.changingColumnName$ > changingTimepoint
            AND
                a.$attribute.positingColumnName$ <= positingTimepoint
        )
        WHERE
            rowNumber = 1
    ]';
END f$attribute.name$;
/
$/ else
-- Attribute assembled rewinder ---------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $attribute.qualifier$r$attribute.name$ (
    positor IN $schema.metadata.positorRangeType$,
    positingTimepoint IN $schema.metadata.positingRangeType$
)
RETURN VARCHAR2 SQL_MACRO
IS
BEGIN
    RETURN q'[
        SELECT
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.identityColumnName$,
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$,
            $attribute.assertionColumnName$,
            $attribute.entityReferenceName$,
$/ if attribute.compareByChecksum
            $attribute.checksumColumnName$,
$/ endif
            $attribute.valueColumnName$
        FROM (
            SELECT
$/ if schema.METADATA
                a.$attribute.metadataColumnName$,
$/ endif
                p.$attribute.identityColumnName$,
                a.$attribute.positingColumnName$,
                a.$attribute.positorColumnName$,
                a.$attribute.reliabilityColumnName$,
                a.$attribute.assertionColumnName$,
                p.$attribute.entityReferenceName$,
$/ if attribute.compareByChecksum
                p.$attribute.checksumColumnName$,
$/ endif
                p.$attribute.valueColumnName$,
                ROW_NUMBER() OVER (
                    PARTITION BY
                        p.$attribute.identityColumnName$,
                        a.$attribute.positorColumnName$
                    ORDER BY
                        a.$attribute.positingColumnName$ DESC
                ) AS rowNumber
            FROM
                $attribute.qualifier$$attribute.positName$ p
            JOIN
                $attribute.qualifier$$attribute.annexName$ a
            ON
                a.$attribute.identityColumnName$ = p.$attribute.identityColumnName$
            AND
                a.$attribute.positorColumnName$ = COALESCE(positor, a.$attribute.positorColumnName$)
            WHERE
                a.$attribute.positingColumnName$ <= positingTimepoint
        )
        WHERE
            rowNumber = 1
    ]';
END r$attribute.name$;
/
$/ endif
$/ endfor
