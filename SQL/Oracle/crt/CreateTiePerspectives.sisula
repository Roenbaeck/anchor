-- TIE TEMPORAL PERSPECTIVES ------------------------------------------------------------------------------------------
--
-- CRT tie perspectives: time traveling (t), latest (l), point-in-time (p),
-- now (n), and difference (d).
--
-- The time traveling, point-in-time and difference perspectives are SQL table macros (SQL_MACRO, Oracle Database 19.7 or
-- later): a function that returns the text of a query, in which its parameters stand for the values given. They are called
-- in the FROM clause of a query, like a table: SELECT * FROM pAC_part_PR_wasPlayed(TIMESTAMP '2020-01-01 00:00:00').
--
-- The rewinder of a tie is not called in the macros, what it does is written out in them: the posit and annex of the
-- tie joined, the annex with the latest positing time picked for each posit and positor.
--
-- The latest and now perspectives are views over the point-in-time macro. A macro cannot be given a column of another
-- table to work for each positor, so the point-in-time macro works out the views of all positors itself, as does the
-- difference macro. The time traveling macro shows one positor, given by its first argument.
--
-- A table alias is written inside double quotes where it can be a word that Oracle reserves.
--
$/ foreach tie in schema.ties
$- only do perspectives if there are roles
$/ if tie.roles
-- Time traveling perspective -----------------------------------------------------------------------------------------
-- The posits that the positor holds, as known at the positing time, in effect at the changing time, for the assertion
-- given ('+', '-', '?', or null for the positive and negative ones that are in effect).
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.qualifier$t$tie.name$ (
    forPositor IN $schema.metadata.positorRangeType$,
    changingTimepoint IN $schema.metadata.chrononType$,
    positingTimepoint IN $schema.metadata.positingRangeType$,
    assertion IN VARCHAR2
)
RETURN VARCHAR2 SQL_MACRO
IS
BEGIN
    RETURN q'[
        SELECT
$/ if schema.METADATA
            t.$tie.metadataColumnName$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
            "k$role.name$".$role.knot.checksumColumnName$ AS $role.knotChecksumColumnName$,
$/ endif
            "k$role.name$".$role.knot.valueColumnName$ AS $role.knotValueColumnName$,
$/ if schema.METADATA
            "k$role.name$".$role.knot.metadataColumnName$ AS $role.knotMetadataColumnName$,
$/ endif
$/ endif
            t.$role.columnName$,
$/ endfor
$/ if tie.isHistorized
            t.$tie.changingColumnName$,
$/ endif
            t.$tie.positingColumnName$,
            t.$tie.positorColumnName$,
            t.$tie.reliabilityColumnName$,
            t.$tie.assertionColumnName$
        FROM (
            SELECT
                s.*,
$/ if tie.identifiers
                ROW_NUMBER() OVER (
                    PARTITION BY
                        s.$tie.positorColumnName$,
$/ foreach role in tie.identifiers
                        s.$role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
                    ORDER BY
$/ if tie.isHistorized
                        s.$tie.changingColumnName$ DESC,
$/ endif
                        s.$tie.positingColumnName$ DESC,
                        s.$tie.reliabilityColumnName$ DESC,
                        s.$tie.identityColumnName$ DESC
                ) AS latestPosit
$/ else
$/ foreach role in tie.anchorRoles
                ROW_NUMBER() OVER (
                    PARTITION BY s.$tie.positorColumnName$, s.$role.columnName$
                    ORDER BY
$/ if tie.isHistorized
                        s.$tie.changingColumnName$ DESC,
$/ endif
                        s.$tie.positingColumnName$ DESC,
                        s.$tie.reliabilityColumnName$ DESC,
                        s.$tie.identityColumnName$ DESC
                ) AS latestPosit$role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
            FROM (
                SELECT
                    r.*$/ if tie.isHistorized ,$/ endif
$/ if tie.isHistorized
                    MAX(CASE WHEN r.$tie.assertionColumnName$ <> '?' THEN r.$tie.changingColumnName$ END) OVER (
                        PARTITION BY
                            r.$tie.positorColumnName$,
$/ if tie.identifiers
$/ foreach role in tie.identifiers
                            r.$role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
$/ else
$/ foreach role in tie.roles
                            r.$role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
                    ) AS inEffect
$/ endif
                FROM (
                    SELECT
$/ if schema.METADATA
                        an.$tie.metadataColumnName$,
$/ endif
                        po.$tie.identityColumnName$,
$/ foreach role in tie.roles
                        po.$role.columnName$,
$/ endfor
$/ if tie.isHistorized
                        po.$tie.changingColumnName$,
$/ endif
                        an.$tie.positingColumnName$,
                        an.$tie.positorColumnName$,
                        an.$tie.reliabilityColumnName$,
                        an.$tie.assertionColumnName$,
                        ROW_NUMBER() OVER (
                            PARTITION BY po.$tie.identityColumnName$, an.$tie.positorColumnName$
                            ORDER BY an.$tie.positingColumnName$ DESC
                        ) AS rewindRank
                    FROM
                        $tie.qualifier$$tie.positName$ po
                    JOIN
                        $tie.qualifier$$tie.annexName$ an
                    ON
                        an.$tie.identityColumnName$ = po.$tie.identityColumnName$
                    WHERE
$/ if tie.isHistorized
                        po.$tie.changingColumnName$ <= CAST(changingTimepoint AS $tie.timeRange$)
                    AND
$/ endif
                        an.$tie.positingColumnName$ <= CAST(positingTimepoint AS $schema.metadata.positingRange$)
                ) r
                WHERE
                    r.rewindRank = 1
            ) s
            WHERE
                s.$tie.assertionColumnName$ = COALESCE(assertion, s.$tie.assertionColumnName$)
$/ if tie.isHistorized
            AND (
                COALESCE(assertion, '?') = '?'
            OR
                s.$tie.changingColumnName$ = s.inEffect
            )
$/ endif
        ) t
$/ foreach role in tie.knotRoles
        LEFT JOIN
            $role.knot.qualifier$$role.knot.name$ "k$role.name$"
        ON
            "k$role.name$".$role.knot.identityColumnName$ = t.$role.columnName$
$/ endfor
        WHERE
            t.$tie.positorColumnName$ = forPositor
$/ if tie.identifiers
        AND
            t.latestPosit = 1
$/ else
$/ foreach role in tie.anchorRoles
        AND
            t.latestPosit$role.columnName$ = 1
$/ endfor
$/ endif
    ]';
END t$tie.name$;
/
-- Point-in-time perspective ------------------------------------------------------------------------------------------
-- What each positor holds as known now (positing time end of time) and in effect at the changing time, with the positor
-- and a reliability that is null since a perspective does not combine the reliabilities of the posits.
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.qualifier$p$tie.name$ (
    changingTimepoint IN $schema.metadata.chrononType$
)
RETURN VARCHAR2 SQL_MACRO
IS
BEGIN
    RETURN q'[
        SELECT
            positorTable.$schema.metadata.positorSuffix$,
            CAST(NULL AS $schema.metadata.reliabilityRange$) AS $schema.metadata.reliabilitySuffix$,
$/ if schema.METADATA
            t.$tie.metadataColumnName$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
            "k$role.name$".$role.knot.checksumColumnName$ AS $role.knotChecksumColumnName$,
$/ endif
            "k$role.name$".$role.knot.valueColumnName$ AS $role.knotValueColumnName$,
$/ if schema.METADATA
            "k$role.name$".$role.knot.metadataColumnName$ AS $role.knotMetadataColumnName$,
$/ endif
$/ endif
            t.$role.columnName$,
$/ endfor
$/ if tie.isHistorized
            t.$tie.changingColumnName$,
$/ endif
            t.$tie.positingColumnName$,
            t.$tie.positorColumnName$,
            t.$tie.reliabilityColumnName$,
            t.$tie.assertionColumnName$
        FROM (
            SELECT
                s.*,
$/ if tie.identifiers
                ROW_NUMBER() OVER (
                    PARTITION BY
                        s.$tie.positorColumnName$,
$/ foreach role in tie.identifiers
                        s.$role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
                    ORDER BY
$/ if tie.isHistorized
                        s.$tie.changingColumnName$ DESC,
$/ endif
                        s.$tie.positingColumnName$ DESC,
                        s.$tie.reliabilityColumnName$ DESC,
                        s.$tie.identityColumnName$ DESC
                ) AS latestPosit
$/ else
$/ foreach role in tie.anchorRoles
                ROW_NUMBER() OVER (
                    PARTITION BY s.$tie.positorColumnName$, s.$role.columnName$
                    ORDER BY
$/ if tie.isHistorized
                        s.$tie.changingColumnName$ DESC,
$/ endif
                        s.$tie.positingColumnName$ DESC,
                        s.$tie.reliabilityColumnName$ DESC,
                        s.$tie.identityColumnName$ DESC
                ) AS latestPosit$role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
            FROM (
                SELECT
                    r.*$/ if tie.isHistorized ,$/ endif
$/ if tie.isHistorized
                    MAX(CASE WHEN r.$tie.assertionColumnName$ <> '?' THEN r.$tie.changingColumnName$ END) OVER (
                        PARTITION BY
                            r.$tie.positorColumnName$,
$/ if tie.identifiers
$/ foreach role in tie.identifiers
                            r.$role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
$/ else
$/ foreach role in tie.roles
                            r.$role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
                    ) AS inEffect
$/ endif
                FROM (
                    SELECT
$/ if schema.METADATA
                        an.$tie.metadataColumnName$,
$/ endif
                        po.$tie.identityColumnName$,
$/ foreach role in tie.roles
                        po.$role.columnName$,
$/ endfor
$/ if tie.isHistorized
                        po.$tie.changingColumnName$,
$/ endif
                        an.$tie.positingColumnName$,
                        an.$tie.positorColumnName$,
                        an.$tie.reliabilityColumnName$,
                        an.$tie.assertionColumnName$,
                        ROW_NUMBER() OVER (
                            PARTITION BY po.$tie.identityColumnName$, an.$tie.positorColumnName$
                            ORDER BY an.$tie.positingColumnName$ DESC
                        ) AS rewindRank
                    FROM
                        $tie.qualifier$$tie.positName$ po
                    JOIN
                        $tie.qualifier$$tie.annexName$ an
                    ON
                        an.$tie.identityColumnName$ = po.$tie.identityColumnName$
                    WHERE
$/ if tie.isHistorized
                        po.$tie.changingColumnName$ <= CAST(changingTimepoint AS $tie.timeRange$)
                    AND
$/ endif
                        an.$tie.positingColumnName$ <= CAST(TIMESTAMP '$schema.EOTValue$' AS $schema.metadata.positingRange$)
                ) r
                WHERE
                    r.rewindRank = 1
            ) s
            WHERE
                s.$tie.assertionColumnName$ = '+'
$/ if tie.isHistorized
            AND
                s.$tie.changingColumnName$ = s.inEffect
$/ endif
        ) t
        JOIN
            $schema.metadata.qualifier$$schema.metadata.positorTableName$ positorTable
        ON
            positorTable.$schema.metadata.positorSuffix$ = t.$tie.positorColumnName$
$/ foreach role in tie.knotRoles
        LEFT JOIN
            $role.knot.qualifier$$role.knot.name$ "k$role.name$"
        ON
            "k$role.name$".$role.knot.identityColumnName$ = t.$role.columnName$
$/ endfor
$/ if tie.identifiers
        WHERE
            t.latestPosit = 1
$/ else
$/ foreach role in tie.anchorRoles
$/ if role.first()
        WHERE
$/ else
        AND
$/ endif
            t.latestPosit$role.columnName$ = 1
$/ endfor
$/ endif
    ]';
END p$tie.name$;
/
-- Latest perspective -------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $tie.qualifier$l$tie.name$
AS
SELECT
    *
FROM
    $tie.qualifier$p$tie.name$(CAST(TIMESTAMP '$schema.EOTValue$' AS $schema.metadata.chronon$))
;
-- Now perspective ----------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $tie.qualifier$n$tie.name$
AS
SELECT
    *
FROM
    $tie.qualifier$p$tie.name$(CAST($schema.metadata.now$ AS $schema.metadata.chronon$))
;
$/ if tie.isHistorized
-- Difference perspective ---------------------------------------------------------------------------------------------
-- Each change in the interval, with what the time-traveling perspective shows then as it is known now, for each
-- positor: the posit shown at each changing time is joined with the changing time until which it holds, when the next
-- changing time with an assertion that is not a retraction is.
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION $tie.qualifier$d$tie.name$ (
    intervalStart IN $schema.metadata.chrononType$,
    intervalEnd IN $schema.metadata.chrononType$
)
RETURN VARCHAR2 SQL_MACRO
IS
BEGIN
    RETURN q'[
$/ if not tie.identifiers
        SELECT
            q.$schema.metadata.positorSuffix$,
            q.inspectedTimepoint,
$/ if schema.METADATA
            q.$tie.metadataColumnName$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
            q.$role.knotChecksumColumnName$,
$/ endif
            q.$role.knotValueColumnName$,
$/ if schema.METADATA
            q.$role.knotMetadataColumnName$,
$/ endif
$/ endif
            q.$role.columnName$,
$/ endfor
            q.$tie.changingColumnName$,
            q.$tie.positingColumnName$,
            q.$tie.positorColumnName$,
            q.$tie.reliabilityColumnName$,
            q.$tie.assertionColumnName$
        FROM (
$/ endif
        SELECT
            positorTable.$schema.metadata.positorSuffix$,
            tp.inspectedTimepoint,
$/ if schema.METADATA
            t.$tie.metadataColumnName$,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
            "k$role.name$".$role.knot.checksumColumnName$ AS $role.knotChecksumColumnName$,
$/ endif
            "k$role.name$".$role.knot.valueColumnName$ AS $role.knotValueColumnName$,
$/ if schema.METADATA
            "k$role.name$".$role.knot.metadataColumnName$ AS $role.knotMetadataColumnName$,
$/ endif
$/ endif
            t.$role.columnName$,
$/ endfor
            t.$tie.changingColumnName$,
            t.$tie.positingColumnName$,
            t.$tie.positorColumnName$,
            t.$tie.reliabilityColumnName$,
            t.$tie.assertionColumnName$$/ if not tie.identifiers ,$/ endif
$/ if not tie.identifiers
$/ foreach role in tie.anchorRoles
            ROW_NUMBER() OVER (
                PARTITION BY tp.inspectedPositor, tp.inspectedTimepoint, t.$role.columnName$
                ORDER BY
                    t.$tie.changingColumnName$ DESC,
                    t.$tie.positingColumnName$ DESC,
                    t.$tie.reliabilityColumnName$ DESC,
                    t.$tie.identityColumnName$ DESC
            ) AS latestPosit$role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
        FROM
            $schema.metadata.qualifier$$schema.metadata.positorTableName$ positorTable
        JOIN (
            SELECT DISTINCT
                h.$tie.positorColumnName$ AS inspectedPositor,
                CAST(h.$tie.changingColumnName$ AS $schema.metadata.chronon$) AS inspectedTimepoint
            FROM
                $tie.qualifier$$tie.name$ h
            WHERE
                h.$tie.changingColumnName$ BETWEEN intervalStart AND intervalEnd
        ) tp
        ON
            tp.inspectedPositor = positorTable.$schema.metadata.positorSuffix$
        JOIN (
            SELECT
                y.*,
                LEAD(y.$tie.changingColumnName$) OVER (
                    PARTITION BY
                        y.$tie.positorColumnName$,
$/ if tie.identifiers
$/ foreach role in tie.identifiers
                        y.$role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
$/ else
$/ foreach role in tie.roles
                        y.$role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
$/ endif
                    ORDER BY y.$tie.changingColumnName$
                ) AS untilTime
            FROM (
                SELECT
                    z.*
                FROM (
                    SELECT
                        r.*,
                        ROW_NUMBER() OVER (
                            PARTITION BY
                                r.$tie.positorColumnName$,
$/ if tie.identifiers
$/ foreach role in tie.identifiers
                                r.$role.columnName$,
$/ endfor
$/ else
$/ foreach role in tie.roles
                                r.$role.columnName$,
$/ endfor
$/ endif
                                r.$tie.changingColumnName$
                            ORDER BY
                                CASE WHEN r.$tie.assertionColumnName$ = '+' THEN 0 ELSE 1 END,
                                r.$tie.positingColumnName$ DESC,
                                r.$tie.reliabilityColumnName$ DESC,
                                r.$tie.identityColumnName$ DESC
                        ) AS pickRank
                    FROM (
                        SELECT
$/ if schema.METADATA
                            an.$tie.metadataColumnName$,
$/ endif
                            po.$tie.identityColumnName$,
$/ foreach role in tie.roles
                            po.$role.columnName$,
$/ endfor
                            po.$tie.changingColumnName$,
                            an.$tie.positingColumnName$,
                            an.$tie.positorColumnName$,
                            an.$tie.reliabilityColumnName$,
                            an.$tie.assertionColumnName$,
                            ROW_NUMBER() OVER (
                                PARTITION BY po.$tie.identityColumnName$, an.$tie.positorColumnName$
                                ORDER BY an.$tie.positingColumnName$ DESC
                            ) AS rewindRank
                        FROM
                            $tie.qualifier$$tie.positName$ po
                        JOIN
                            $tie.qualifier$$tie.annexName$ an
                        ON
                            an.$tie.identityColumnName$ = po.$tie.identityColumnName$
                    ) r
                    WHERE
                        r.rewindRank = 1
                    AND
                        r.$tie.assertionColumnName$ <> '?'
                ) z
                WHERE
                    z.pickRank = 1
            ) y
        ) t
        ON
            t.$tie.positorColumnName$ = tp.inspectedPositor
        AND
            t.$tie.assertionColumnName$ = '+'
        AND
            t.$tie.changingColumnName$ <= CAST(tp.inspectedTimepoint AS $tie.timeRange$)
        AND (
            t.untilTime IS NULL
        OR
            t.untilTime > CAST(tp.inspectedTimepoint AS $tie.timeRange$)
        )
$/ foreach role in tie.knotRoles
        LEFT JOIN
            $role.knot.qualifier$$role.knot.name$ "k$role.name$"
        ON
            "k$role.name$".$role.knot.identityColumnName$ = t.$role.columnName$
$/ endfor
$/ if not tie.identifiers
        ) q
        WHERE
$/ foreach role in tie.anchorRoles
            q.latestPosit$role.columnName$ = 1
$/ if not role.last()
        AND
$/ endif
$/ endfor
$/ endif
    ]';
END d$tie.name$;
/
$/ endif
$/ endif
$/ endfor
