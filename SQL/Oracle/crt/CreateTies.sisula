-- TIES ---------------------------------------------------------------------------------------------------------------
--
-- CRT ties use posit and annex split with changing/positing time, positor, reliability, and assertion.
--
-- Every object is made inside a block that lets one that is already there be, so a script can be run again.
-- (ORA-00955: name is already used by an existing object)
--
$/ foreach tie in schema.ties
$/ if tie.isGenerator
BEGIN
    EXECUTE IMMEDIATE q'[CREATE SEQUENCE $tie.qualifier$$tie.identitySequenceName$ START WITH 1 INCREMENT BY 1]';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE <> -955 THEN RAISE; END IF;
END;
/
$/ endif
BEGIN
    EXECUTE IMMEDIATE q'[
        CREATE TABLE $tie.qualifier$$tie.positName$ (
            $tie.identityColumnName$ $/ if tie.isGenerator $tie.identity$ default $tie.qualifier$$tie.identitySequenceName$.nextval not null, $/ else $tie.identity$ not null,$/ endif
$/ foreach role in tie.roles
            $role.columnName$ $/ if role.entity $role.entity.identity$ not null, $/ else $role.knot.identity$ not null,$/ endif
$/ endfor
$/ if tie.isHistorized
            $tie.changingColumnName$ $tie.timeRange$ not null,
$/ endif
$/ foreach role in tie.roles
            constraint $tie.positName$_fk$role.name$ foreign key (
                $role.columnName$
$/ if role.entity
            ) references $role.entity.qualifier$$role.entity.name$($role.entity.identityColumnName$),
$/ else
            ) references $role.knot.qualifier$$role.knot.name$($role.knot.identityColumnName$),
$/ endif
$/ endfor
$/ if not tie.identifiers
$/ foreach role in tie.roles where role.isAnchorRole
$/ if tie.isHistorized
            constraint $tie.positName$_uq$role.name$ unique (
                $role.columnName$,
                $tie.changingColumnName$
            ),
$/ else
            constraint $tie.positName$_uq$role.name$ unique (
                $role.columnName$
            ),
$/ endif
$/ endfor
$/ endif
            constraint pk$tie.positName$ primary key (
                $tie.identityColumnName$
            ),
            constraint uq$tie.name$ unique (
$/ foreach role in tie.identifiers
                $role.columnName$$/ if not role.last() or tie.values or tie.isHistorized ,$/ endif
$/ endfor
$/ if tie.isHistorized
                $tie.changingColumnName$$/ if tie.values ,$/ endif
$/ endif
$/ foreach role in tie.values
                $role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
            )
        )
    ]';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE <> -955 THEN RAISE; END IF;
END;
/
BEGIN
    EXECUTE IMMEDIATE q'[
        CREATE TABLE $tie.qualifier$$tie.annexName$ (
            $tie.identityColumnName$ $tie.identity$ not null,
            $tie.positingColumnName$ $schema.metadata.positingRange$ not null,
            $tie.positorColumnName$ $schema.metadata.positorRange$ not null,
            $tie.reliabilityColumnName$ $schema.metadata.reliabilityRange$ not null,
            $tie.assertionColumnName$ char(1) generated always as (
                case
                    when $tie.reliabilityColumnName$ > $schema.metadata.deleteReliability$ then '+'
                    when $tie.reliabilityColumnName$ = $schema.metadata.deleteReliability$ then '?'
                    else '-'
                end
            ) virtual,
$/ if schema.METADATA
            $tie.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
            constraint fk$tie.annexName$ foreign key (
                $tie.identityColumnName$
            ) references $tie.qualifier$$tie.positName$($tie.identityColumnName$),
            constraint pk$tie.annexName$ primary key (
                $tie.identityColumnName$,
                $tie.positorColumnName$,
                $tie.positingColumnName$
            )
        )
    ]';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE <> -955 THEN RAISE; END IF;
END;
/
$/ endfor
