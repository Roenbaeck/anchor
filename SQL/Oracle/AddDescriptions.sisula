-- DESCRIPTIONS -------------------------------------------------------------------------------------------------------
--
-- Descriptions in the model are added as comments on the tables and the columns holding values and references, making
-- them available to catalogs and semantic layers. A comment in Oracle is replaced by running the statement again.
-- Oracle has no comment on a schema, so the description of the model itself is not added.
--
$- comment is describe(x), from derive.js: the description escaped for an Oracle string literal.
$/ foreach knot in schema.knots
$/ if knot.hasComment
COMMENT ON TABLE $knot.qualifier$$knot.name$ IS '$knot.comment$';
COMMENT ON COLUMN $knot.qualifier$$knot.name$.$knot.valueColumnName$ IS '$knot.comment$';
$/ endif
$/ endfor
$- The original shares this script with crt and bi, where values live in posit tables.
$/ foreach attribute in schema.attributes
$/ if attribute.hasComment
$/ if schema.UNI
COMMENT ON COLUMN $attribute.qualifier$$attribute.name$.$attribute.valueColumnName$ IS '$attribute.comment$';
$/ else
COMMENT ON COLUMN $attribute.qualifier$$attribute.positName$.$attribute.valueColumnName$ IS '$attribute.comment$';
$/ endif
$/ endif
$/ endfor
$/ foreach anchor in schema.anchors
$/ if anchor.hasComment
COMMENT ON TABLE $anchor.qualifier$$anchor.name$ IS '$anchor.comment$';
$/ endif
$/ endfor
$/ foreach nexus in schema.nexuses
$/ if nexus.hasComment
COMMENT ON TABLE $nexus.qualifier$$nexus.name$ IS '$nexus.comment$';
$/ endif
$/ foreach role in nexus.roles
$/ if role.hasComment
COMMENT ON COLUMN $nexus.qualifier$$nexus.name$.$role.columnName$ IS '$role.comment$';
$/ endif
$/ endfor
$/ endfor
$/ foreach tie in schema.ties
$/ if tie.hasComment
$/ if schema.UNI
COMMENT ON TABLE $tie.qualifier$$tie.name$ IS '$tie.comment$';
$/ else
COMMENT ON TABLE $tie.qualifier$$tie.positName$ IS '$tie.comment$';
$/ endif
$/ endif
$/ foreach role in tie.roles
$/ if role.hasComment
$/ if schema.UNI
COMMENT ON COLUMN $tie.qualifier$$tie.name$.$role.columnName$ IS '$role.comment$';
$/ else
COMMENT ON COLUMN $tie.qualifier$$tie.positName$.$role.columnName$ IS '$role.comment$';
$/ endif
$/ endif
$/ endfor
$/ endfor
