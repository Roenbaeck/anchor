-- KNOTS --------------------------------------------------------------------------------------------------------------
--
-- Knots are used to store finite sets of values, normally used to describe states
-- of entities (through knotted attributes) or relationships (through knotted ties).
-- Knots have their own surrogate identities and are therefore immutable.
-- Values can be added to the set over time though.
-- Knots should have values that are mutually exclusive and exhaustive.
--
-- Every object is made inside a block that lets one that is already there be, so a script can be run again.
-- (ORA-00955: name is already used by an existing object)
--
$/ foreach knot in schema.knots
-- Knot table ---------------------------------------------------------------------------------------------------------
-- $knot.name$ table
-----------------------------------------------------------------------------------------------------------------------
$/ if knot.isGenerator
BEGIN
    EXECUTE IMMEDIATE q'[CREATE SEQUENCE $knot.qualifier$$knot.identitySequenceName$ START WITH 1 INCREMENT BY 1]';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE <> -955 THEN RAISE; END IF;
END;
/
$/ endif
BEGIN
    EXECUTE IMMEDIATE q'[
        CREATE TABLE $knot.qualifier$$knot.name$ (
            $knot.identityColumnName$ $/ if knot.isGenerator $knot.identity$ default $knot.qualifier$$knot.identitySequenceName$.nextval not null, $/ else $knot.identity$ not null,$/ endif
            $knot.valueColumnName$ $knot.dataRange$ not null,
$/ if knot.hasChecksum
            $knot.checksumColumnName$ raw(16) generated always as (standard_hash($knot.valueColumnName$, 'MD5')) virtual,
$/ endif
$/ if schema.METADATA
            $knot.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
            constraint pk$knot.name$ primary key (
                $knot.identityColumnName$
            ),
            constraint uq$knot.name$ unique (
                $knot.uniqueColumnName$
            )
        )
    ]';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE <> -955 THEN RAISE; END IF;
END;
/
$/ endfor
