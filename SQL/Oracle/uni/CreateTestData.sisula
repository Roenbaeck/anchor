-- KNOT KNOT KNOT KNOT
-- KNOT KNOT KNOT KNOT
-- KNOT KNOT KNOT KNOT
-- KNOT KNOT KNOT KNOT
$/ foreach knot in schema.knots
prompt Populate KNOT l$knot.name$;
INSERT INTO $knot.name$ (
    $knot.identityColumnName$,
    $knot.valueColumnName$,
    $knot.metadataColumnName$
) VALUES (
    100, -- $knot.identityColumnName$, -- $knot.identity$ not null
    '$knot.testValue$', -- $knot.valueColumnName$, -- $knot.dataRange$ not null
    0 -- $knot.metadataColumnName$
);
$/ endfor


-- ANCHOR ANCHOR ANCHOR ANCHOR
-- ANCHOR ANCHOR ANCHOR ANCHOR
-- ANCHOR ANCHOR ANCHOR ANCHOR
-- ANCHOR ANCHOR ANCHOR ANCHOR
$/ foreach anchor in schema.anchors
prompt Populate ANCHOR l$anchor.name$;
declare
    l_now   date := sysdate;
    l_count integer := 0;
begin
    for i in $anchor.testFrom$ .. $anchor.testTo$ loop
        INSERT INTO l$anchor.name$ ( -- $anchor.testFrom$
            $anchor.identityColumnName$,
            $/ if schema.METADATA $anchor.metadataColumnName$ $/ else $anchor.dummyColumnName$ $/ endif$/ if anchor.attributes ,$/ endif
$/ if anchor.attributes
$/ foreach attribute in anchor.attributes
            $/ if schema.IMPROVED $attribute.entityReferenceName$,     -- ATTRIBUTE$/ endif
            $/ if schema.METADATA $attribute.metadataColumnName$,     -- ATTRIBUTE$/ endif
            $/ if attribute.timeRange $attribute.changingColumnName$,     -- ATTRIBUTE$/ endif
$/ if attribute.isKnotted
            $attribute.knotValueColumnName$,    -- KNOT
            $/ if schema.METADATA $attribute.knotMetadataColumnName$,    -- KNOT$/ endif
$/ endif
$/ if attribute.last()
            $attribute.valueColumnName$     -- ATTRIBUTE
$/ else
            $attribute.valueColumnName$,     -- ATTRIBUTE
$/ endif
$/ endfor
$/ endif
        ) VALUES ( -- $anchor.testFrom$
            i, -- $anchor.identityColumnName$
$/ if schema.METADATA
$/ if anchor.attributes
            0, -- $anchor.metadataColumnName$, : $anchor.dummyColumnName$,
$/ else
            0 -- $anchor.metadataColumnName$, : $anchor.dummyColumnName$,
$/ endif
$/ else
$/ if anchor.attributes
            , -- $anchor.metadataColumnName$, : $anchor.dummyColumnName$,
$/ else
            -- $anchor.metadataColumnName$, : $anchor.dummyColumnName$,
$/ endif
$/ endif
$/ if anchor.attributes
$/ foreach attribute in anchor.attributes
            $/ if schema.IMPROVED NULL, -- $attribute.entityReferenceName$,     -- ATTRIBUTE$/ endif
            $/ if schema.METADATA NULL, -- $attribute.metadataColumnName$,     -- ATTRIBUTE$/ endif
            $/ if attribute.timeRange l_now, -- $attribute.changingColumnName$,     -- ATTRIBUTE$/ endif
$/ if attribute.isKnotted
            '$attribute.knot.testValue$', -- $attribute.knotValueColumnName$    -- KNOT
            $/ if schema.METADATA NULL, -- $attribute.knotMetadataColumnName$    -- KNOT$/ endif
$/ endif
$/ if attribute.last()
$/ if attribute.testVarchar
            substr(l_count || '_$attribute.valueColumnName$',1,$attribute.testPrecision$ -- $attribute.valueColumnName$ $attribute.dataRange$ l_precision = $attribute.testPrecision$
$/ endif
$/ if attribute.testDate
            sysdate -- $attribute.valueColumnName$ $attribute.dataRange$ l_precision = $attribute.testPrecision$
$/ endif
$/ if attribute.testInteger
            l_count -- $attribute.valueColumnName$ $attribute.dataRange$ l_precision = $attribute.testPrecision$
$/ endif
$/ if attribute.testOther
            substr(l_count,1,$attribute.testPrecision$ -- $attribute.valueColumnName$ $attribute.dataRange$ l_precision = $attribute.testPrecision$
$/ endif
$/ if attribute.testNone
            l_count -- $attribute.valueColumnName$ $attribute.dataRange$ l_precision = $attribute.testPrecision$
$/ endif
$/ else
$/ if attribute.testVarchar
            substr(l_count || '_$attribute.valueColumnName$',1,$attribute.testPrecision$, -- $attribute.valueColumnName$ $attribute.dataRange$ l_precision = $attribute.testPrecision$
$/ endif
$/ if attribute.testDate
            sysdate, -- $attribute.valueColumnName$ $attribute.dataRange$ l_precision = $attribute.testPrecision$
$/ endif
$/ if attribute.testInteger
            l_count, -- $attribute.valueColumnName$ $attribute.dataRange$ l_precision = $attribute.testPrecision$
$/ endif
$/ if attribute.testOther
            substr(l_count,1,$attribute.testPrecision$, -- $attribute.valueColumnName$ $attribute.dataRange$ l_precision = $attribute.testPrecision$
$/ endif
$/ if attribute.testNone
            l_count, -- $attribute.valueColumnName$ $attribute.dataRange$ l_precision = $attribute.testPrecision$
$/ endif
$/ endif
$/ endfor
$/ endif
        );
        l_count := l_count + 1;
    end loop;
end;
/
$/ endfor

-- TIE TIE TIE TIE
-- TIE TIE TIE TIE
-- TIE TIE TIE TIE
-- TIE TIE TIE TIE
$/ foreach tie in schema.ties
prompt Populate TIE l$tie.name$;
$/ if tie.isHistorized and tie.isKnotted
-- Knotted historized tie table ---------------------------------------------------------------------------------------
$/ endif
$/ if tie.isHistorized and not tie.isKnotted
-- Historized tie table -----------------------------------------------------------------------------------------------
$/ endif
$/ if not tie.isHistorized and tie.isKnotted
-- Knotted static tie table -------------------------------------------------------------------------------------------
$/ endif
$/ if not tie.isHistorized and not tie.isKnotted
-- Static tie table ---------------------------------------------------------------------------------------------------
$/ endif
    insert into l$tie.name$ (
        $/ if schema.METADATA $tie.metadataColumn30$,$/ endif
        $/ if tie.timeRange $tie.changingColumn30$,$/ endif
$/ foreach role in tie.roles
$/ if role.knot
        $role.knotValueColumnName$,  -- KNOT
        $/ if schema.METADATA $role.knotMetadataColumnName$,  -- KNOT$/ endif
$/ endif
        $role.columnName$$/ if not role.last() ,$/ endif
$/ endfor
    ) SELECT
        $/ if schema.METADATA '0' AS $tie.metadataColumn30$$/ endif$/ if tie.roles ,$/ endif
        $/ if tie.timeRange NULL AS $tie.changingColumn30$,$/ endif
$/ foreach role in tie.roles
$/ if role.knot
        $role.columnName$.$role.knot.name$ AS $role.knotValueColumnName$,  -- KNOT
        $/ if schema.METADATA '0' AS $role.knotMetadataColumnName$,  -- KNOT$/ endif
$/ endif
    $/ if role.entity $role.columnName$.$role.entity.identityColumnName$$/ else $role.columnName$.$role.knot.identityColumnName$ AS $role.columnName$$/ endif$/ if not role.last() ,$/ endif
$/ endfor

    FROM
$/ foreach role in tie.roles
    $/ if role.entity $role.entity.name$ $role.columnName$$/ else $role.knot.name$ $role.columnName$$/ endif$/ if not role.last() ,$/ endif
$/ endfor
$/ foreach role in tie.roles
$/ if role.first()

    WHERE 1=1
$/ endif
$/ if not role.first()
$/ if not role.knot

    AND substr($role.testPrevious$,4) = substr($role.testIdentity$,4)
$/ endif
$/ endif
$/ endfor
    ;
$/ endfor
COMMIT;
