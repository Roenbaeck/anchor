-- ANCHOR TRIGGERS ---------------------------------------------------------------------------------------------------
--
-- The following triggers on the latest view make it behave like a table.
-- There are three different 'instead of' triggers: insert, update, and delete.
-- They will ensure that such operations are propagated to the underlying tables
-- in a consistent way. Default values are used for some columns if not provided
-- by the corresponding SQL statements.
--
-- For idempotent attributes, only changes that represent a value different from
-- the previous or following value are stored. Others are silently ignored in
-- order to avoid unnecessary temporal duplicates.
--
$/ foreach anchor in schema.anchors
$/ if anchor.attributes
CREATE OR REPLACE TRIGGER it$anchor.name$
-- Insert trigger -----------------------------------------------------------------------------------------------------
-- it$anchor.name$ instead of INSERT trigger on l$anchor.name$
-----------------------------------------------------------------------------------------------------------------------
INSTEAD OF INSERT
ON l$anchor.name$
FOR EACH ROW
DECLARE
    x INTEGER;
    l_now   date := sysdate;
BEGIN

    INSERT INTO $anchor.name$ (
        $anchor.identityColumnName$,
        $/ if schema.METADATA $anchor.metadataColumnName$ $/ else $anchor.dummyColumnName$ $/ endif
    ) VALUES (
        :NEW.$anchor.identityColumnName$,
        :NEW.$/ if schema.METADATA $anchor.metadataColumnName$ $/ else $anchor.dummyColumnName$ $/ endif
    );

$/ foreach attribute in anchor.attributes
$/ if attribute.isKnotted
    if (:NEW.$attribute.knotValueColumnName$ is not null) then -- insert
$/ else
    if (:NEW.$attribute.valueColumnName$ is not null) then -- insert
$/ endif
        INSERT INTO $attribute.name$ (
            $/ if schema.IMPROVED $attribute.entityReferenceName$, -- $anchor.identity$ null,$/ endif
            $/ if attribute.timeRange $attribute.changingColumnName$, -- $attribute.timeRange$ null,$/ endif
$/ if attribute.isKnotted
            -- $attribute.knotValueColumnName$, -- $attribute.knot.dataRange$ null,   KNOT
            -- $/ if schema.METADATA $attribute.knotMetadataColumnName$, -- $schema.metadata.metadataType$ null,   KNOT$/ endif
            $attribute.valueColumnName$, --  $attribute.knot.identity$ null$/ if not attribute.last() ,   KNOT$/ endif
$/ else
            $attribute.valueColumnName$, --  $attribute.dataRange$ null$/ if not attribute.last() ,   ELSE$/ endif
$/ endif
            $/ if schema.METADATA $attribute.metadataColumnName$ -- $schema.metadata.metadataType$ null,$/ endif
        ) VALUES (
            $/ if schema.IMPROVED :NEW.$anchor.identityColumnName$, -- $anchor.identity$ null,$/ endif
            $/ if attribute.timeRange nvl(:NEW.$attribute.changingColumnName$, l_now), -- $attribute.timeRange$ null,$/ endif
$/ if attribute.isKnotted
            -- :NEW.$attribute.knotValueColumnName$, -- $attribute.knot.dataRange$ null,   KNOT
            -- $/ if schema.METADATA nvl(:NEW.$attribute.knotMetadataColumnName$, :NEW.$anchor.metadataColumnName$), -- null,   KNOT$/ endif
            (select knot.$attribute.knot.identityColumnName$ from $attribute.knot.name$ knot where knot.$attribute.knot.valueColumnName$ = :NEW.$attribute.knotValueColumnName$), -- $attribute.knot.identity$ null$/ if not attribute.last() ,    -- KNOT insert om $attribute.knotValueColumnName$ på väg in i vyn finns i $attribute.knot.name$$/ endif
$/ else
            :NEW.$attribute.valueColumnName$, --  $attribute.dataRange$ null$/ if not attribute.last() ,   ELSE$/ endif
$/ endif
            $/ if schema.METADATA nvl(:NEW.$attribute.metadataColumnName$, :NEW.$anchor.metadataColumnName$) -- null,$/ endif
        );
    end if;
$/ endfor
END it$anchor.name$;
/
$/ endif
$/ if anchor.historizedAttributeCount
CREATE OR REPLACE TRIGGER ut$anchor.name$
-- UPDATE trigger -----------------------------------------------------------------------------------------------------
-- ut$anchor.name$ instead of UPDATE trigger on l$anchor.name$
-----------------------------------------------------------------------------------------------------------------------
INSTEAD OF UPDATE
ON l$anchor.name$
FOR EACH ROW
DECLARE
    x INTEGER;
    l_now date := sysdate;
    l_changedate date := sysdate;
    l_metadata  integer;
    -- är kolumnen förändrad, OBS tar hänsyn till NULL
    function is_changed ( in_new varchar2, in_old varchar2) return boolean is
    begin
        -- Denna if är något bakvänt skriven för att ta hand om fallen där NEW eller OLD är NULL.
        -- Svaret på detta är varken true eller false vilket gör att även dessa hamnar i else
        if (in_old = in_new) OR (in_old is null and in_new is null) then
            -- FALSE
            return false;
        else
            -- TRUE
            return true;
        end if;
    end is_changed;
    -- ger changedate, OBS tar hänsyn till NULL
    function get_changedate ( in_new date, in_old date) return date is
    begin
        -- Denna if är något bakvänt skriven för att ta hand om fallen där NEW eller OLD är NULL.
        -- Svaret på detta är varken true eller false vilket gör att även dessa hamnar i else
        if (in_old = in_new) OR (in_old is null and in_new is null) OR (in_new is null) then
            -- FALSE
            return l_now;
        else
            -- TRUE
            return in_new;
        end if;
    end get_changedate;
    -- ger metadata, OBS tar hänsyn till NULL
    function get_metadata ( in_new integer, in_old integer) return integer is
    begin
        -- Denna if är något bakvänt skriven för att ta hand om fallen där NEW eller OLD är NULL.
        -- Svaret på detta är varken true eller false vilket gör att även dessa hamnar i else
        if (in_old = in_new) OR (in_old is null and in_new is null) then
            -- FALSE
            return 0;
        else
            -- TRUE
            return in_new;
        end if;
    end get_metadata;
BEGIN
$/ foreach attribute in anchor.attributes
$/ if attribute.isKnotted
    if is_changed(:NEW.$attribute.knotValueColumnName$, :OLD.$attribute.knotValueColumnName$) then -- insert
$/ else
    if is_changed(:NEW.$attribute.valueColumnName$, :OLD.$attribute.valueColumnName$) then -- insert
$/ endif
        $/ if attribute.timeRange l_changedate := get_changedate(:NEW.$attribute.changingColumnName$, :OLD.$attribute.changingColumnName$);$/ endif
        $/ if schema.METADATA l_metadata := get_metadata(:NEW.$attribute.metadataColumnName$, :OLD.$attribute.metadataColumnName$);$/ endif
        INSERT INTO $attribute.name$ (
            $/ if schema.IMPROVED $attribute.entityReferenceName$, -- $anchor.identity$ null,$/ endif
            $/ if attribute.timeRange $attribute.changingColumnName$, -- $attribute.timeRange$ null,$/ endif
$/ if attribute.isKnotted
            -- $attribute.knotValueColumnName$, -- $attribute.knot.dataRange$ null,   KNOT
            -- $/ if schema.METADATA $attribute.knotMetadataColumnName$, -- $schema.metadata.metadataType$ null,   KNOT$/ endif
            $attribute.valueColumnName$, --  $attribute.knot.identity$ null$/ if not attribute.last() ,   KNOT$/ endif
$/ else
            $attribute.valueColumnName$, --  $attribute.dataRange$ null$/ if not attribute.last() ,   ELSE$/ endif
$/ endif
            $/ if schema.METADATA $attribute.metadataColumnName$ -- $schema.metadata.metadataType$ null,$/ endif
        ) VALUES (
            $/ if schema.IMPROVED :NEW.$anchor.identityColumnName$, -- $anchor.identity$ null,$/ endif
            $/ if attribute.timeRange l_changedate,$/ endif
$/ if attribute.isKnotted
            -- :NEW.$attribute.knotValueColumnName$, -- $attribute.knot.dataRange$ null,   KNOT
            -- $/ if schema.METADATA nvl(:NEW.$attribute.knotMetadataColumnName$, :NEW.$anchor.metadataColumnName$), -- null,   KNOT$/ endif
            (select knot.$attribute.knot.identityColumnName$ from $attribute.knot.name$ knot where knot.$attribute.knot.valueColumnName$ = :NEW.$attribute.knotValueColumnName$), -- $attribute.knot.identity$ null$/ if not attribute.last() ,    -- KNOT insert om $attribute.knotValueColumnName$ på väg in i vyn finns i $attribute.knot.name$$/ endif
$/ else
            :NEW.$attribute.valueColumnName$, --  $attribute.dataRange$ null$/ if not attribute.last() ,   ELSE$/ endif
$/ endif
            $/ if schema.METADATA l_metadata -- $schema.metadata.metadataType$ null,$/ endif
        );
    end if;
$/ endfor
END ut$anchor.name$;
/
CREATE OR REPLACE TRIGGER dt$anchor.name$
-- DELETE trigger -----------------------------------------------------------------------------------------------------
-- dt$anchor.name$ instead of DELETE trigger on l$anchor.name$
-----------------------------------------------------------------------------------------------------------------------
INSTEAD OF DELETE
ON l$anchor.name$
FOR EACH ROW
DECLARE    l_now date := sysdate;
BEGIN
$/ foreach attribute in anchor.attributes
$/ if attribute.timeRange
    -- ta bort attribut för givet ankare och tid
$/ else
    -- ta bort attribut för givet ankare
$/ endif
    delete $attribute.name$ where 1=1
$/ if schema.IMPROVED
    and $attribute.entityReferenceName$ = :OLD.$anchor.identityColumnName$
$/ endif
$/ if attribute.timeRange
    and $attribute.changingColumnName$ = :OLD.$attribute.changingColumnName$
$/ endif
    ;
$/ endfor
    -- ta bort ankare om det inte längre har några attribut
    delete $anchor.name$ where $anchor.identityColumnName$ = $/ if schema.IMPROVED :OLD.$anchor.identityColumnName$$/ endif
$/ foreach attribute in anchor.attributes

    and 0 = (select count(*) from $attribute.name$ where $/ if schema.IMPROVED $attribute.entityReferenceName$ = :OLD.$anchor.identityColumnName$)$/ endif
$/ endfor
    ;
END dt$anchor.name$;
/
$/ endif
$/ endfor
