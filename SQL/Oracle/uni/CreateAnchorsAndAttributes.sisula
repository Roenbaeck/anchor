-- ANCHORS AND ATTRIBUTES ---------------------------------------------------------------------------------------------
--
-- Anchors are used to store the identities of entities.
-- Anchors are immutable.
-- Attributes are used to store values for properties of entities.
-- Attributes are mutable, their values may change over one or more types of time.
-- Attributes have four flavors: static, historized, knotted static, and knotted historized.
-- Anchors may have zero or more adjoined attributes.
--
$/ foreach anchor in schema.anchors
-- Anchor table -------------------------------------------------------------------------------------------------------
-- $anchor.name$ table (with $anchor.attributeCount$ attributes)
-----------------------------------------------------------------------------------------------------------------------
BEGIN
    EXECUTE IMMEDIATE '
        CREATE TABLE $anchor.capsule$.$anchor.name$ (
            $anchor.identityColumnName$ $/ if anchor.isGenerator $anchor.identity$ GENERATED BY DEFAULT ON NULL AS IDENTITY not null, $/ else $anchor.identity$ not null,$/ endif
            $/ if schema.METADATA $anchor.metadataColumnName$ $schema.metadata.metadataType$ not null, $/ else $anchor.dummyColumnName$ number(1) null,$/ endif
            constraint $anchor.pkName$ primary key (
                $anchor.identityColumnName$
            )
        )';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE = -955 THEN NULL; ELSE RAISE; END IF;
END;
/
$/ if anchor.attributes
$/ foreach attribute in anchor.attributes
$/ if attribute.isHistorized and not attribute.isKnotted
-- Historized attribute table -----------------------------------------------------------------------------------------
-- $attribute.name$ table (on $anchor.name$)
-----------------------------------------------------------------------------------------------------------------------
BEGIN
    EXECUTE IMMEDIATE '
        CREATE TABLE $attribute.capsule$.$attribute.name$ (
            $attribute.entityReferenceName$ $anchor.identity$ not null,
            $attribute.valueColumnName$ $attribute.dataRange$ not null,
            $attribute.changingColumnName$ $attribute.timeRange$ not null,
$/ if schema.METADATA
            $attribute.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
            constraint $attribute.fkName$ foreign key (
                $attribute.entityReferenceName$
            ) references $anchor.capsule$.$anchor.name$($anchor.identityColumnName$),
            constraint $attribute.pkName$ primary key (
                $attribute.entityReferenceName$,
                $attribute.changingColumnName$
            )
        )';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE = -955 THEN NULL; ELSE RAISE; END IF;
END;
/
$/ endif
$/ if attribute.isHistorized and attribute.isKnotted
-- Knotted historized attribute table ---------------------------------------------------------------------------------
-- $attribute.name$ table (on $anchor.name$)
-----------------------------------------------------------------------------------------------------------------------
BEGIN
    EXECUTE IMMEDIATE '
        CREATE TABLE $attribute.capsule$.$attribute.name$ (
            $attribute.entityReferenceName$ $anchor.identity$ not null,
            $attribute.knotReferenceName$ $attribute.knot.identity$ not null,
            $attribute.changingColumnName$ $attribute.timeRange$ not null,
$/ if schema.METADATA
            $attribute.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
            constraint $attribute.fk1Name$ foreign key (
                $attribute.entityReferenceName$
            ) references $anchor.capsule$.$anchor.name$($anchor.identityColumnName$),
            constraint $attribute.fk2Name$ foreign key (
                $attribute.knotReferenceName$
            ) references $attribute.knot.capsule$.$attribute.knot.name$($attribute.knot.identityColumnName$),
            constraint $attribute.pkName$ primary key (
                $attribute.entityReferenceName$,
                $attribute.changingColumnName$
            )
        )';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE = -955 THEN NULL; ELSE RAISE; END IF;
END;
/
$/ endif
$/ if not attribute.isHistorized and attribute.isKnotted
-- Knotted static attribute table -------------------------------------------------------------------------------------
-- $attribute.name$ table (on $anchor.name$)
-----------------------------------------------------------------------------------------------------------------------
BEGIN
    EXECUTE IMMEDIATE '
        CREATE TABLE $attribute.capsule$.$attribute.name$ (
            $attribute.entityReferenceName$ $anchor.identity$ not null,
            $attribute.knotReferenceName$ $attribute.knot.identity$ not null,
$/ if schema.METADATA
            $attribute.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
            constraint $attribute.fk1Name$ foreign key (
                $attribute.entityReferenceName$
            ) references $anchor.capsule$.$anchor.name$($anchor.identityColumnName$),
            constraint $attribute.fk2Name$ foreign key (
                $attribute.knotReferenceName$
            ) references $attribute.knot.capsule$.$attribute.knot.name$($attribute.knot.identityColumnName$),
            constraint $attribute.pkName$ primary key (
                $attribute.entityReferenceName$
            )
        )';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE = -955 THEN NULL; ELSE RAISE; END IF;
END;
/
$/ endif
$/ if not attribute.isHistorized and not attribute.isKnotted
-- Static attribute table ---------------------------------------------------------------------------------------------
-- $attribute.name$ table (on $anchor.name$)
-----------------------------------------------------------------------------------------------------------------------
BEGIN
    EXECUTE IMMEDIATE '
        CREATE TABLE $attribute.capsule$.$attribute.name$ (
            $attribute.entityReferenceName$ $anchor.identity$ not null,
            $attribute.valueColumnName$ $attribute.dataRange$ not null,
$/ if schema.METADATA
            $attribute.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
            constraint $attribute.fkName$ foreign key (
                $attribute.entityReferenceName$
            ) references $anchor.capsule$.$anchor.name$($anchor.identityColumnName$),
            constraint $attribute.pkName$ primary key (
                $attribute.entityReferenceName$
            )
        )';
EXCEPTION WHEN OTHERS THEN
    IF SQLCODE = -955 THEN NULL; ELSE RAISE; END IF;
END;
/
$/ endif
$/ endfor
$/ endif
$/ endfor
