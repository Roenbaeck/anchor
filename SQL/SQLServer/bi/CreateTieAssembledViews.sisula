-- TIE ASSEMBLED VIEWS ------------------------------------------------------------------------------------------------
--
-- The assembled view of a tie combines the posit and annex table of the tie.
-- It can be used to maintain entity integrity through a primary key, which cannot be
-- defined elsewhere.
--
$/ foreach tie in schema.ties
-- Tie assembled view -------------------------------------------------------------------------------------------------
-- $tie.name$ assembled view of the posit and annex tables,
-- pk$tie.name$ optional temporal consistency constraint
-----------------------------------------------------------------------------------------------------------------------
IF Object_ID('$tie.capsule$.$tie.name$', 'V') IS NULL
BEGIN
    EXEC('
    CREATE VIEW [$tie.capsule$].[$tie.name$]
    WITH SCHEMABINDING AS
    SELECT
$/ if schema.METADATA
        a.$tie.metadataColumnName$,
$/ endif
        p.$tie.identityColumnName$,
$/ foreach role in tie.roles
        p.$role.columnName$,
$/ endfor
$/ if tie.timeRange
        p.$tie.changingColumnName$,
$/ endif
        a.$tie.positingColumnName$,
        a.$tie.reliabilityColumnName$
    FROM
        [$tie.capsule$].[$tie.positName$] p
    JOIN
        [$tie.capsule$].[$tie.annexName$] a
    ON
        a.$tie.identityColumnName$ = p.$tie.identityColumnName$;
    ');
$/ if tie.identifiers and tie.values
    -- Constraint ensuring that recorded and erased posits are temporally consistent: one posit at a time is asserted,
    -- and a correction retracts what it corrects at the same positing time
$/ else
    -- Constraint ensuring that recorded and erased posits are temporally consistent
$/ endif
    EXEC('
    CREATE UNIQUE CLUSTERED INDEX [pk$tie.name$]
    ON [$tie.capsule$].[$tie.name$] (
$/ if tie.identifiers
$/ foreach role in tie.identifiers
        $role.columnName$ asc,
$/ endfor
$/ else
$/ foreach role in tie.roles
        $role.columnName$ asc,
$/ endfor
$/ endif
$/ if tie.timeRange
        $tie.changingColumnName$ desc,
$/ endif
$/ if tie.identifiers and tie.values
        $tie.positingColumnName$ desc,
        $tie.reliabilityColumnName$ desc
$/ else
        $tie.positingColumnName$ desc
$/ endif
    );
    ');
END
GO
$/ if tie.identifiers and tie.values
-- the constraint of an assembled view made before corrections retracted what they correct has no reliability
IF EXISTS (
    SELECT TOP 1
        42
    FROM
        sys.indexes x
    WHERE
        x.object_id = Object_ID('$tie.capsule$.$tie.name$', 'V')
    AND
        x.name = 'pk$tie.name$'
    AND NOT EXISTS (
        SELECT TOP 1
            42
        FROM
            sys.index_columns c
        JOIN
            sys.columns k
        ON
            k.object_id = c.object_id
        AND
            k.column_id = c.column_id
        WHERE
            c.object_id = x.object_id
        AND
            c.index_id = x.index_id
        AND
            k.name = '$tie.reliabilityColumnName$'
    )
)
BEGIN
    EXEC('
    CREATE UNIQUE CLUSTERED INDEX [pk$tie.name$]
    ON [$tie.capsule$].[$tie.name$] (
$/ foreach role in tie.identifiers
        $role.columnName$ asc,
$/ endfor
$/ if tie.timeRange
        $tie.changingColumnName$ desc,
$/ endif
        $tie.positingColumnName$ desc,
        $tie.reliabilityColumnName$ desc
    )
    WITH (DROP_EXISTING = ON);
    ');
END
GO
$/ endif
$/ endfor
