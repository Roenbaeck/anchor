-- ATTRIBUTE ASSEMBLED VIEWS ------------------------------------------------------------------------------------------
--
-- The assembled view of an attribute combines the posit and annex table of the attribute.
-- It can be used to maintain entity integrity through a primary key, which cannot be
-- defined elsewhere.
--
$/ foreach attribute in schema.attributes
-- Attribute assembled view -------------------------------------------------------------------------------------------
-- $attribute.name$ assembled view of the posit and annex tables,
-- pk$attribute.name$ optional temporal consistency constraint
-----------------------------------------------------------------------------------------------------------------------
IF Object_ID('$attribute.capsule$.$attribute.name$', 'V') IS NULL
BEGIN
    EXEC('
    CREATE VIEW [$attribute.capsule$].[$attribute.name$]
    WITH SCHEMABINDING AS
    SELECT
$/ if schema.METADATA
        a.$attribute.metadataColumnName$,
$/ endif
        p.$attribute.identityColumnName$,
        p.$attribute.entityReferenceName$,
$/ if attribute.hasChecksum
        p.$attribute.checksumColumnName$,
$/ endif
        p.$attribute.valueColumnName$,
$/ if attribute.timeRange
        p.$attribute.changingColumnName$,
$/ endif
        a.$attribute.positingColumnName$,
        a.$attribute.reliabilityColumnName$
    FROM
        [$attribute.capsule$].[$attribute.positName$] p
    JOIN
        [$attribute.capsule$].[$attribute.annexName$] a
    ON
        a.$attribute.identityColumnName$ = p.$attribute.identityColumnName$;
    ');
    -- Constraint ensuring that recorded and erased posits are temporally consistent: one posit at a time is asserted,
    -- and a correction retracts what it corrects at the same positing time
    EXEC('
    CREATE UNIQUE CLUSTERED INDEX [pk$attribute.name$]
    ON [$attribute.capsule$].[$attribute.name$] (
        $attribute.entityReferenceName$ asc,
$/ if attribute.timeRange
        $attribute.changingColumnName$ desc,
$/ endif
        $attribute.positingColumnName$ desc,
        $attribute.reliabilityColumnName$ desc
    );
    ');
END
GO
-- the constraint of an assembled view made before corrections retracted what they correct has no reliability
IF EXISTS (
    SELECT TOP 1
        42
    FROM
        sys.indexes x
    WHERE
        x.object_id = Object_ID('$attribute.capsule$.$attribute.name$', 'V')
    AND
        x.name = 'pk$attribute.name$'
    AND NOT EXISTS (
        SELECT TOP 1
            42
        FROM
            sys.index_columns c
        JOIN
            sys.columns k
        ON
            k.object_id = c.object_id
        AND
            k.column_id = c.column_id
        WHERE
            c.object_id = x.object_id
        AND
            c.index_id = x.index_id
        AND
            k.name = '$attribute.reliabilityColumnName$'
    )
)
BEGIN
    EXEC('
    CREATE UNIQUE CLUSTERED INDEX [pk$attribute.name$]
    ON [$attribute.capsule$].[$attribute.name$] (
        $attribute.entityReferenceName$ asc,
$/ if attribute.timeRange
        $attribute.changingColumnName$ desc,
$/ endif
        $attribute.positingColumnName$ desc,
        $attribute.reliabilityColumnName$ desc
    )
    WITH (DROP_EXISTING = ON);
    ');
END
GO
$/ endfor
