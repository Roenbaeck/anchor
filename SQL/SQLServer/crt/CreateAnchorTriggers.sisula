$/ if schema.TRIGGERS
-- ANCHOR TRIGGERS ---------------------------------------------------------------------------------------------------
--
-- The following triggers on the latest view make it behave like a table.
-- There are three different 'instead of' triggers: insert, update, and delete.
-- They will ensure that such operations are propagated to the underlying tables
-- in a consistent way. Default values are used for some columns if not provided
-- by the corresponding SQL statements.
--
-- For idempotent attributes, only changes that represent a value different from
-- the previous or following value are stored. Others are silently ignored in
-- order to avoid unnecessary temporal duplicates.
--
$/ foreach anchor in schema.anchors
$/ if anchor.attributes
-- Insert trigger -----------------------------------------------------------------------------------------------------
-- it_l$anchor.name$ instead of INSERT trigger on l$anchor.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$anchor.capsule$].[it_l$anchor.name$] ON [$anchor.capsule$].[l$anchor.name$]
INSTEAD OF INSERT
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @now $schema.metadata.chronon$;
    SET @now = $schema.metadata.now$;
    DECLARE @$anchor.mnemonic$ TABLE (
        Row bigint IDENTITY(1,1) not null primary key,
        $anchor.identityColumnName$ $anchor.identity$ not null
    );
    INSERT INTO [$anchor.capsule$].[$anchor.name$] (
$/ if schema.METADATA
        $anchor.metadataColumnName$
$/ else
        $anchor.dummyColumnName$
$/ endif
    )
    OUTPUT
        inserted.$anchor.identityColumnName$
    INTO
        @$anchor.mnemonic$
    SELECT
$/ if schema.METADATA
        $anchor.metadataColumnName$
$/ else
        null
$/ endif
    FROM
        inserted
    WHERE
        inserted.$anchor.identityColumnName$ is null;
    DECLARE @inserted TABLE (
        $anchor.identityColumnName$ $anchor.identity$ not null,
$/ if schema.METADATA
        $anchor.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
        $attribute.entityReferenceName$ $anchor.identity$ null,
$/ endif
$/ if schema.METADATA
        $attribute.metadataColumnName$ $schema.metadata.metadataType$ null,
$/ endif
$/ if attribute.isHistorized
        $attribute.changingColumnName$ $attribute.timeRange$ null,
$/ endif
        $attribute.positorColumnName$ $schema.metadata.positorRange$ null,
        $attribute.positingColumnName$ $schema.metadata.positingRange$ null,
        $attribute.reliabilityColumnName$ $schema.metadata.reliabilityRange$ null,
$/ if attribute.isKnotted
        $attribute.knotValueColumnName$ $attribute.knot.dataRange$ null,
$/ if attribute.knot.hasChecksum
        $attribute.knotChecksumColumnName$ varbinary(16) null,
$/ endif
$/ if schema.METADATA
        $attribute.knotMetadataColumnName$ $schema.metadata.metadataType$ null,
$/ endif
        $attribute.valueColumnName$ $attribute.knot.identity$ null$/ if not attribute.last() ,$/ endif
$/ else
        $attribute.valueColumnName$ $attribute.dataRange$ null$/ if not attribute.last() ,$/ endif
$/ endif
$/ endfor
    );
    INSERT INTO @inserted
    SELECT
        ISNULL(i.$anchor.identityColumnName$, a.$anchor.identityColumnName$),
$/ if schema.METADATA
        i.$anchor.metadataColumnName$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
        ISNULL(ISNULL(i.$attribute.entityReferenceName$, i.$anchor.identityColumnName$), a.$anchor.identityColumnName$),
$/ endif
$/ if schema.METADATA
        ISNULL(i.$attribute.metadataColumnName$, i.$anchor.metadataColumnName$),
$/ endif
$/ if attribute.isHistorized
        ISNULL(i.$attribute.changingColumnName$, @now),
$/ endif
        ISNULL(ISNULL(i.$attribute.positorColumnName$, i.$schema.metadata.positorSuffix$), 0),
        ISNULL(i.$attribute.positingColumnName$, @now),
        ISNULL(ISNULL(i.$attribute.reliabilityColumnName$, i.$schema.metadata.reliabilitySuffix$), $schema.metadata.defaultReliability$),
$/ if attribute.isKnotted
        i.$attribute.knotValueColumnName$,
$/ if attribute.knot.hasChecksum
        ISNULL(i.$attribute.knotChecksumColumnName$, $schema.metadata.encapsulation$.MD5(cast(i.$attribute.knotValueColumnName$ as varbinary(max)))),
$/ endif
$/ if schema.METADATA
        ISNULL(i.$attribute.knotMetadataColumnName$, i.$anchor.metadataColumnName$),
$/ endif
$/ endif
        i.$attribute.valueColumnName$$/ if not attribute.last() ,$/ endif
$/ endfor
    FROM (
        SELECT
            $schema.metadata.positorSuffix$,
            $schema.metadata.reliabilitySuffix$,
            $anchor.identityColumnName$,
$/ if schema.METADATA
            $anchor.metadataColumnName$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
            $attribute.entityReferenceName$,
$/ endif
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positorColumnName$,
            $attribute.positingColumnName$,
            $attribute.reliabilityColumnName$,
$/ if attribute.isKnotted
            $attribute.knotValueColumnName$,
$/ if attribute.knot.hasChecksum
            $attribute.knotChecksumColumnName$,
$/ endif
$/ if schema.METADATA
            $attribute.knotMetadataColumnName$,
$/ endif
$/ endif
            $attribute.valueColumnName$,
$/ endfor
            ROW_NUMBER() OVER (PARTITION BY $anchor.identityColumnName$ ORDER BY $anchor.identityColumnName$) AS Row
        FROM
            inserted
    ) i
    LEFT JOIN
        @$anchor.mnemonic$ a
    ON
        a.Row = i.Row;
$/ foreach attribute in anchor.attributes
    INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
        $attribute.metadataColumnName$,
$/ endif
        $attribute.entityReferenceName$,
        $attribute.valueColumnName$,
$/ if attribute.timeRange
        $attribute.changingColumnName$,
$/ endif
        $attribute.positingColumnName$,
        $attribute.positorColumnName$,
        $attribute.reliabilityColumnName$
    )
    SELECT
$/ if schema.METADATA
        i.$attribute.metadataColumnName$,
$/ endif
        i.$attribute.entityReferenceName$,
$/ if attribute.isKnotted
        ISNULL(i.$attribute.valueColumnName$, [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$),
$/ else
        i.$attribute.valueColumnName$,
$/ endif
$/ if attribute.timeRange
        i.$attribute.changingColumnName$,
$/ endif
        i.$attribute.positingColumnName$,
        i.$attribute.positorColumnName$,
        i.$attribute.reliabilityColumnName$
    FROM
        @inserted i
$/ if attribute.isKnotted
    LEFT JOIN
        [$attribute.knot.capsule$].[$attribute.knot.name$] [k$attribute.knot.mnemonic$]
    ON
$/ if attribute.knot.hasChecksum
        [k$attribute.knot.mnemonic$].$attribute.knot.checksumColumnName$ = i.$attribute.knotChecksumColumnName$
$/ else
        [k$attribute.knot.mnemonic$].$attribute.knot.valueColumnName$ = i.$attribute.knotValueColumnName$
$/ endif
    WHERE
        ISNULL(i.$attribute.valueColumnName$, [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$) is not null;
$/ else
    WHERE
        i.$attribute.valueColumnName$ is not null;
$/ endif
$/ endfor
END
GO
$/ endif
$/ if anchor.attributes
-- UPDATE trigger -----------------------------------------------------------------------------------------------------
-- ut_l$anchor.name$ instead of UPDATE trigger on l$anchor.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$anchor.capsule$].[ut_l$anchor.name$] ON [$anchor.capsule$].[l$anchor.name$]
INSTEAD OF UPDATE
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @now $schema.metadata.chronon$;
    SET @now = $schema.metadata.now$;
    -- whether a column is set is asked once, here: with UPDATE() in the statements below, which read inserted and
    -- deleted, SQL Server 2014 used gigabytes of memory to create a trigger like this one, and could run out
$/ if schema.METADATA
    DECLARE @updated_$anchor.metadataColumnName$ bit = CASE WHEN UPDATE($anchor.metadataColumnName$) THEN 1 ELSE 0 END;
$/ endif
    DECLARE @updated_$schema.metadata.reliabilitySuffix$ bit = CASE WHEN UPDATE($schema.metadata.reliabilitySuffix$) THEN 1 ELSE 0 END;
    DECLARE @updated_$schema.metadata.positorSuffix$ bit = CASE WHEN UPDATE($schema.metadata.positorSuffix$) THEN 1 ELSE 0 END;
    IF(UPDATE($anchor.identityColumnName$))
        RAISERROR('The identity column $anchor.identityColumnName$ is not updatable.', 16, 1);
$/ foreach attribute in anchor.attributes
    DECLARE @updated_$attribute.valueColumnName$ bit = CASE WHEN UPDATE($attribute.valueColumnName$) THEN 1 ELSE 0 END;
$/ if attribute.isKnotted
    DECLARE @updated_$attribute.knotValueColumnName$ bit = CASE WHEN UPDATE($attribute.knotValueColumnName$) THEN 1 ELSE 0 END;
$/ endif
$/ if schema.METADATA
    DECLARE @updated_$attribute.metadataColumnName$ bit = CASE WHEN UPDATE($attribute.metadataColumnName$) THEN 1 ELSE 0 END;
$/ endif
$/ if attribute.isHistorized
    DECLARE @updated_$attribute.changingColumnName$ bit = CASE WHEN UPDATE($attribute.changingColumnName$) THEN 1 ELSE 0 END;
$/ endif
    DECLARE @updated_$attribute.positingColumnName$ bit = CASE WHEN UPDATE($attribute.positingColumnName$) THEN 1 ELSE 0 END;
    DECLARE @updated_$attribute.reliabilityColumnName$ bit = CASE WHEN UPDATE($attribute.reliabilityColumnName$) THEN 1 ELSE 0 END;
    DECLARE @updated_$attribute.positorColumnName$ bit = CASE WHEN UPDATE($attribute.positorColumnName$) THEN 1 ELSE 0 END;
    IF(UPDATE($attribute.identityColumnName$))
        RAISERROR('The identity column $attribute.identityColumnName$ is not updatable.', 16, 1);
    IF(UPDATE($attribute.entityReferenceName$))
        RAISERROR('The foreign key column $attribute.entityReferenceName$ is not updatable.', 16, 1);
    IF(UPDATE($attribute.assertionColumnName$))
        RAISERROR('The computed assertion column $attribute.assertionColumnName$ is not updatable.', 16, 1);
$/ if attribute.isKnotted
$/ if not schema.DECISIVENESS
$/ if attribute.isHistorized
    -- indecisive: another value at the same changing time is a correction, which retracts the shown one first, so that
    -- the new value is not taken for an alternative to it
$/ else
    -- indecisive: another value is a correction, which retracts the shown one first, so that the new value is not taken
    -- for an alternative to it
$/ endif
    IF (
        @updated_$attribute.valueColumnName$ = 1 OR
        @updated_$attribute.knotValueColumnName$ = 1
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN @updated_$anchor.metadataColumnName$ = 1 AND @updated_$attribute.metadataColumnName$ = 0
                THEN i.$anchor.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$anchor.metadataColumnName$),
$/ endif
            p.$attribute.entityReferenceName$,
            p.$attribute.valueColumnName$,
$/ if attribute.isHistorized
            p.$attribute.changingColumnName$,
$/ endif
            cast(ISNULL(CASE
                WHEN @updated_$attribute.positingColumnName$ = 1 THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$),
            d.$attribute.positorColumnName$,
            $schema.metadata.deleteReliability$
        FROM
            inserted i
        LEFT JOIN
            [$attribute.knot.capsule$].[$attribute.knot.name$] [k$attribute.knot.mnemonic$]
        ON
$/ if attribute.knot.hasChecksum
            [k$attribute.knot.mnemonic$].$attribute.knot.checksumColumnName$ = $schema.metadata.encapsulation$.MD5(cast(i.$attribute.knotValueColumnName$ as varbinary(max)))
$/ else
            [k$attribute.knot.mnemonic$].$attribute.knot.valueColumnName$ = i.$attribute.knotValueColumnName$
$/ endif
        JOIN
            deleted d
        ON
            d.$anchor.identityColumnName$ = i.$anchor.identityColumnName$
        AND
            d.$schema.metadata.positorSuffix$ = i.$schema.metadata.positorSuffix$
        JOIN
            [$attribute.capsule$].[$attribute.positName$] p
        ON
            p.$attribute.identityColumnName$ = d.$attribute.identityColumnName$
        WHERE
            p.$attribute.valueColumnName$ <> CASE
                WHEN @updated_$attribute.valueColumnName$ = 1 THEN i.$attribute.valueColumnName$
                ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$
            END
$/ if attribute.isHistorized
        AND
            @updated_$attribute.changingColumnName$ = 1
        AND
            p.$attribute.changingColumnName$ = i.$attribute.changingColumnName$
$/ endif
        AND
            d.$attribute.positorColumnName$ = ISNULL(CASE
                WHEN @updated_$attribute.positorColumnName$ = 1 THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0)
        AND
            d.$attribute.positingColumnName$ < cast(ISNULL(CASE
                WHEN @updated_$attribute.positingColumnName$ = 1 THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$)
        AND
            ISNULL(CASE
                WHEN @updated_$attribute.reliabilityColumnName$ = 1 THEN i.$attribute.reliabilityColumnName$
                WHEN @updated_$schema.metadata.reliabilitySuffix$ = 1 THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$) <> $schema.metadata.deleteReliability$;
    END
$/ endif
    IF (
        @updated_$attribute.valueColumnName$ = 1 OR
        @updated_$attribute.knotValueColumnName$ = 1 OR
        @updated_$attribute.reliabilityColumnName$ = 1 OR
        @updated_$schema.metadata.reliabilitySuffix$ = 1
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN @updated_$anchor.metadataColumnName$ = 1 AND @updated_$attribute.metadataColumnName$ = 0
                THEN i.$anchor.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$anchor.metadataColumnName$),
$/ endif
            ISNULL(i.$attribute.entityReferenceName$, i.$anchor.identityColumnName$),
            CASE
                WHEN @updated_$attribute.valueColumnName$ = 1 THEN i.$attribute.valueColumnName$
                ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$
            END,
$/ if attribute.isHistorized
            cast(ISNULL(CASE
                WHEN @updated_$attribute.changingColumnName$ = 1 THEN i.$attribute.changingColumnName$
                WHEN d.$attribute.valueColumnName$ = CASE WHEN @updated_$attribute.valueColumnName$ = 1 THEN i.$attribute.valueColumnName$ ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$ END
                THEN i.$attribute.changingColumnName$ -- the shown version is asserted again
            END, @now) as $attribute.timeRange$),
$/ endif
            cast(ISNULL(CASE
                WHEN @updated_$attribute.positingColumnName$ = 1 THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$),
            ISNULL(CASE
                WHEN @updated_$attribute.positorColumnName$ = 1 THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0),
            ISNULL(CASE
                WHEN @updated_$attribute.reliabilityColumnName$ = 1 THEN i.$attribute.reliabilityColumnName$
                WHEN @updated_$schema.metadata.reliabilitySuffix$ = 1 THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$)
        FROM
            inserted i
        LEFT JOIN
            [$attribute.knot.capsule$].[$attribute.knot.name$] [k$attribute.knot.mnemonic$]
        ON
$/ if attribute.knot.hasChecksum
            [k$attribute.knot.mnemonic$].$attribute.knot.checksumColumnName$ = $schema.metadata.encapsulation$.MD5(cast(i.$attribute.knotValueColumnName$ as varbinary(max)))
$/ else
            [k$attribute.knot.mnemonic$].$attribute.knot.valueColumnName$ = i.$attribute.knotValueColumnName$
$/ endif
        LEFT JOIN
            deleted d
        ON
            d.$anchor.identityColumnName$ = i.$anchor.identityColumnName$
        AND
            d.$schema.metadata.positorSuffix$ = i.$schema.metadata.positorSuffix$
        WHERE
            CASE
                WHEN @updated_$attribute.valueColumnName$ = 1 THEN i.$attribute.valueColumnName$
                ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$
            END is not null
        AND ( -- a statement that leaves everything as it is states nothing
$/ if attribute.isHistorized
            @updated_$attribute.changingColumnName$ = 1 OR
$/ endif
            @updated_$attribute.positingColumnName$ = 1 OR
            @updated_$attribute.positorColumnName$ = 1 OR
            @updated_$schema.metadata.positorSuffix$ = 1 OR
            d.$attribute.valueColumnName$ is null OR
            d.$attribute.valueColumnName$ <> CASE WHEN @updated_$attribute.valueColumnName$ = 1 THEN i.$attribute.valueColumnName$ ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$ END OR
            d.$attribute.reliabilityColumnName$ <> ISNULL(CASE
                WHEN @updated_$attribute.reliabilityColumnName$ = 1 THEN i.$attribute.reliabilityColumnName$
                WHEN @updated_$schema.metadata.reliabilitySuffix$ = 1 THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$)
        );
    END
    -- logical delete by setting to value to null
    -- note that an UPDATE SET AN_ATT_Anchor_Attribute = NULL, AN_ATT_ChangedAt = @timepoint
    -- will use @timepoint as a proxy for positing time
    IF (
        @updated_$attribute.valueColumnName$ = 1 OR
        @updated_$attribute.knotValueColumnName$ = 1
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN @updated_$anchor.metadataColumnName$ = 1 AND @updated_$attribute.metadataColumnName$ = 0
                THEN i.$anchor.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$anchor.metadataColumnName$),
$/ endif
            p.$attribute.entityReferenceName$,
            p.$attribute.valueColumnName$,
$/ if attribute.isHistorized
            p.$attribute.changingColumnName$,
$/ endif
            cast(ISNULL(CASE
                WHEN @updated_$attribute.positingColumnName$ = 1 THEN i.$attribute.positingColumnName$
$/ if attribute.isHistorized
                WHEN @updated_$attribute.changingColumnName$ = 1 THEN i.$attribute.changingColumnName$
$/ endif
            END, @now) as $schema.metadata.positingRange$),
            ISNULL(CASE
                WHEN @updated_$attribute.positorColumnName$ = 1 THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0),
            $schema.metadata.deleteReliability$
        FROM
            inserted i
        JOIN
            [$attribute.capsule$].[$attribute.positName$] p
        ON
            p.$attribute.identityColumnName$ = i.$attribute.identityColumnName$
        WHERE
            (@updated_$attribute.valueColumnName$ = 1 AND i.$attribute.valueColumnName$ is null)
        OR
            (@updated_$attribute.knotValueColumnName$ = 1 AND i.$attribute.knotValueColumnName$ is null);
    END
$/ else
$/ if not schema.DECISIVENESS
$/ if attribute.isHistorized
    -- indecisive: another value at the same changing time is a correction, which retracts the shown one first, so that
    -- the new value is not taken for an alternative to it
$/ else
    -- indecisive: another value is a correction, which retracts the shown one first, so that the new value is not taken
    -- for an alternative to it
$/ endif
    IF (
        @updated_$attribute.valueColumnName$ = 1
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN @updated_$anchor.metadataColumnName$ = 1 AND @updated_$attribute.metadataColumnName$ = 0
                THEN i.$anchor.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$anchor.metadataColumnName$),
$/ endif
            p.$attribute.entityReferenceName$,
            p.$attribute.valueColumnName$,
$/ if attribute.isHistorized
            p.$attribute.changingColumnName$,
$/ endif
            cast(ISNULL(CASE
                WHEN @updated_$attribute.positingColumnName$ = 1 THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$),
            d.$attribute.positorColumnName$,
            $schema.metadata.deleteReliability$
        FROM
            inserted i
        JOIN
            deleted d
        ON
            d.$anchor.identityColumnName$ = i.$anchor.identityColumnName$
        AND
            d.$schema.metadata.positorSuffix$ = i.$schema.metadata.positorSuffix$
        JOIN
            [$attribute.capsule$].[$attribute.positName$] p
        ON
            p.$attribute.identityColumnName$ = d.$attribute.identityColumnName$
        WHERE
$/ if attribute.hasChecksum
            p.$attribute.checksumColumnName$ <> $schema.metadata.encapsulation$.MD5(cast(i.$attribute.valueColumnName$ as varbinary(max)))
$/ else
            p.$attribute.valueColumnName$ <> i.$attribute.valueColumnName$
$/ endif
$/ if attribute.isHistorized
        AND
            @updated_$attribute.changingColumnName$ = 1
        AND
            p.$attribute.changingColumnName$ = i.$attribute.changingColumnName$
$/ endif
        AND
            d.$attribute.positorColumnName$ = ISNULL(CASE
                WHEN @updated_$attribute.positorColumnName$ = 1 THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0)
        AND
            d.$attribute.positingColumnName$ < cast(ISNULL(CASE
                WHEN @updated_$attribute.positingColumnName$ = 1 THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$)
        AND
            ISNULL(CASE
                WHEN @updated_$attribute.reliabilityColumnName$ = 1 THEN i.$attribute.reliabilityColumnName$
                WHEN @updated_$schema.metadata.reliabilitySuffix$ = 1 THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$) <> $schema.metadata.deleteReliability$;
    END
$/ endif
    IF (
        @updated_$attribute.valueColumnName$ = 1 OR
        @updated_$attribute.reliabilityColumnName$ = 1 OR
        @updated_$schema.metadata.reliabilitySuffix$ = 1
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN @updated_$anchor.metadataColumnName$ = 1 AND @updated_$attribute.metadataColumnName$ = 0
                THEN i.$anchor.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$anchor.metadataColumnName$),
$/ endif
            ISNULL(i.$attribute.entityReferenceName$, i.$anchor.identityColumnName$),
            i.$attribute.valueColumnName$,
$/ if attribute.isHistorized
            cast(ISNULL(CASE
                WHEN @updated_$attribute.changingColumnName$ = 1 THEN i.$attribute.changingColumnName$
$/ if attribute.hasChecksum
                WHEN d.$attribute.checksumColumnName$ = $schema.metadata.encapsulation$.MD5(cast(i.$attribute.valueColumnName$ as varbinary(max)))
$/ else
                WHEN d.$attribute.valueColumnName$ = i.$attribute.valueColumnName$
$/ endif
                THEN i.$attribute.changingColumnName$ -- the shown version is asserted again
            END, @now) as $attribute.timeRange$),
$/ endif
            cast(ISNULL(CASE
                WHEN @updated_$attribute.positingColumnName$ = 1 THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$),
            ISNULL(CASE
                WHEN @updated_$attribute.positorColumnName$ = 1 THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0),
            ISNULL(CASE
                WHEN @updated_$attribute.reliabilityColumnName$ = 1 THEN i.$attribute.reliabilityColumnName$
                WHEN @updated_$schema.metadata.reliabilitySuffix$ = 1 THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$)
        FROM
            inserted i
        LEFT JOIN
            deleted d
        ON
            d.$anchor.identityColumnName$ = i.$anchor.identityColumnName$
        AND
            d.$schema.metadata.positorSuffix$ = i.$schema.metadata.positorSuffix$
        WHERE
            i.$attribute.valueColumnName$ is not null
        AND ( -- a statement that leaves everything as it is states nothing
$/ if attribute.isHistorized
            @updated_$attribute.changingColumnName$ = 1 OR
$/ endif
            @updated_$attribute.positingColumnName$ = 1 OR
            @updated_$attribute.positorColumnName$ = 1 OR
            @updated_$schema.metadata.positorSuffix$ = 1 OR
            d.$attribute.valueColumnName$ is null OR
$/ if attribute.hasChecksum
            d.$attribute.checksumColumnName$ <> $schema.metadata.encapsulation$.MD5(cast(i.$attribute.valueColumnName$ as varbinary(max))) OR
$/ else
            d.$attribute.valueColumnName$ <> i.$attribute.valueColumnName$ OR
$/ endif
            d.$attribute.reliabilityColumnName$ <> ISNULL(CASE
                WHEN @updated_$attribute.reliabilityColumnName$ = 1 THEN i.$attribute.reliabilityColumnName$
                WHEN @updated_$schema.metadata.reliabilitySuffix$ = 1 THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$)
        )
    END
    -- logical delete by setting to value to null
    -- note that an UPDATE SET AN_ATT_Anchor_Attribute = NULL, AN_ATT_ChangedAt = @timepoint
    -- will use @timepoint as a proxy for positing time
    IF (
        @updated_$attribute.valueColumnName$ = 1
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN @updated_$anchor.metadataColumnName$ = 1 AND @updated_$attribute.metadataColumnName$ = 0
                THEN i.$anchor.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$anchor.metadataColumnName$),
$/ endif
            p.$attribute.entityReferenceName$,
            p.$attribute.valueColumnName$,
$/ if attribute.isHistorized
            p.$attribute.changingColumnName$,
$/ endif
            cast(ISNULL(CASE
                WHEN @updated_$attribute.positingColumnName$ = 1 THEN i.$attribute.positingColumnName$
$/ if attribute.isHistorized
                WHEN @updated_$attribute.changingColumnName$ = 1 THEN i.$attribute.changingColumnName$
$/ endif
            END, @now) as $schema.metadata.positingRange$),
            ISNULL(CASE
                WHEN @updated_$attribute.positorColumnName$ = 1 THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0),
            $schema.metadata.deleteReliability$
        FROM
            inserted i
        JOIN
            [$attribute.capsule$].[$attribute.positName$] p
        ON
            p.$attribute.identityColumnName$ = i.$attribute.identityColumnName$
        WHERE
            i.$attribute.valueColumnName$ is null
    END
$/ endif
$/ endfor
END
GO
$/ endif
$/ if anchor.attributes
-- DELETE trigger -----------------------------------------------------------------------------------------------------
-- dt_l$anchor.name$ instead of DELETE trigger on l$anchor.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$anchor.capsule$].[dt_l$anchor.name$] ON [$anchor.capsule$].[l$anchor.name$]
INSTEAD OF DELETE
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @now $schema.metadata.chronon$;
    SET @now = $schema.metadata.now$;
$/ foreach attribute in anchor.attributes
    INSERT INTO [$attribute.capsule$].[$attribute.annexName$] (
$/ if schema.METADATA
        $attribute.metadataColumnName$,
$/ endif
        $attribute.identityColumnName$,
        $attribute.positorColumnName$,
        $attribute.positingColumnName$,
        $attribute.reliabilityColumnName$
    )
    SELECT
$/ if schema.METADATA
        d.$attribute.metadataColumnName$,
$/ endif
        d.$attribute.identityColumnName$,
        d.$attribute.positorColumnName$,
        @now,
        $schema.metadata.deleteReliability$
    FROM
        deleted d
    WHERE
        d.$attribute.identityColumnName$ is not null;
$/ endfor
END
GO
$/ endif
$/ endfor
$/ endif
