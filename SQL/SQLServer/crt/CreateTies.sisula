-- TIES ---------------------------------------------------------------------------------------------------------------
--
-- Ties are used to represent relationships between entities.
-- They come in four flavors: static, historized, knotted static, and knotted historized.
-- Ties have cardinality, constraining how members may participate in the relationship.
-- Every entity that is a member in a tie has a specified role in the relationship.
-- Ties must have at least two anchor roles and zero or more knot roles.
--
$/ foreach tie in schema.ties
$/ if tie.isHistorized and tie.isKnotted
-- Knotted historized tie table ---------------------------------------------------------------------------------------
$/ endif
$/ if tie.isHistorized and not tie.isKnotted
-- Historized tie table -----------------------------------------------------------------------------------------------
$/ endif
$/ if not tie.isHistorized and tie.isKnotted
-- Knotted static tie table -------------------------------------------------------------------------------------------
$/ endif
$/ if not tie.isHistorized and not tie.isKnotted
-- Static tie table ---------------------------------------------------------------------------------------------------
$/ endif
-- $tie.positName$ table (having $tie.roleCount$ roles)
-----------------------------------------------------------------------------------------------------------------------
IF Object_ID('$tie.capsule$.$tie.positName$', 'U') IS NULL
CREATE TABLE [$tie.capsule$].[$tie.positName$] (
$/ if tie.isGenerator
    $tie.identityColumnName$ $/ if tie.identity $tie.identity$ $/ endif IDENTITY(1,1) not null,
$/ else
    $tie.identityColumnName$ $/ if tie.identity $tie.identity$ $/ endif not null,
$/ endif
$/ foreach role in tie.roles
$/ if role.entity
    $role.columnName$ $role.entity.identity$ not null,
$/ else
    $role.columnName$ $role.knot.identity$ not null,
$/ endif
$/ endfor
$/ if tie.timeRange
    $tie.changingColumnName$ $tie.timeRange$ not null,
$/ endif
$/ foreach role in tie.roles
    constraint $tie.positName$_fk$role.name$ foreign key (
        $role.columnName$
$/ if role.entity
    ) references [$role.entity.capsule$].[$role.entity.name$]($role.entity.identityColumnName$),
$/ else
    ) references [$role.knot.capsule$].[$role.knot.name$]($role.knot.identityColumnName$),
$/ endif
$/ endfor
$/ if not tie.identifiers
$/ foreach role in tie.roles where role.isAnchorRole
$/ if tie.isHistorized
    constraint $tie.positName$_uq$role.name$ unique (
        $role.columnName$,
        $tie.changingColumnName$
    ),
$/ else
    constraint $tie.positName$_uq$role.name$ unique (
        $role.columnName$
    ),
$/ endif
$/ endfor
$/ endif
    constraint pk$tie.positName$ primary key nonclustered (
        $tie.identityColumnName$ asc
    ),
    constraint uq$tie.name$ unique clustered (
$/ foreach role in tie.identifiers
        $role.columnName$ asc$/ if not role.last() or tie.values or tie.isHistorized ,$/ endif
$/ endfor
$/ if tie.isHistorized
        $tie.changingColumnName$ desc$/ if tie.values ,$/ endif
$/ endif
$/ foreach role in tie.values
        $role.columnName$ asc$/ if not role.last() ,$/ endif
$/ endfor
    )
);
-- Tie annex table ----------------------------------------------------------------------------------------------------
-- $tie.annexName$ table
-----------------------------------------------------------------------------------------------------------------------
IF Object_ID('$tie.capsule$.$tie.annexName$', 'U') IS NULL
CREATE TABLE [$tie.capsule$].[$tie.annexName$] (
    $tie.identityColumnName$ $/ if tie.identity $tie.identity$ $/ endif not null,
    $tie.positingColumnName$ $schema.metadata.positingRange$ not null,
    $tie.positorColumnName$ $schema.metadata.positorRange$ not null,
    $tie.reliabilityColumnName$ $schema.metadata.reliabilityRange$ not null,
    $tie.assertionColumnName$ as cast(
        case
            when $tie.reliabilityColumnName$ > $schema.metadata.deleteReliability$ then '+'
            when $tie.reliabilityColumnName$ = $schema.metadata.deleteReliability$ then '?'
            when $tie.reliabilityColumnName$ < $schema.metadata.deleteReliability$ then '-'
        end
    as char(1)) persisted,
$/ if schema.METADATA
    $tie.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
    constraint fk$tie.annexName$ foreign key (
        $tie.identityColumnName$
    ) references [$tie.capsule$].[$tie.positName$]($tie.identityColumnName$),
    constraint pk$tie.annexName$ primary key clustered (
        $tie.identityColumnName$ asc,
        $tie.positorColumnName$ asc,
        $tie.positingColumnName$ desc
    )
$/ if schema.PARTITIONING
) ON PositorScheme($tie.positorColumnName$);
$/ else
);
$/ endif
GO
$/ endfor
