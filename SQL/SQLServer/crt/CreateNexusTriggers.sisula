$/ if schema.TRIGGERS
-- NEXUS TRIGGERS ---------------------------------------------------------------------------------------------------
--
-- The following triggers on the latest view make it behave like a table.
-- There are three different 'instead of' triggers: insert, update, and delete.
-- The roles of a nexus are part of its identity, so they are not updatable.
-- They will ensure that such operations are propagated to the underlying tables
-- in a consistent way. Default values are used for some columns if not provided
-- by the corresponding SQL statements.
--
-- For idempotent attributes, only changes that represent a value different from
-- the previous or following value are stored. Others are silently ignored in
-- order to avoid unnecessary temporal duplicates.
--
$/ foreach nexus in schema.nexuses
$/ if nexus.attributes
-- Insert trigger -----------------------------------------------------------------------------------------------------
-- it_l$nexus.name$ instead of INSERT trigger on l$nexus.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$nexus.capsule$].[it_l$nexus.name$] ON [$nexus.capsule$].[l$nexus.name$]
INSTEAD OF INSERT
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @now $schema.metadata.chronon$;
    SET @now = $schema.metadata.now$;
    DECLARE @inserted TABLE (
        $nexus.identityColumnName$ $nexus.identity$ not null,
$/ if schema.METADATA
        $nexus.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
$/ foreach attribute in nexus.attributes
$/ if schema.IMPROVED
        $attribute.entityReferenceName$ $nexus.identity$ null,
$/ endif
$/ if schema.METADATA
        $attribute.metadataColumnName$ $schema.metadata.metadataType$ null,
$/ endif
$/ if attribute.isHistorized
        $attribute.changingColumnName$ $attribute.timeRange$ null,
$/ endif
        $attribute.positorColumnName$ $schema.metadata.positorRange$ null,
        $attribute.positingColumnName$ $schema.metadata.positingRange$ null,
        $attribute.reliabilityColumnName$ $schema.metadata.reliabilityRange$ null,
$/ if attribute.isKnotted
        $attribute.knotValueColumnName$ $attribute.knot.dataRange$ null,
$/ if attribute.knot.hasChecksum
        $attribute.knotChecksumColumnName$ varbinary(16) null,
$/ endif
$/ if schema.METADATA
        $attribute.knotMetadataColumnName$ $schema.metadata.metadataType$ null,
$/ endif
        $attribute.valueColumnName$ $attribute.knot.identity$ null$/ if not attribute.last() ,$/ endif
$/ else
        $attribute.valueColumnName$ $attribute.dataRange$ null$/ if not attribute.last() ,$/ endif
$/ endif
$/ endfor
    );
    -- a nexus row for each row without an identity; the merge outputs every new identity together with the values of
    -- the row it was made for, so each new row keeps its own attributes, also when several are inserted at once
    MERGE INTO [$nexus.capsule$].[$nexus.name$]
    USING inserted AS i
    ON 1 = 0
    WHEN NOT MATCHED AND i.$nexus.identityColumnName$ is null THEN INSERT (
$/ foreach role in nexus.roles
        $role.columnName$,
$/ endfor
        $/ if schema.METADATA $nexus.metadataColumnName$ $/ else $nexus.dummyColumnName$$/ endif
    )
    VALUES (
$/ foreach role in nexus.roles
        i.$role.columnName$,
$/ endfor
        $/ if schema.METADATA i.$nexus.metadataColumnName$ $/ else null$/ endif
    )
    OUTPUT
        inserted.$nexus.identityColumnName$,
$/ if schema.METADATA
        i.$nexus.metadataColumnName$,
$/ endif
$/ foreach attribute in nexus.attributes
$/ if schema.IMPROVED
        ISNULL(i.$attribute.entityReferenceName$, inserted.$nexus.identityColumnName$),
$/ endif
$/ if schema.METADATA
        ISNULL(i.$attribute.metadataColumnName$, i.$nexus.metadataColumnName$),
$/ endif
$/ if attribute.isHistorized
        ISNULL(i.$attribute.changingColumnName$, @now),
$/ endif
        ISNULL(ISNULL(i.$attribute.positorColumnName$, i.$schema.metadata.positorSuffix$), 0),
        ISNULL(i.$attribute.positingColumnName$, @now),
        ISNULL(ISNULL(i.$attribute.reliabilityColumnName$, i.$schema.metadata.reliabilitySuffix$), $schema.metadata.defaultReliability$),
$/ if attribute.isKnotted
        i.$attribute.knotValueColumnName$,
$/ if attribute.knot.hasChecksum
        ISNULL(i.$attribute.knotChecksumColumnName$, $schema.metadata.encapsulation$.MD5(cast(i.$attribute.knotValueColumnName$ as varbinary(max)))),
$/ endif
$/ if schema.METADATA
        ISNULL(i.$attribute.knotMetadataColumnName$, i.$nexus.metadataColumnName$),
$/ endif
$/ endif
        i.$attribute.valueColumnName$$/ if not attribute.last() ,$/ endif
$/ endfor
    INTO
        @inserted;
    -- the rows that come with the identity of a nexus row
    INSERT INTO @inserted
    SELECT
        i.$nexus.identityColumnName$,
$/ if schema.METADATA
        i.$nexus.metadataColumnName$,
$/ endif
$/ foreach attribute in nexus.attributes
$/ if schema.IMPROVED
        ISNULL(i.$attribute.entityReferenceName$, i.$nexus.identityColumnName$),
$/ endif
$/ if schema.METADATA
        ISNULL(i.$attribute.metadataColumnName$, i.$nexus.metadataColumnName$),
$/ endif
$/ if attribute.isHistorized
        ISNULL(i.$attribute.changingColumnName$, @now),
$/ endif
        ISNULL(ISNULL(i.$attribute.positorColumnName$, i.$schema.metadata.positorSuffix$), 0),
        ISNULL(i.$attribute.positingColumnName$, @now),
        ISNULL(ISNULL(i.$attribute.reliabilityColumnName$, i.$schema.metadata.reliabilitySuffix$), $schema.metadata.defaultReliability$),
$/ if attribute.isKnotted
        i.$attribute.knotValueColumnName$,
$/ if attribute.knot.hasChecksum
        ISNULL(i.$attribute.knotChecksumColumnName$, $schema.metadata.encapsulation$.MD5(cast(i.$attribute.knotValueColumnName$ as varbinary(max)))),
$/ endif
$/ if schema.METADATA
        ISNULL(i.$attribute.knotMetadataColumnName$, i.$nexus.metadataColumnName$),
$/ endif
$/ endif
        i.$attribute.valueColumnName$$/ if not attribute.last() ,$/ endif
$/ endfor
    FROM
        inserted i
    WHERE
        i.$nexus.identityColumnName$ is not null;
$/ foreach attribute in nexus.attributes
    INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
        $attribute.metadataColumnName$,
$/ endif
        $attribute.entityReferenceName$,
        $attribute.valueColumnName$,
$/ if attribute.timeRange
        $attribute.changingColumnName$,
$/ endif
        $attribute.positingColumnName$,
        $attribute.positorColumnName$,
        $attribute.reliabilityColumnName$
    )
    SELECT
$/ if schema.METADATA
        i.$attribute.metadataColumnName$,
$/ endif
        i.$attribute.entityReferenceName$,
        $/ if attribute.isKnotted ISNULL(i.$attribute.valueColumnName$, [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$), $/ else i.$attribute.valueColumnName$,$/ endif
$/ if attribute.timeRange
        i.$attribute.changingColumnName$,
$/ endif
        i.$attribute.positingColumnName$,
        i.$attribute.positorColumnName$,
        i.$attribute.reliabilityColumnName$
    FROM
        @inserted i
$/ if attribute.isKnotted
    LEFT JOIN
        [$attribute.knot.capsule$].[$attribute.knot.name$] [k$attribute.knot.mnemonic$]
    ON
        $/ if attribute.knot.hasChecksum [k$attribute.knot.mnemonic$].$attribute.knot.checksumColumnName$ = i.$attribute.knotChecksumColumnName$ $/ else [k$attribute.knot.mnemonic$].$attribute.knot.valueColumnName$ = i.$attribute.knotValueColumnName$$/ endif
    WHERE
        ISNULL(i.$attribute.valueColumnName$, [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$) is not null;
$/ else
    WHERE
        i.$attribute.valueColumnName$ is not null;
$/ endif
$/ endfor
END
GO
$/ endif
$/ if nexus.attributes
-- UPDATE trigger -----------------------------------------------------------------------------------------------------
-- ut_l$nexus.name$ instead of UPDATE trigger on l$nexus.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$nexus.capsule$].[ut_l$nexus.name$] ON [$nexus.capsule$].[l$nexus.name$]
INSTEAD OF UPDATE
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @now $schema.metadata.chronon$;
    SET @now = $schema.metadata.now$;
    IF(UPDATE($nexus.identityColumnName$))
        RAISERROR('The identity column $nexus.identityColumnName$ is not updatable.', 16, 1);
$/ foreach role in nexus.roles
    IF(UPDATE($role.columnName$))
        RAISERROR('The role column $role.columnName$ is not updatable.', 16, 1);
$/ if role.knot
    IF(UPDATE($role.knotValueColumnName$))
        RAISERROR('The role column $role.knotValueColumnName$ is not updatable.', 16, 1);
$/ endif
$/ endfor
$/ foreach attribute in nexus.attributes
    IF(UPDATE($attribute.identityColumnName$))
        RAISERROR('The identity column $attribute.identityColumnName$ is not updatable.', 16, 1);
    IF(UPDATE($attribute.entityReferenceName$))
        RAISERROR('The foreign key column $attribute.entityReferenceName$ is not updatable.', 16, 1);
    IF(UPDATE($attribute.assertionColumnName$))
        RAISERROR('The computed assertion column $attribute.assertionColumnName$ is not updatable.', 16, 1);
$/ if attribute.isKnotted
$/ if not schema.DECISIVENESS
$/ if attribute.isHistorized
    -- indecisive: another value at the same changing time is a correction, which retracts the shown one first, so that
    -- the new value is not taken for an alternative to it
$/ else
    -- indecisive: another value is a correction, which retracts the shown one first, so that the new value is not taken
    -- for an alternative to it
$/ endif
    IF (
        UPDATE($attribute.valueColumnName$) OR
        UPDATE($attribute.knotValueColumnName$)
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN UPDATE($nexus.metadataColumnName$) AND NOT UPDATE($attribute.metadataColumnName$)
                THEN i.$nexus.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$nexus.metadataColumnName$),
$/ endif
            p.$attribute.entityReferenceName$,
            p.$attribute.valueColumnName$,
$/ if attribute.isHistorized
            p.$attribute.changingColumnName$,
$/ endif
            cast(ISNULL(CASE
                WHEN UPDATE($attribute.positingColumnName$) THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$),
            d.$attribute.positorColumnName$,
            $schema.metadata.deleteReliability$
        FROM
            inserted i
        LEFT JOIN
            [$attribute.knot.capsule$].[$attribute.knot.name$] [k$attribute.knot.mnemonic$]
        ON
$/ if attribute.knot.hasChecksum
            [k$attribute.knot.mnemonic$].$attribute.knot.checksumColumnName$ = $schema.metadata.encapsulation$.MD5(cast(i.$attribute.knotValueColumnName$ as varbinary(max)))
$/ else
            [k$attribute.knot.mnemonic$].$attribute.knot.valueColumnName$ = i.$attribute.knotValueColumnName$
$/ endif
        JOIN
            deleted d
        ON
            d.$nexus.identityColumnName$ = i.$nexus.identityColumnName$
        AND
            d.$schema.metadata.positorSuffix$ = i.$schema.metadata.positorSuffix$
        JOIN
            [$attribute.capsule$].[$attribute.positName$] p
        ON
            p.$attribute.identityColumnName$ = d.$attribute.identityColumnName$
        WHERE
            p.$attribute.valueColumnName$ <> CASE
                WHEN UPDATE($attribute.valueColumnName$) THEN i.$attribute.valueColumnName$
                ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$
            END
$/ if attribute.isHistorized
        AND
            UPDATE($attribute.changingColumnName$)
        AND
            p.$attribute.changingColumnName$ = i.$attribute.changingColumnName$
$/ endif
        AND
            d.$attribute.positorColumnName$ = ISNULL(CASE
                WHEN UPDATE($attribute.positorColumnName$) THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0)
        AND
            d.$attribute.positingColumnName$ < cast(ISNULL(CASE
                WHEN UPDATE($attribute.positingColumnName$) THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$)
        AND
            ISNULL(CASE
                WHEN UPDATE($attribute.reliabilityColumnName$) THEN i.$attribute.reliabilityColumnName$
                WHEN UPDATE($schema.metadata.reliabilitySuffix$) THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$) <> $schema.metadata.deleteReliability$;
    END
$/ endif
    IF (
        UPDATE($attribute.valueColumnName$) OR
        UPDATE($attribute.knotValueColumnName$) OR
        UPDATE($attribute.reliabilityColumnName$) OR
        UPDATE($schema.metadata.reliabilitySuffix$)
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN UPDATE($nexus.metadataColumnName$) AND NOT UPDATE($attribute.metadataColumnName$)
                THEN i.$nexus.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$nexus.metadataColumnName$),
$/ endif
            ISNULL(i.$attribute.entityReferenceName$, i.$nexus.identityColumnName$),
            CASE
                WHEN UPDATE($attribute.valueColumnName$) THEN i.$attribute.valueColumnName$
                ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$
            END,
$/ if attribute.isHistorized
            cast(ISNULL(CASE
                WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$
                WHEN d.$attribute.valueColumnName$ = CASE WHEN UPDATE($attribute.valueColumnName$) THEN i.$attribute.valueColumnName$ ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$ END
                THEN i.$attribute.changingColumnName$ -- the shown version is asserted again
            END, @now) as $attribute.timeRange$),
$/ endif
            cast(ISNULL(CASE
                WHEN UPDATE($attribute.positingColumnName$) THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$),
            ISNULL(CASE
                WHEN UPDATE($attribute.positorColumnName$) THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0),
            ISNULL(CASE
                WHEN UPDATE($attribute.reliabilityColumnName$) THEN i.$attribute.reliabilityColumnName$
                WHEN UPDATE($schema.metadata.reliabilitySuffix$) THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$)
        FROM
            inserted i
        LEFT JOIN
            [$attribute.knot.capsule$].[$attribute.knot.name$] [k$attribute.knot.mnemonic$]
        ON
$/ if attribute.knot.hasChecksum
            [k$attribute.knot.mnemonic$].$attribute.knot.checksumColumnName$ = $schema.metadata.encapsulation$.MD5(cast(i.$attribute.knotValueColumnName$ as varbinary(max)))
$/ else
            [k$attribute.knot.mnemonic$].$attribute.knot.valueColumnName$ = i.$attribute.knotValueColumnName$
$/ endif
        LEFT JOIN
            deleted d
        ON
            d.$nexus.identityColumnName$ = i.$nexus.identityColumnName$
        AND
            d.$schema.metadata.positorSuffix$ = i.$schema.metadata.positorSuffix$
        WHERE
            CASE
                WHEN UPDATE($attribute.valueColumnName$) THEN i.$attribute.valueColumnName$
                ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$
            END is not null
        AND ( -- a statement that leaves everything as it is states nothing
$/ if attribute.isHistorized
            UPDATE($attribute.changingColumnName$) OR
$/ endif
            UPDATE($attribute.positingColumnName$) OR
            UPDATE($attribute.positorColumnName$) OR
            UPDATE($schema.metadata.positorSuffix$) OR
            d.$attribute.valueColumnName$ is null OR
            d.$attribute.valueColumnName$ <> CASE WHEN UPDATE($attribute.valueColumnName$) THEN i.$attribute.valueColumnName$ ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$ END OR
            d.$attribute.reliabilityColumnName$ <> ISNULL(CASE
                WHEN UPDATE($attribute.reliabilityColumnName$) THEN i.$attribute.reliabilityColumnName$
                WHEN UPDATE($schema.metadata.reliabilitySuffix$) THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$)
        );
    END
    -- logical delete by setting to value to null
    -- note that an UPDATE SET AN_ATT_Anchor_Attribute = NULL, AN_ATT_ChangedAt = @timepoint
    -- will use @timepoint as a proxy for positing time
    IF (
        UPDATE($attribute.valueColumnName$) OR
        UPDATE($attribute.knotValueColumnName$)
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN UPDATE($nexus.metadataColumnName$) AND NOT UPDATE($attribute.metadataColumnName$)
                THEN i.$nexus.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$nexus.metadataColumnName$),
$/ endif
            p.$attribute.entityReferenceName$,
            p.$attribute.valueColumnName$,
$/ if attribute.isHistorized
            p.$attribute.changingColumnName$,
$/ endif
            cast(ISNULL(CASE
                WHEN UPDATE($attribute.positingColumnName$) THEN i.$attribute.positingColumnName$
$/ if attribute.isHistorized
                WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$
$/ endif
            END, @now) as $schema.metadata.positingRange$),
            ISNULL(CASE
                WHEN UPDATE($attribute.positorColumnName$) THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0),
            $schema.metadata.deleteReliability$
        FROM
            inserted i
        JOIN
            [$attribute.capsule$].[$attribute.positName$] p
        ON
            p.$attribute.identityColumnName$ = i.$attribute.identityColumnName$
        WHERE
            (UPDATE($attribute.valueColumnName$) AND i.$attribute.valueColumnName$ is null)
        OR
            (UPDATE($attribute.knotValueColumnName$) AND i.$attribute.knotValueColumnName$ is null);
    END
$/ else
$/ if not schema.DECISIVENESS
$/ if attribute.isHistorized
    -- indecisive: another value at the same changing time is a correction, which retracts the shown one first, so that
    -- the new value is not taken for an alternative to it
$/ else
    -- indecisive: another value is a correction, which retracts the shown one first, so that the new value is not taken
    -- for an alternative to it
$/ endif
    IF (
        UPDATE($attribute.valueColumnName$)
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN UPDATE($nexus.metadataColumnName$) AND NOT UPDATE($attribute.metadataColumnName$)
                THEN i.$nexus.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$nexus.metadataColumnName$),
$/ endif
            p.$attribute.entityReferenceName$,
            p.$attribute.valueColumnName$,
$/ if attribute.isHistorized
            p.$attribute.changingColumnName$,
$/ endif
            cast(ISNULL(CASE
                WHEN UPDATE($attribute.positingColumnName$) THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$),
            d.$attribute.positorColumnName$,
            $schema.metadata.deleteReliability$
        FROM
            inserted i
        JOIN
            deleted d
        ON
            d.$nexus.identityColumnName$ = i.$nexus.identityColumnName$
        AND
            d.$schema.metadata.positorSuffix$ = i.$schema.metadata.positorSuffix$
        JOIN
            [$attribute.capsule$].[$attribute.positName$] p
        ON
            p.$attribute.identityColumnName$ = d.$attribute.identityColumnName$
        WHERE
$/ if attribute.hasChecksum
            p.$attribute.checksumColumnName$ <> $schema.metadata.encapsulation$.MD5(cast(i.$attribute.valueColumnName$ as varbinary(max)))
$/ else
            p.$attribute.valueColumnName$ <> i.$attribute.valueColumnName$
$/ endif
$/ if attribute.isHistorized
        AND
            UPDATE($attribute.changingColumnName$)
        AND
            p.$attribute.changingColumnName$ = i.$attribute.changingColumnName$
$/ endif
        AND
            d.$attribute.positorColumnName$ = ISNULL(CASE
                WHEN UPDATE($attribute.positorColumnName$) THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0)
        AND
            d.$attribute.positingColumnName$ < cast(ISNULL(CASE
                WHEN UPDATE($attribute.positingColumnName$) THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$)
        AND
            ISNULL(CASE
                WHEN UPDATE($attribute.reliabilityColumnName$) THEN i.$attribute.reliabilityColumnName$
                WHEN UPDATE($schema.metadata.reliabilitySuffix$) THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$) <> $schema.metadata.deleteReliability$;
    END
$/ endif
    IF (
        UPDATE($attribute.valueColumnName$) OR
        UPDATE($attribute.reliabilityColumnName$) OR
        UPDATE($schema.metadata.reliabilitySuffix$)
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN UPDATE($nexus.metadataColumnName$) AND NOT UPDATE($attribute.metadataColumnName$)
                THEN i.$nexus.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$nexus.metadataColumnName$),
$/ endif
            ISNULL(i.$attribute.entityReferenceName$, i.$nexus.identityColumnName$),
            i.$attribute.valueColumnName$,
$/ if attribute.isHistorized
            cast(ISNULL(CASE
                WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$
$/ if attribute.hasChecksum
                WHEN d.$attribute.checksumColumnName$ = $schema.metadata.encapsulation$.MD5(cast(i.$attribute.valueColumnName$ as varbinary(max)))
$/ else
                WHEN d.$attribute.valueColumnName$ = i.$attribute.valueColumnName$
$/ endif
                THEN i.$attribute.changingColumnName$ -- the shown version is asserted again
            END, @now) as $attribute.timeRange$),
$/ endif
            cast(ISNULL(CASE
                WHEN UPDATE($attribute.positingColumnName$) THEN i.$attribute.positingColumnName$
            END, @now) as $schema.metadata.positingRange$),
            ISNULL(CASE
                WHEN UPDATE($attribute.positorColumnName$) THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0),
            ISNULL(CASE
                WHEN UPDATE($attribute.reliabilityColumnName$) THEN i.$attribute.reliabilityColumnName$
                WHEN UPDATE($schema.metadata.reliabilitySuffix$) THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$)
        FROM
            inserted i
        LEFT JOIN
            deleted d
        ON
            d.$nexus.identityColumnName$ = i.$nexus.identityColumnName$
        AND
            d.$schema.metadata.positorSuffix$ = i.$schema.metadata.positorSuffix$
        WHERE
            i.$attribute.valueColumnName$ is not null
        AND ( -- a statement that leaves everything as it is states nothing
$/ if attribute.isHistorized
            UPDATE($attribute.changingColumnName$) OR
$/ endif
            UPDATE($attribute.positingColumnName$) OR
            UPDATE($attribute.positorColumnName$) OR
            UPDATE($schema.metadata.positorSuffix$) OR
            d.$attribute.valueColumnName$ is null OR
$/ if attribute.hasChecksum
            d.$attribute.checksumColumnName$ <> $schema.metadata.encapsulation$.MD5(cast(i.$attribute.valueColumnName$ as varbinary(max))) OR
$/ else
            d.$attribute.valueColumnName$ <> i.$attribute.valueColumnName$ OR
$/ endif
            d.$attribute.reliabilityColumnName$ <> ISNULL(CASE
                WHEN UPDATE($attribute.reliabilityColumnName$) THEN i.$attribute.reliabilityColumnName$
                WHEN UPDATE($schema.metadata.reliabilitySuffix$) THEN i.$schema.metadata.reliabilitySuffix$
                ELSE i.$attribute.reliabilityColumnName$
            END, $schema.metadata.defaultReliability$)
        )
    END
    -- logical delete by setting to value to null
    -- note that an UPDATE SET AN_ATT_Anchor_Attribute = NULL, AN_ATT_ChangedAt = @timepoint
    -- will use @timepoint as a proxy for positing time
    IF (
        UPDATE($attribute.valueColumnName$)
    )
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
            $attribute.valueColumnName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.positingColumnName$,
            $attribute.positorColumnName$,
            $attribute.reliabilityColumnName$
        )
        SELECT
$/ if schema.METADATA
            ISNULL(CASE
                WHEN UPDATE($nexus.metadataColumnName$) AND NOT UPDATE($attribute.metadataColumnName$)
                THEN i.$nexus.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$nexus.metadataColumnName$),
$/ endif
            p.$attribute.entityReferenceName$,
            p.$attribute.valueColumnName$,
$/ if attribute.isHistorized
            p.$attribute.changingColumnName$,
$/ endif
            cast(ISNULL(CASE
                WHEN UPDATE($attribute.positingColumnName$) THEN i.$attribute.positingColumnName$
$/ if attribute.isHistorized
                WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$
$/ endif
            END, @now) as $schema.metadata.positingRange$),
            ISNULL(CASE
                WHEN UPDATE($attribute.positorColumnName$) THEN i.$attribute.positorColumnName$
                ELSE i.$schema.metadata.positorSuffix$
            END, 0),
            $schema.metadata.deleteReliability$
        FROM
            inserted i
        JOIN
            [$attribute.capsule$].[$attribute.positName$] p
        ON
            p.$attribute.identityColumnName$ = i.$attribute.identityColumnName$
        WHERE
            i.$attribute.valueColumnName$ is null
    END
$/ endif
$/ endfor
END
GO
$/ endif
$/ if nexus.attributes
-- DELETE trigger -----------------------------------------------------------------------------------------------------
-- dt_l$nexus.name$ instead of DELETE trigger on l$nexus.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$nexus.capsule$].[dt_l$nexus.name$] ON [$nexus.capsule$].[l$nexus.name$]
INSTEAD OF DELETE
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @now $schema.metadata.chronon$;
    SET @now = $schema.metadata.now$;
$/ foreach attribute in nexus.attributes
    INSERT INTO [$attribute.capsule$].[$attribute.annexName$] (
$/ if schema.METADATA
        $attribute.metadataColumnName$,
$/ endif
        $attribute.identityColumnName$,
        $attribute.positorColumnName$,
        $attribute.positingColumnName$,
        $attribute.reliabilityColumnName$
    )
    SELECT
$/ if schema.METADATA
        d.$attribute.metadataColumnName$,
$/ endif
        d.$attribute.identityColumnName$,
        d.$attribute.positorColumnName$,
        @now,
        $schema.metadata.deleteReliability$
    FROM
        deleted d
    WHERE
        d.$attribute.identityColumnName$ is not null;
$/ endfor
END
GO
$/ endif
$/ endfor
$/ endif
