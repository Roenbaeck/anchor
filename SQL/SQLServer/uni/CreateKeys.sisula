$/ if schema.naturalKeys
-- NATURAL KEYS -------------------------------------------------------------------------------------------------------
--
-- A natural key is a route in the model: the values that identify an anchor or a nexus, reached from it through its
-- attributes, its roles and ties (see naturalKeys() in Helpers.js for the rules a route follows). For each route of
-- each anchor and nexus there is
--
--   key_<anchor or nexus>_<route>          the key of every identity, from the latest values, with one column for
--                                          each value; a value with a checksum, such as a geography, is followed by
--                                          its checksum, which is what it is matched on
--   pkey_<anchor or nexus>_<route>(time)   the key of every identity at a changing time, for a route that passes
--                                          something historized, since its key can change
--   ic_key_<anchor or nexus>_<route>       the keys that more than one identity has, and the identities that have
--                                          more than one key; a view that returns nothing has nothing wrong
$/ if schema.NATURAL_KEY_ATTRIBUTES
--   <anchor or nexus>_<route>              a table with the key of every identity that has all of its values, and a
--   refresh_<anchor or nexus>_<route>      procedure that fills it from the key view; its unique constraint makes the
--                                          procedure fail when two identities have the same key, and it can be indexed
$/ endif
$/ if schema.CRT
--
-- Every key is per positor, as the perspectives are.
$/ endif
--
$/ foreach key in schema.naturalKeys
$/ if key.usable
-- Key view -----------------------------------------------------------------------------------------------------------
-- $key.route$ key of $key.entityName$
$/ foreach note in key.notes
-- Note: $|note.text|$
$/ endfor
-----------------------------------------------------------------------------------------------------------------------
IF Object_ID('$key.capsule$.$key.name$', 'V') IS NOT NULL
DROP VIEW [$key.capsule$].[$key.name$];
GO
CREATE VIEW [$key.capsule$].[$key.name$] AS
SELECT
$/ if schema.CRT
$/ if key.perspective
    [$key.of$].$schema.metadata.positorSuffix$,
$/ else
    p.$schema.metadata.positorSuffix$,
$/ endif
$/ endif
    [$key.of$].$key.identityColumnName$,
$/ foreach column in key.columns
    [$column.alias$].$column.source$ AS $column.name$$/ if not column.last() ,$/ endif
$/ endfor
FROM
$/ if key.perspective
    [$key.capsule$].[l$key.entityName$] [$key.of$]
$/ else
$/ if schema.CRT
    [$schema.metadata.encapsulation$].[_$schema.metadata.positorSuffix$] p
CROSS JOIN
$/ endif
    [$key.capsule$].[$key.entityName$] [$key.of$]
$/ endif
$/ foreach join in key.joins
LEFT JOIN
$/ if join.perspective
    [$join.capsule$].[l$join.name$] [$join.alias$]
$/ else
    [$join.capsule$].[$join.name$] [$join.alias$]
$/ endif
ON
    [$join.alias$].$join.column$ = [$join.fromAlias$].$join.fromColumn$
$/ if schema.CRT and join.perspective
AND
$/ if key.perspective
    [$join.alias$].$schema.metadata.positorSuffix$ = [$key.of$].$schema.metadata.positorSuffix$
$/ else
    [$join.alias$].$schema.metadata.positorSuffix$ = p.$schema.metadata.positorSuffix$
$/ endif
$/ endif
$/ endfor
;
GO
$/ if key.historized
-- Point-in-time key --------------------------------------------------------------------------------------------------
-- $key.route$ key of $key.entityName$ at a changing time
-----------------------------------------------------------------------------------------------------------------------
IF Object_ID('$key.capsule$.$key.pointInTimeName$', 'IF') IS NOT NULL
DROP FUNCTION [$key.capsule$].[$key.pointInTimeName$];
GO
CREATE FUNCTION [$key.capsule$].[$key.pointInTimeName$] (
    @changingTimepoint $schema.metadata.chronon$
)
RETURNS TABLE AS RETURN
SELECT
$/ if schema.CRT
$/ if key.perspective
    [$key.of$].$schema.metadata.positorSuffix$,
$/ else
    p.$schema.metadata.positorSuffix$,
$/ endif
$/ endif
    [$key.of$].$key.identityColumnName$,
$/ foreach column in key.columns
    [$column.alias$].$column.source$ AS $column.name$$/ if not column.last() ,$/ endif
$/ endfor
FROM
$/ if key.perspective
    [$key.capsule$].[p$key.entityName$](@changingTimepoint) [$key.of$]
$/ else
$/ if schema.CRT
    [$schema.metadata.encapsulation$].[_$schema.metadata.positorSuffix$] p
CROSS JOIN
$/ endif
    [$key.capsule$].[$key.entityName$] [$key.of$]
$/ endif
$/ foreach join in key.joins
LEFT JOIN
$/ if join.perspective
    [$join.capsule$].[p$join.name$](@changingTimepoint) [$join.alias$]
$/ else
    [$join.capsule$].[$join.name$] [$join.alias$]
$/ endif
ON
    [$join.alias$].$join.column$ = [$join.fromAlias$].$join.fromColumn$
$/ if schema.CRT and join.perspective
AND
$/ if key.perspective
    [$join.alias$].$schema.metadata.positorSuffix$ = [$key.of$].$schema.metadata.positorSuffix$
$/ else
    [$join.alias$].$schema.metadata.positorSuffix$ = p.$schema.metadata.positorSuffix$
$/ endif
$/ endif
$/ endfor
;
GO
$/ endif
-- Key integrity ------------------------------------------------------------------------------------------------------
-- $key.route$ key of $key.entityName$
-----------------------------------------------------------------------------------------------------------------------
IF Object_ID('$key.capsule$.$key.checkName$', 'V') IS NOT NULL
DROP VIEW [$key.capsule$].[$key.checkName$];
GO
CREATE VIEW [$key.capsule$].[$key.checkName$] AS
SELECT
    '$key.name$' AS Construct,
    'duplicate natural key' AS Violation,
    (
        SELECT
$/ if schema.CRT
            d.$schema.metadata.positorSuffix$,
$/ endif
$/ foreach match in key.matches
            d.$match.name$$/ if not match.last() ,$/ endif
$/ endfor
        FOR JSON PATH, WITHOUT_ARRAY_WRAPPER
    ) AS ViolationKey,
    d.Occurrences
FROM (
    SELECT
$/ if schema.CRT
        $schema.metadata.positorSuffix$,
$/ endif
$/ foreach match in key.matches
        $match.name$,
$/ endfor
        COUNT(DISTINCT $key.identityColumnName$) AS Occurrences
    FROM
        [$key.capsule$].[$key.name$]
    WHERE
$/ foreach match in key.matches
$/ if not match.first()
    AND
$/ endif
        $match.name$ is not null
$/ endfor
    GROUP BY
$/ if schema.CRT
        $schema.metadata.positorSuffix$,
$/ endif
$/ foreach match in key.matches
        $match.name$$/ if not match.last() ,$/ endif
$/ endfor
    HAVING
        COUNT(DISTINCT $key.identityColumnName$) > 1
) d
UNION ALL
SELECT
    '$key.name$',
    'more than one natural key',
    (
        SELECT
$/ if schema.CRT
            d.$schema.metadata.positorSuffix$,
$/ endif
            d.$key.identityColumnName$
        FOR JSON PATH, WITHOUT_ARRAY_WRAPPER
    ),
    d.Occurrences
FROM (
    SELECT
$/ if schema.CRT
        $schema.metadata.positorSuffix$,
$/ endif
        $key.identityColumnName$,
        COUNT(*) AS Occurrences
    FROM
        [$key.capsule$].[$key.name$]
    GROUP BY
$/ if schema.CRT
        $schema.metadata.positorSuffix$,
$/ endif
        $key.identityColumnName$
    HAVING
        COUNT(*) > 1
) d;
GO
$/ if schema.NATURAL_KEY_ATTRIBUTES
$/ if key.indexable
-- Key table ----------------------------------------------------------------------------------------------------------
-- $key.route$ key of $key.entityName$, filled by $key.refreshName$
-----------------------------------------------------------------------------------------------------------------------
IF Object_ID('$key.capsule$.$key.tableName$', 'U') IS NOT NULL
DROP TABLE [$key.capsule$].[$key.tableName$];
GO
CREATE TABLE [$key.capsule$].[$key.tableName$] (
$/ if schema.CRT
    $schema.metadata.positorSuffix$ $schema.metadata.positorRange$ not null,
$/ endif
    $key.identityColumnName$ $key.identity$ not null,
$/ foreach column in key.columns
    $column.name$ $column.type$ not null,
$/ endfor
    constraint pk$key.tableName$ primary key (
$/ if schema.CRT
        $schema.metadata.positorSuffix$,
$/ endif
        $key.identityColumnName$
    ),
    constraint uq$key.tableName$ unique (
$/ if schema.CRT
        $schema.metadata.positorSuffix$,
$/ endif
$/ foreach match in key.matches
        $match.name$$/ if not match.last() ,$/ endif
$/ endfor
    )
);
GO
IF Object_ID('$key.capsule$.$key.refreshName$', 'P') IS NOT NULL
DROP PROCEDURE [$key.capsule$].[$key.refreshName$];
GO
CREATE PROCEDURE [$key.capsule$].[$key.refreshName$] AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;
    BEGIN TRANSACTION;
    DELETE FROM [$key.capsule$].[$key.tableName$];
    INSERT INTO [$key.capsule$].[$key.tableName$] (
$/ if schema.CRT
        $schema.metadata.positorSuffix$,
$/ endif
        $key.identityColumnName$,
$/ foreach column in key.columns
        $column.name$$/ if not column.last() ,$/ endif
$/ endfor
    )
    SELECT
$/ if schema.CRT
        $schema.metadata.positorSuffix$,
$/ endif
        $key.identityColumnName$,
$/ foreach column in key.columns
        $column.name$$/ if not column.last() ,$/ endif
$/ endfor
    FROM
        [$key.capsule$].[$key.name$]
    WHERE
$/ foreach match in key.matches
$/ if not match.first()
    AND
$/ endif
        $match.name$ is not null
$/ endfor
    ;
    COMMIT;
END
GO
$/ else
-- The $key.route$ key of $key.entityName$ has no key table: $key.unindexable$ is a (max) type, which a unique index cannot
-- hold; give its attribute a checksum.
$/ endif
$/ endif
$/ else
-- The $key.route$ key of $key.entityName$ is not generated: $|key.problem|$
$/ endif
$/ endfor
$/ endif
