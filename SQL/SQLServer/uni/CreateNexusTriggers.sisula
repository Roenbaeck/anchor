$/ if schema.TRIGGERS
-- NEXUS TRIGGERS ---------------------------------------------------------------------------------------------------
--
-- The following triggers on the latest nexus perspective make it behave like a table for CRUD
-- operations over the nexus and its attributes. A nexus base row is immutable apart from its metadata dummy column;
-- historization only applies to its historized attributes (the base row has no changing column). Roles (anchor/nexus
-- /knot foreign keys) are part of the immutable nexus identity row and therefore are not updatable once set.
--
-- Three INSTEAD OF triggers are created when a nexus has attributes: insert, update, delete.
-- Insert: creates base nexus rows for NULL identity inputs and inserts attribute rows (knotted or not) with defaults.
-- Update: only allows changing attribute values (including knotted values); role foreign keys and identity are not
-- updatable. Historized attributes get a new version row; non-historized ones behave idempotently.
-- Delete: deletes attribute rows and conditionally deletes the base nexus row if it becomes orphaned (no attributes).
--
-- Deletable attributes (soft delete semantics) follow the same pattern as anchors: if attribute value set to NULL and
-- deletable flag = 1, a deletion record is stored in a parallel deletion table capturing deletion time.
--
$/ foreach nexus in schema.nexuses
$/ if nexus.attributes
-- Insert trigger -----------------------------------------------------------------------------------------------------
-- it_l$nexus.name$ instead of INSERT trigger on l$nexus.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$nexus.capsule$].[it_l$nexus.name$] ON [$nexus.capsule$].[l$nexus.name$]
INSTEAD OF INSERT
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @now $schema.metadata.chronon$;
    SET @now = $schema.metadata.now$;
    DECLARE @$nexus.mnemonic$ TABLE (
        Row bigint IDENTITY(1,1) not null primary key,
        $nexus.identityColumnName$ $nexus.identity$ not null
    );
    INSERT INTO [$nexus.capsule$].[$nexus.name$] (
        $/ if schema.METADATA $nexus.metadataColumnName$ $/ else $nexus.dummyColumnName$$/ endif
    )
    OUTPUT
        inserted.$nexus.identityColumnName$
    INTO
        @$nexus.mnemonic$
    SELECT
        $/ if schema.METADATA $nexus.metadataColumnName$ $/ else null$/ endif
    FROM
        inserted
    WHERE
        inserted.$nexus.identityColumnName$ is null;
    DECLARE @inserted TABLE (
        $nexus.identityColumnName$ $nexus.identity$ not null,
$/ if schema.METADATA
        $nexus.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
$/ foreach attribute in nexus.attributes
$/ if schema.IMPROVED
        $attribute.entityReferenceName$ $nexus.identity$ null,
$/ endif
$/ if schema.METADATA
        $attribute.metadataColumnName$ $schema.metadata.metadataType$ null,
$/ endif
$/ if attribute.timeRange
        $attribute.changingColumnName$ $attribute.timeRange$ null,
$/ endif
$/ if attribute.isEquivalent
        $attribute.equivalentColumnName$ $schema.metadata.equivalentRange$ null,
$/ endif
$/ if attribute.isKnotted
        $attribute.knotValueColumnName$ $attribute.knot.dataRange$ null,
$/ if attribute.knot.hasChecksum
        $attribute.knotChecksumColumnName$ varbinary(16) null,
$/ endif
$/ if attribute.knot.isEquivalent
        $attribute.equivalentKnotColumnName$ $schema.metadata.equivalentRange$ null,
$/ endif
$/ if schema.METADATA
        $attribute.knotMetadataColumnName$ $schema.metadata.metadataType$ null,
$/ endif
        $attribute.valueColumnName$ $attribute.knot.identity$ null$/ if not attribute.last() ,$/ endif
$/ else
$/ if attribute.encryptionGroup
        $attribute.valueColumnName$ $attribute.originalDataRange$ null$/ if not attribute.last() ,$/ endif
$/ else
        $attribute.valueColumnName$ $attribute.dataRange$ null$/ if not attribute.last() ,$/ endif
$/ endif
$/ endif
$/ endfor
    );
    INSERT INTO @inserted
    SELECT
        ISNULL(i.$nexus.identityColumnName$, a.$nexus.identityColumnName$),
$/ if schema.METADATA
        i.$nexus.metadataColumnName$,
$/ endif
$/ foreach attribute in nexus.attributes
$/ if schema.IMPROVED
        ISNULL(ISNULL(i.$attribute.entityReferenceName$, i.$nexus.identityColumnName$), a.$nexus.identityColumnName$),
$/ endif
$/ if schema.METADATA
        ISNULL(i.$attribute.metadataColumnName$, i.$nexus.metadataColumnName$),
$/ endif
$/ if attribute.timeRange
        ISNULL(i.$attribute.changingColumnName$, @now),
$/ endif
$/ if attribute.isEquivalent
        ISNULL(i.$attribute.equivalentColumnName$, 0),
$/ endif
$/ if attribute.isKnotted
        i.$attribute.knotValueColumnName$,
$/ if attribute.knot.hasChecksum
        ISNULL(i.$attribute.knotChecksumColumnName$, $schema.metadata.encapsulation$.MD5(cast(i.$attribute.knotValueColumnName$ as varbinary(max)))),
$/ endif
$/ if attribute.knot.isEquivalent
        ISNULL(i.$attribute.equivalentKnotColumnName$, 0),
$/ endif
$/ if schema.METADATA
        ISNULL(i.$attribute.knotMetadataColumnName$, i.$nexus.metadataColumnName$),
$/ endif
$/ endif
        i.$attribute.valueColumnName$$/ if not attribute.last() ,$/ endif
$/ endfor
    FROM (
        SELECT
            $nexus.identityColumnName$,
$/ if schema.METADATA
            $nexus.metadataColumnName$,
$/ endif
$/ foreach attribute in nexus.attributes
$/ if schema.IMPROVED
            $attribute.entityReferenceName$,
$/ endif
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
$/ if attribute.timeRange
            $attribute.changingColumnName$,
$/ endif
$/ if attribute.isEquivalent
            $attribute.equivalentColumnName$,
$/ endif
$/ if attribute.isKnotted
            $attribute.knotValueColumnName$,
$/ if attribute.knot.hasChecksum
            $attribute.knotChecksumColumnName$,
$/ endif
$/ if attribute.knot.isEquivalent
            $attribute.equivalentKnotColumnName$,
$/ endif
$/ if schema.METADATA
            $attribute.knotMetadataColumnName$,
$/ endif
$/ endif
            $attribute.valueColumnName$,
$/ endfor
            ROW_NUMBER() OVER (PARTITION BY $nexus.identityColumnName$ ORDER BY $nexus.identityColumnName$) AS Row
        FROM
            inserted
    ) i
    LEFT JOIN
        @$nexus.mnemonic$ a
    ON
        a.Row = i.Row;
$/ foreach attribute in nexus.attributes
    INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
        $attribute.metadataColumnName$,
$/ endif
        $attribute.entityReferenceName$,
$/ if attribute.timeRange
        $attribute.changingColumnName$,
$/ endif
        $attribute.valueColumnName$
    )
    SELECT $/ if not attribute.hasChecksum DISTINCT$/ endif
$/ if schema.METADATA
        i.$attribute.metadataColumnName$,
$/ endif
        i.$attribute.entityReferenceName$,
$/ if attribute.timeRange
        i.$attribute.changingColumnName$,
$/ endif
$/ if attribute.encryptionGroup
        ENCRYPTBYKEY(KEY_GUID('$attribute.encryptionGroup$'), cast(i.$attribute.valueColumnName$ as varbinary(max))) $--$
$/ else
        $/ if attribute.isKnotted ISNULL(i.$attribute.valueColumnName$, [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$) $/ else i.$attribute.valueColumnName$$/ endif
$/ endif
    FROM
        @inserted i
$/ if attribute.isKnotted
    LEFT JOIN
        [$attribute.knot.capsule$].[$attribute.knot.name$] [k$attribute.knot.mnemonic$]
    ON
        $/ if attribute.knot.hasChecksum [k$attribute.knot.mnemonic$].$attribute.knot.checksumColumnName$ = i.$attribute.knotChecksumColumnName$ $/ else [k$attribute.knot.mnemonic$].$attribute.knot.valueColumnName$ = i.$attribute.knotValueColumnName$$/ endif
$/ if attribute.knot.isEquivalent
    AND
        [k$attribute.knot.mnemonic$].$attribute.knot.equivalentColumnName$ = i.$attribute.equivalentKnotColumnName$
$/ endif
    WHERE
        ISNULL(i.$attribute.valueColumnName$, [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$) is not null;
$/ else
    WHERE
        i.$attribute.valueColumnName$ is not null;
$/ endif
$/ endfor
END
GO
-- UPDATE trigger -----------------------------------------------------------------------------------------------------
-- ut_l$nexus.name$ instead of UPDATE trigger on l$nexus.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$nexus.capsule$].[ut_l$nexus.name$] ON [$nexus.capsule$].[l$nexus.name$]
INSTEAD OF UPDATE
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @now $schema.metadata.chronon$;
    SET @now = $schema.metadata.now$;
    IF(UPDATE($nexus.identityColumnName$))
        RAISERROR('The identity column $nexus.identityColumnName$ is not updatable.', 16, 1);
$/ foreach attribute in nexus.attributes
    IF(UPDATE($attribute.entityReferenceName$))
        RAISERROR('The foreign key column $attribute.entityReferenceName$ is not updatable.', 16, 1);
$/ if attribute.isKnotted
    IF(UPDATE($attribute.valueColumnName$) OR UPDATE($attribute.knotValueColumnName$))
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.valueColumnName$
        )
        SELECT $/ if not attribute.hasChecksum DISTINCT$/ endif
$/ if schema.METADATA
            ISNULL(CASE
                WHEN UPDATE($nexus.metadataColumnName$) AND NOT UPDATE($attribute.metadataColumnName$)
                THEN i.$nexus.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$nexus.metadataColumnName$),
$/ endif
            ISNULL(i.$attribute.entityReferenceName$, i.$nexus.identityColumnName$),
$/ if attribute.isHistorized
            cast(ISNULL(CASE
                WHEN i.$attribute.valueColumnName$ is null AND [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$ is null THEN i.$attribute.changingColumnName$
                WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$
            END, @now) as $attribute.timeRange$),
$/ endif
            CASE WHEN UPDATE($attribute.valueColumnName$) THEN i.$attribute.valueColumnName$ ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$ END
        FROM
            inserted i
        LEFT JOIN
            [$attribute.knot.capsule$].[$attribute.knot.name$] [k$attribute.knot.mnemonic$]
        ON
            $/ if attribute.knot.hasChecksum [k$attribute.knot.mnemonic$].$attribute.knot.checksumColumnName$ = $schema.metadata.encapsulation$.MD5(cast(i.$attribute.knotValueColumnName$ as varbinary(max))) $/ else [k$attribute.knot.mnemonic$].$attribute.knot.valueColumnName$ = i.$attribute.knotValueColumnName$$/ endif
$/ if attribute.knot.isEquivalent
        AND
            [k$attribute.knot.mnemonic$].$attribute.knot.equivalentColumnName$ = i.$attribute.equivalentKnotColumnName$
$/ endif
        WHERE
            CASE WHEN UPDATE($attribute.valueColumnName$) THEN i.$attribute.valueColumnName$ ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$ END is not null;
$/ if attribute.isDeletable
        SELECT
$/ if attribute.isHistorized
            cast(CASE WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$ ELSE @now END as $attribute.timeRange$) as $attribute.deletionTimeColumnName$,
$/ endif
            i.$attribute.entityReferenceName$
        INTO
            #$attribute.uniqueMnemonic$
        FROM
            inserted i
        JOIN
            deleted d
        ON
            d.$attribute.entityReferenceName$ = i.$attribute.entityReferenceName$
        AND
            d.$attribute.valueColumnName$ is not null
        WHERE
            ((UPDATE($attribute.valueColumnName$) AND i.$attribute.valueColumnName$ is null) OR (UPDATE($attribute.knotValueColumnName$) AND i.$attribute.knotValueColumnName$ is null))
        AND
            i.$attribute.deletableColumnName$ = 1;
        IF(@@ROWCOUNT > 0)
        BEGIN
            IF OBJECT_ID('[$attribute.capsule$].[$attribute.deletionName$]') is null
            SELECT TOP 0 $--$
                *, $--$
                CAST(null as $/ if attribute.isHistorized $attribute.timeRange$$/ else $schema.metadata.chronon$$/ endif) as $attribute.deletionTimeColumnName$
            INTO $--$
                [$attribute.capsule$].[$attribute.deletionName$]
            FROM $--$
                [$attribute.capsule$].[$attribute.name$];
            DELETE [$attribute.mnemonic$]
            OUTPUT
                deleted.*,
                $/ if attribute.isHistorized ISNULL(d.$attribute.deletionTimeColumnName$, @now) $/ else @now$/ endif
            INTO
                [$attribute.capsule$].[$attribute.deletionName$]
            FROM
                [$attribute.capsule$].[$attribute.name$] [$attribute.mnemonic$]
            JOIN
                #$attribute.uniqueMnemonic$ d
            ON
                d.$attribute.entityReferenceName$ = [$attribute.mnemonic$].$attribute.entityReferenceName$
        END
$/ endif
    END
$/ else
    IF(UPDATE($attribute.valueColumnName$))
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
$/ if attribute.isEquivalent
            $attribute.equivalentColumnName$,
$/ endif
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.valueColumnName$
        )
        SELECT $/ if not attribute.hasChecksum DISTINCT$/ endif
$/ if schema.METADATA
            ISNULL(CASE
                WHEN UPDATE($nexus.metadataColumnName$) AND NOT UPDATE($attribute.metadataColumnName$)
                THEN i.$nexus.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$nexus.metadataColumnName$),
$/ endif
            ISNULL(i.$attribute.entityReferenceName$, i.$nexus.identityColumnName$),
$/ if attribute.isEquivalent
            i.$attribute.equivalentColumnName$,
$/ endif
$/ if attribute.isHistorized
            cast(ISNULL(CASE
                WHEN i.$attribute.valueColumnName$ is null THEN i.$attribute.changingColumnName$
                WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$
            END, @now) as $attribute.timeRange$),
$/ endif
$/ if attribute.encryptionGroup
        ENCRYPTBYKEY(KEY_GUID('$attribute.encryptionGroup$'), cast(i.$attribute.valueColumnName$ as varbinary(max))) $--$
$/ else
            i.$attribute.valueColumnName$
$/ endif
        FROM
            inserted i
        WHERE
            i.$attribute.valueColumnName$ is not null;
$/ if attribute.isDeletable
        SELECT
$/ if attribute.isHistorized
            cast(CASE WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$ ELSE @now END as $attribute.timeRange$) as $attribute.deletionTimeColumnName$,
$/ endif
            i.$attribute.entityReferenceName$
        INTO
            #$attribute.uniqueMnemonic$
        FROM
            inserted i
        JOIN
            deleted d
        ON
            d.$attribute.entityReferenceName$ = i.$attribute.entityReferenceName$
        AND
            d.$attribute.valueColumnName$ is not null
        WHERE
            i.$attribute.valueColumnName$ is null
        AND
            i.$attribute.deletableColumnName$ = 1;
        IF(@@ROWCOUNT > 0)
        BEGIN
            IF OBJECT_ID('[$attribute.capsule$].[$attribute.deletionName$]') is null
            SELECT TOP 0 $--$
                *, $--$
                CAST(null as $/ if attribute.isHistorized $attribute.timeRange$$/ else $schema.metadata.chronon$$/ endif) as $attribute.deletionTimeColumnName$
            INTO $--$
                [$attribute.capsule$].[$attribute.deletionName$]
            FROM $--$
                [$attribute.capsule$].[$attribute.name$];
            DELETE [$attribute.mnemonic$]
            OUTPUT
                deleted.*,
                $/ if attribute.isHistorized ISNULL(d.$attribute.deletionTimeColumnName$, @now) $/ else @now$/ endif
            INTO
                [$attribute.capsule$].[$attribute.deletionName$]
            FROM
                [$attribute.capsule$].[$attribute.name$] [$attribute.mnemonic$]
            JOIN
                #$attribute.uniqueMnemonic$ d
            ON
                d.$attribute.entityReferenceName$ = [$attribute.mnemonic$].$attribute.entityReferenceName$
        END
$/ endif
    END
$/ endif
$/ endfor
END
GO
-- DELETE trigger -----------------------------------------------------------------------------------------------------
-- dt_l$nexus.name$ instead of DELETE trigger on l$nexus.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$nexus.capsule$].[dt_l$nexus.name$] ON [$nexus.capsule$].[l$nexus.name$]
INSTEAD OF DELETE
AS
BEGIN
    SET NOCOUNT ON;
$/ foreach attribute in nexus.attributes
    DELETE [$attribute.mnemonic$]
    FROM
        [$attribute.capsule$].[$attribute.name$] [$attribute.mnemonic$]
    JOIN
        deleted d
    ON
$/ if attribute.isEquivalent
        d.$attribute.equivalentColumnName$ = [$attribute.mnemonic$].$attribute.equivalentColumnName$
    AND
$/ endif
$/ if attribute.timeRange
        d.$attribute.changingColumnName$ = [$attribute.mnemonic$].$attribute.changingColumnName$
    AND
$/ endif
        d.$attribute.entityReferenceName$ = [$attribute.mnemonic$].$attribute.entityReferenceName$;
$/ endfor
    DECLARE @deleted TABLE (
        $nexus.identityColumnName$ $nexus.identity$ NOT NULL PRIMARY KEY
    );
    INSERT INTO @deleted ($nexus.identityColumnName$)
    SELECT a.$nexus.identityColumnName$
    FROM (
        SELECT [$nexus.mnemonic$].$nexus.identityColumnName$
        FROM [$nexus.capsule$].[$nexus.name$] [$nexus.mnemonic$] WITH(NOLOCK)
        WHERE
$/ foreach attribute in nexus.attributes
        NOT EXISTS (
            SELECT TOP 1 $attribute.entityReferenceName$
            FROM [$attribute.capsule$].[$attribute.name$] WITH(NOLOCK)
            WHERE $attribute.entityReferenceName$ = [$nexus.mnemonic$].$nexus.identityColumnName$
        )
$/ if not attribute.last()
        AND
$/ endif
$/ endfor
    ) a
    JOIN deleted d
    ON d.$nexus.identityColumnName$ = a.$nexus.identityColumnName$;
    DELETE [$nexus.mnemonic$]
    FROM [$nexus.capsule$].[$nexus.name$] [$nexus.mnemonic$]
    JOIN @deleted d
    ON d.$nexus.identityColumnName$ = [$nexus.mnemonic$].$nexus.identityColumnName$;
END
GO
$/ endif
$/ endfor
$/ endif
