-- NEXUSES -----------------------------------------------------------------------------------------------------------
--
-- Nexuses (event-like constructs) store identities of composite event instances and are immutable.
-- (Attribute tables moved to CreateAttributes.js.)
--
$/ foreach nexus in schema.nexuses
-- Nexus table -------------------------------------------------------------------------------------------------------
-- $nexus.name$ table (with $nexus.attributeCount$ attributes and $nexus.roleCount$ roles)
-----------------------------------------------------------------------------------------------------------------------
IF Object_ID('$nexus.capsule$.$nexus.name$', 'U') IS NULL
CREATE TABLE [$nexus.capsule$].[$nexus.name$] (
$/ if nexus.isGenerator
    $nexus.identityColumnName$ $nexus.identity$ IDENTITY(1,1) not null,
$/ else
    $nexus.identityColumnName$ $nexus.identity$ not null,
$/ endif
$/ foreach role in nexus.roles
$/ if role.entity
    $role.columnName$ $role.entity.identity$ not null, $--$
$/ else
    $role.columnName$ $role.knot.identity$ not null,
$/ endif
$/ endfor
$/ foreach role in nexus.roles
    constraint $nexus.name$_fk$role.name$ foreign key (
        $role.columnName$
$/ if role.entity
    ) references [$role.entity.capsule$].[$role.entity.name$]($role.entity.identityColumnName$), $--$
$/ else
$/ if role.knot.isEquivalent
    ) references [$role.knot.capsule$].[$role.knot.identityName$]($role.knot.identityColumnName$),
$/ else
    ) references [$role.knot.capsule$].[$role.knot.name$]($role.knot.identityColumnName$),
$/ endif
$/ endif
$/ endfor
$/ if schema.METADATA
    $nexus.metadataColumnName$ $schema.metadata.metadataType$ not null, $--$
$/ else
    $nexus.dummyColumnName$ bit null,
$/ endif
    constraint pk$nexus.name$ primary key (
        $nexus.identityColumnName$ asc
    )
);
GO
$/ endfor
