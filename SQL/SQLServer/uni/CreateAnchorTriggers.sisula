$/ if schema.TRIGGERS
-- ANCHOR TRIGGERS ---------------------------------------------------------------------------------------------------
--
-- The following triggers on the latest view make it behave like a table.
-- There are three different 'instead of' triggers: insert, update, and delete.
-- They will ensure that such operations are propagated to the underlying tables
-- in a consistent way. Default values are used for some columns if not provided
-- by the corresponding SQL statements.
--
-- For idempotent attributes, only changes that represent a value different from
-- the previous or following value are stored. Others are silently ignored in
-- order to avoid unnecessary temporal duplicates.
--
$/ foreach anchor in schema.anchors
$/ if anchor.attributes
-- Insert trigger -----------------------------------------------------------------------------------------------------
-- it_l$anchor.name$ instead of INSERT trigger on l$anchor.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$anchor.capsule$].[it_l$anchor.name$] ON [$anchor.capsule$].[l$anchor.name$]
INSTEAD OF INSERT
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @now $schema.metadata.chronon$;
    SET @now = $schema.metadata.now$;
    DECLARE @$anchor.mnemonic$ TABLE (
        Row bigint IDENTITY(1,1) not null primary key,
        $anchor.identityColumnName$ $anchor.identity$ not null
    );
    INSERT INTO [$anchor.capsule$].[$anchor.name$] (
$/ if schema.METADATA
        $anchor.metadataColumnName$ $--$
$/ else
        $anchor.dummyColumnName$
$/ endif
    )
    OUTPUT
        inserted.$anchor.identityColumnName$
    INTO
        @$anchor.mnemonic$
    SELECT
$/ if schema.METADATA
        $anchor.metadataColumnName$ $--$
$/ else
        null
$/ endif
    FROM
        inserted
    WHERE
        inserted.$anchor.identityColumnName$ is null;
    DECLARE @inserted TABLE (
        $anchor.identityColumnName$ $anchor.identity$ not null,
$/ if schema.METADATA
        $anchor.metadataColumnName$ $schema.metadata.metadataType$ not null,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
        $attribute.entityReferenceName$ $anchor.identity$ null,
$/ endif
$/ if schema.METADATA
        $attribute.metadataColumnName$ $schema.metadata.metadataType$ null,
$/ endif
$/ if attribute.timeRange
        $attribute.changingColumnName$ $attribute.timeRange$ null,
$/ endif
$/ if attribute.isEquivalent
        $attribute.equivalentColumnName$ $schema.metadata.equivalentRange$ null,
$/ endif
$/ if attribute.isKnotted
        $attribute.knotValueColumnName$ $attribute.knot.dataRange$ null,
$/ if attribute.knot.hasChecksum
        $attribute.knotChecksumColumnName$ varbinary(16) null,
$/ endif
$/ if attribute.knot.isEquivalent
        $attribute.knotEquivalentColumnName$ $schema.metadata.equivalentRange$ null,
$/ endif
$/ if schema.METADATA
        $attribute.knotMetadataColumnName$ $schema.metadata.metadataType$ null,
$/ endif
        $attribute.valueColumnName$ $attribute.knot.identity$ null$/ if not attribute.last() ,$/ endif
$/ else
$/ if attribute.encryptionGroup
        $attribute.valueColumnName$ $attribute.originalDataRange$ null$/ if not attribute.last() ,$/ endif
$/ else
        $attribute.valueColumnName$ $attribute.dataRange$ null$/ if not attribute.last() ,$/ endif
$/ endif
$/ endif
$/ endfor
    );
    INSERT INTO @inserted
    SELECT
        ISNULL(i.$anchor.identityColumnName$, a.$anchor.identityColumnName$),
$/ if schema.METADATA
        i.$anchor.metadataColumnName$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
        ISNULL(ISNULL(i.$attribute.entityReferenceName$, i.$anchor.identityColumnName$), a.$anchor.identityColumnName$),
$/ endif
$/ if schema.METADATA
        ISNULL(i.$attribute.metadataColumnName$, i.$anchor.metadataColumnName$),
$/ endif
$/ if attribute.timeRange
        ISNULL(i.$attribute.changingColumnName$, @now),
$/ endif
$/ if attribute.isEquivalent
        ISNULL(i.$attribute.equivalentColumnName$, 0),
$/ endif
$/ if attribute.isKnotted
        i.$attribute.knotValueColumnName$,
$/ if attribute.knot.hasChecksum
        ISNULL(i.$attribute.knotChecksumColumnName$, $schema.metadata.encapsulation$.MD5(cast(i.$attribute.knotValueColumnName$ as varbinary(max)))),
$/ endif
$/ if attribute.knot.isEquivalent
        ISNULL(i.$attribute.knotEquivalentColumnName$, 0),
$/ endif
$/ if schema.METADATA
        ISNULL(i.$attribute.knotMetadataColumnName$, i.$anchor.metadataColumnName$),
$/ endif
$/ endif
        i.$attribute.valueColumnName$$/ if not attribute.last() ,$/ endif
$/ endfor
    FROM (
        SELECT
            $anchor.identityColumnName$,
$/ if schema.METADATA
            $anchor.metadataColumnName$,
$/ endif
$/ foreach attribute in anchor.attributes
$/ if schema.IMPROVED
            $attribute.entityReferenceName$,
$/ endif
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
$/ if attribute.timeRange
            $attribute.changingColumnName$,
$/ endif
$/ if attribute.isEquivalent
            $attribute.equivalentColumnName$,
$/ endif
$/ if attribute.isKnotted
            $attribute.knotValueColumnName$,
$/ if attribute.knot.hasChecksum
            $attribute.knotChecksumColumnName$,
$/ endif
$/ if attribute.knot.isEquivalent
            $attribute.knotEquivalentColumnName$,
$/ endif
$/ if schema.METADATA
            $attribute.knotMetadataColumnName$,
$/ endif
$/ endif
            $attribute.valueColumnName$,
$/ endfor
            ROW_NUMBER() OVER (PARTITION BY $anchor.identityColumnName$ ORDER BY $anchor.identityColumnName$) AS Row
        FROM
            inserted
    ) i
    LEFT JOIN
        @$anchor.mnemonic$ a
    ON
        a.Row = i.Row;
$/ foreach attribute in anchor.attributes
    INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
        $attribute.metadataColumnName$,
$/ endif
        $attribute.entityReferenceName$,
$/ if attribute.timeRange
        $attribute.changingColumnName$,
$/ endif
        $attribute.valueColumnName$
    )
    SELECT $/ if not attribute.hasChecksum DISTINCT$/ endif
$/ if schema.METADATA
        i.$attribute.metadataColumnName$,
$/ endif
        i.$attribute.entityReferenceName$,
$/ if attribute.timeRange
        i.$attribute.changingColumnName$,
$/ endif
$/ if attribute.encryptionGroup
        ENCRYPTBYKEY(KEY_GUID('$attribute.encryptionGroup$'), cast(i.$attribute.valueColumnName$ as varbinary(max))) $--$
$/ else
$/ if attribute.isKnotted
        ISNULL(i.$attribute.valueColumnName$, [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$) $--$
$/ else
        i.$attribute.valueColumnName$
$/ endif
$/ endif
    FROM
        @inserted i
$/ if attribute.isKnotted
    LEFT JOIN
        [$attribute.knot.capsule$].[$attribute.knot.name$] [k$attribute.knot.mnemonic$]
    ON
$/ if attribute.knot.hasChecksum
        [k$attribute.knot.mnemonic$].$attribute.knot.checksumColumnName$ = i.$attribute.knotChecksumColumnName$ $--$
$/ else
        [k$attribute.knot.mnemonic$].$attribute.knot.valueColumnName$ = i.$attribute.knotValueColumnName$
$/ endif
$/ if attribute.knot.isEquivalent
    AND
        [k$attribute.knot.mnemonic$].$attribute.knot.equivalentColumnName$ = i.$attribute.knotEquivalentColumnName$
$/ endif
    WHERE
        ISNULL(i.$attribute.valueColumnName$, [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$) is not null;
$/ else
    WHERE
        i.$attribute.valueColumnName$ is not null;
$/ endif
$/ endfor
END
GO
$/ endif
$/ if anchor.attributes
-- UPDATE trigger -----------------------------------------------------------------------------------------------------
-- ut_l$anchor.name$ instead of UPDATE trigger on l$anchor.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$anchor.capsule$].[ut_l$anchor.name$] ON [$anchor.capsule$].[l$anchor.name$]
INSTEAD OF UPDATE
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @now $schema.metadata.chronon$;
    SET @now = $schema.metadata.now$;
    IF(UPDATE($anchor.identityColumnName$))
        RAISERROR('The identity column $anchor.identityColumnName$ is not updatable.', 16, 1);
$/ foreach attribute in anchor.attributes
    IF(UPDATE($attribute.entityReferenceName$))
        RAISERROR('The foreign key column $attribute.entityReferenceName$ is not updatable.', 16, 1);
$/ if attribute.isKnotted
    IF(UPDATE($attribute.valueColumnName$) OR UPDATE($attribute.knotValueColumnName$))
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.valueColumnName$
        )
        SELECT $/ if not attribute.hasChecksum DISTINCT$/ endif
$/ if schema.METADATA
            ISNULL(CASE
                WHEN UPDATE($anchor.metadataColumnName$) AND NOT UPDATE($attribute.metadataColumnName$)
                THEN i.$anchor.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$anchor.metadataColumnName$),
$/ endif
            ISNULL(i.$attribute.entityReferenceName$, i.$anchor.identityColumnName$),
$/ if attribute.isHistorized
            cast(ISNULL(CASE
                WHEN i.$attribute.valueColumnName$ is null AND [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$ is null THEN i.$attribute.changingColumnName$
                WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$
            END, @now) as $attribute.timeRange$),
$/ endif
            CASE WHEN UPDATE($attribute.valueColumnName$) THEN i.$attribute.valueColumnName$ ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$ END
        FROM
            inserted i
        LEFT JOIN
            [$attribute.knot.capsule$].[$attribute.knot.name$] [k$attribute.knot.mnemonic$]
        ON
$/ if attribute.knot.hasChecksum
            [k$attribute.knot.mnemonic$].$attribute.knot.checksumColumnName$ = $schema.metadata.encapsulation$.MD5(cast(i.$attribute.knotValueColumnName$ as varbinary(max))) $--$
$/ else
            [k$attribute.knot.mnemonic$].$attribute.knot.valueColumnName$ = i.$attribute.knotValueColumnName$
$/ endif
$/ if attribute.knot.isEquivalent
        AND
$/ endif
$/ if attribute.knot.isEquivalent
            [k$attribute.knot.mnemonic$].$attribute.knot.equivalentColumnName$ = i.$attribute.knotEquivalentColumnName$
$/ endif
        WHERE
            CASE WHEN UPDATE($attribute.valueColumnName$) THEN i.$attribute.valueColumnName$ ELSE [k$attribute.knot.mnemonic$].$attribute.knot.identityColumnName$ END is not null;
$/ if attribute.isDeletable
        SELECT
$/ if attribute.isHistorized
            cast(CASE WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$ ELSE @now END as $attribute.timeRange$) as $attribute.deletionTimeColumnName$,
$/ endif
            i.$attribute.entityReferenceName$
        INTO
            #$attribute.uniqueMnemonic$
        FROM
            inserted i
        JOIN
            deleted d
        ON
            d.$attribute.entityReferenceName$ = i.$attribute.entityReferenceName$
        AND
            d.$attribute.valueColumnName$ is not null
        WHERE
            ((UPDATE($attribute.valueColumnName$) AND i.$attribute.valueColumnName$ is null) OR (UPDATE($attribute.knotValueColumnName$) AND i.$attribute.knotValueColumnName$ is null))
        AND
            i.$attribute.deletableColumnName$ = 1;
        IF(@@ROWCOUNT > 0)
        BEGIN
            IF OBJECT_ID('[$attribute.capsule$].[$attribute.deletionName$]') is null
            SELECT TOP 0 $--$
                *, $--$
                CAST(null as $/ if attribute.isHistorized $attribute.timeRange$$/ else $schema.metadata.chronon$$/ endif) as $attribute.deletionTimeColumnName$
            INTO $--$
                [$attribute.capsule$].[$attribute.deletionName$]
            FROM $--$
                [$attribute.capsule$].[$attribute.name$];
            DELETE [$attribute.mnemonic$]
            OUTPUT
                deleted.*,
$/ if attribute.isHistorized
                ISNULL(d.$attribute.deletionTimeColumnName$, @now) $--$
$/ else
                @now
$/ endif
            INTO
                [$attribute.capsule$].[$attribute.deletionName$]
            FROM
                [$attribute.capsule$].[$attribute.name$] [$attribute.mnemonic$]
            JOIN
                #$attribute.uniqueMnemonic$ d
            ON
                d.$attribute.entityReferenceName$ = [$attribute.mnemonic$].$attribute.entityReferenceName$
        END
$/ endif
    END
$/ else
    IF(UPDATE($attribute.valueColumnName$))
    BEGIN
        INSERT INTO [$attribute.capsule$].[$attribute.name$] (
$/ if schema.METADATA
            $attribute.metadataColumnName$,
$/ endif
            $attribute.entityReferenceName$,
$/ if attribute.isEquivalent
            $attribute.equivalentColumnName$,
$/ endif
$/ if attribute.isHistorized
            $attribute.changingColumnName$,
$/ endif
            $attribute.valueColumnName$
        )
        SELECT $/ if not attribute.hasChecksum DISTINCT$/ endif
$/ if schema.METADATA
            ISNULL(CASE
                WHEN UPDATE($anchor.metadataColumnName$) AND NOT UPDATE($attribute.metadataColumnName$)
                THEN i.$anchor.metadataColumnName$
                ELSE i.$attribute.metadataColumnName$
            END, i.$anchor.metadataColumnName$),
$/ endif
            ISNULL(i.$attribute.entityReferenceName$, i.$anchor.identityColumnName$),
$/ if attribute.isEquivalent
            i.$attribute.equivalentColumnName$,
$/ endif
$/ if attribute.isHistorized
            cast(ISNULL(CASE
                WHEN i.$attribute.valueColumnName$ is null THEN i.$attribute.changingColumnName$
                WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$
            END, @now) as $attribute.timeRange$),
$/ endif
$/ if attribute.encryptionGroup
        ENCRYPTBYKEY(KEY_GUID('$attribute.encryptionGroup$'), cast(i.$attribute.valueColumnName$ as varbinary(max))) $--$
$/ else
            i.$attribute.valueColumnName$
$/ endif
        FROM
            inserted i
        WHERE
            i.$attribute.valueColumnName$ is not null;
$/ if attribute.isDeletable
        SELECT
$/ if attribute.isHistorized
            cast(CASE WHEN UPDATE($attribute.changingColumnName$) THEN i.$attribute.changingColumnName$ ELSE @now END as $attribute.timeRange$) as $attribute.deletionTimeColumnName$,
$/ endif
            i.$attribute.entityReferenceName$
        INTO
            #$attribute.uniqueMnemonic$
        FROM
            inserted i
        JOIN
            deleted d
        ON
            d.$attribute.entityReferenceName$ = i.$attribute.entityReferenceName$
        AND
            d.$attribute.valueColumnName$ is not null
        WHERE
            i.$attribute.valueColumnName$ is null
        AND
            i.$attribute.deletableColumnName$ = 1;
        IF(@@ROWCOUNT > 0)
        BEGIN
            IF OBJECT_ID('[$attribute.capsule$].[$attribute.deletionName$]') is null
            SELECT TOP 0 $--$
                *, $--$
                CAST(null as $/ if attribute.isHistorized $attribute.timeRange$$/ else $schema.metadata.chronon$$/ endif) as $attribute.deletionTimeColumnName$
            INTO $--$
                [$attribute.capsule$].[$attribute.deletionName$]
            FROM $--$
                [$attribute.capsule$].[$attribute.name$];
            DELETE [$attribute.mnemonic$]
            OUTPUT
                deleted.*,
$/ if attribute.isHistorized
                ISNULL(d.$attribute.deletionTimeColumnName$, @now) $--$
$/ else
                @now
$/ endif
            INTO
                [$attribute.capsule$].[$attribute.deletionName$]
            FROM
                [$attribute.capsule$].[$attribute.name$] [$attribute.mnemonic$]
            JOIN
                #$attribute.uniqueMnemonic$ d
            ON
                d.$attribute.entityReferenceName$ = [$attribute.mnemonic$].$attribute.entityReferenceName$
        END
$/ endif
    END
$/ endif
$/ endfor
END
GO
$/ endif
$/ if anchor.attributes
-- DELETE trigger -----------------------------------------------------------------------------------------------------
-- dt_l$anchor.name$ instead of DELETE trigger on l$anchor.name$
-----------------------------------------------------------------------------------------------------------------------
CREATE TRIGGER [$anchor.capsule$].[dt_l$anchor.name$] ON [$anchor.capsule$].[l$anchor.name$]
INSTEAD OF DELETE
AS
BEGIN
    SET NOCOUNT ON;
$/ foreach attribute in anchor.attributes
    DELETE [$attribute.mnemonic$]
    FROM
        [$attribute.capsule$].[$attribute.name$] [$attribute.mnemonic$]
    JOIN
        deleted d
    ON
$/ if attribute.isEquivalent
        d.$attribute.equivalentColumnName$ = [$attribute.mnemonic$].$attribute.equivalentColumnName$
$/ endif
$/ if attribute.isEquivalent
    AND
$/ endif
$/ if attribute.timeRange
        d.$attribute.changingColumnName$ = [$attribute.mnemonic$].$attribute.changingColumnName$
$/ endif
$/ if attribute.timeRange
    AND
$/ endif
        d.$attribute.entityReferenceName$ = [$attribute.mnemonic$].$attribute.entityReferenceName$;
$/ endfor
    DECLARE @deleted TABLE (
        $anchor.identityColumnName$ $anchor.identity$ NOT NULL PRIMARY KEY
    );
    INSERT INTO @deleted ($anchor.identityColumnName$)
    SELECT a.$anchor.identityColumnName$
    FROM (
        SELECT [$anchor.mnemonic$].$anchor.identityColumnName$
        FROM [$anchor.capsule$].[$anchor.name$] [$anchor.mnemonic$] WITH(NOLOCK)
$/ if anchor.attributes
        WHERE
$/ endif
$/ foreach attribute in anchor.attributes
        NOT EXISTS (
            SELECT TOP 1 $attribute.entityReferenceName$
            FROM [$attribute.capsule$].[$attribute.name$] WITH(NOLOCK)
            WHERE $attribute.entityReferenceName$ = [$anchor.mnemonic$].$anchor.identityColumnName$
        )
$/ if not attribute.last()
        AND
$/ endif
$/ endfor
    ) a
    JOIN deleted d
    ON d.$anchor.identityColumnName$ = a.$anchor.identityColumnName$;
    DELETE [$anchor.mnemonic$]
    FROM [$anchor.capsule$].[$anchor.name$] [$anchor.mnemonic$]
    JOIN @deleted d
    ON d.$anchor.identityColumnName$ = [$anchor.mnemonic$].$anchor.identityColumnName$;
END
GO
$/ endif
$/ endfor
$/ endif
