-- NEXUS TEMPORAL PERSPECTIVES ----------------------------------------------------------------------------------------
--
-- BigQuery CRT nexus perspectives: time traveling (t), latest (l), point-in-time (p),
-- now (n), and difference (d).
--
$/ foreach nexus in schema.nexuses
$/ if nexus.attributes
-- Time traveling perspective -----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE TABLE FUNCTION $nexus.capsule$.`t$nexus.name$` (
    positor $schema.metadata.positorRange$,
    changingTimepoint $schema.metadata.chronon$,
    positingTimepoint $schema.metadata.positingRange$,
    assertion string
)
AS (
SELECT
    `$nexus.mnemonic$`.`$nexus.identityColumnName$`,
$/ if schema.METADATA
    `$nexus.mnemonic$`.`$nexus.metadataColumnName$`,
$/ endif
$/ foreach role in nexus.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    `k$role.name$`.`$role.knot.checksumColumnName$` AS `$role.knotChecksumColumnName$`,
$/ endif
    `k$role.name$`.`$role.knot.valueColumnName$` AS `$role.knotValueColumnName$`,
$/ if schema.METADATA
    `k$role.name$`.`$role.knot.metadataColumnName$` AS `$role.knotMetadataColumnName$`,
$/ endif
$/ endif
    `$nexus.mnemonic$`.`$role.columnName$`,
$/ endfor
$/ foreach attribute in nexus.attributes
$/ if schema.IMPROVED
    `$attribute.mnemonic$`.`$attribute.entityReferenceName$`,
$/ endif
$/ if schema.METADATA
    `$attribute.mnemonic$`.`$attribute.metadataColumnName$`,
$/ endif
    `$attribute.mnemonic$`.`$attribute.identityColumnName$`,
$/ if attribute.timeRange
    `$attribute.mnemonic$`.`$attribute.changingColumnName$`,
$/ endif
    `$attribute.mnemonic$`.`$attribute.positingColumnName$`,
    `$attribute.mnemonic$`.`$attribute.positorColumnName$`,
    `$attribute.mnemonic$`.`$attribute.reliabilityColumnName$`,
    `$attribute.mnemonic$`.`$attribute.assertionColumnName$`,
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    `$attribute.mnemonic$`.`$attribute.knotChecksumColumnName$`,
$/ endif
    `$attribute.mnemonic$`.`$attribute.knotValueColumnName$`,
$/ if schema.METADATA
    `$attribute.mnemonic$`.`$attribute.knotMetadataColumnName$`,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    `$attribute.mnemonic$`.`$attribute.checksumColumnName$`,
$/ endif
    `$attribute.mnemonic$`.`$attribute.valueColumnName$`$/ if not attribute.last() ,$/ endif
$/ endfor
FROM
    $nexus.capsule$.`$nexus.name$` `$nexus.mnemonic$`
-- the views of all positors are worked out, and the one asked for is picked last: the latest, point-in-time and now
-- perspectives call this one for each positor, and BigQuery cannot do that when the positor is used before a window
-- or in an outer join (so a positor has to be in the table of positors to be shown)
CROSS JOIN
    $schema.metadata.encapsulation$.`_$schema.metadata.positorSuffix$` p
$/ foreach role in nexus.knotRoles
LEFT JOIN
    $role.knot.capsule$.`$role.knot.name$` `k$role.name$`
ON
    `k$role.name$`.`$role.knot.identityColumnName$` = `$nexus.mnemonic$`.`$role.columnName$`
$/ endfor
$/ foreach attribute in nexus.attributes
LEFT JOIN (
$/ if attribute.isKnotted
    -- the knot joined in here, since BigQuery cannot call this function for each positor with it joined outside
    SELECT
        y.*,
$/ if attribute.knot.hasChecksum
        k.`$attribute.knot.checksumColumnName$` AS `$attribute.knotChecksumColumnName$`,
$/ endif
$/ if schema.METADATA
        k.`$attribute.knot.metadataColumnName$` AS `$attribute.knotMetadataColumnName$`,
$/ endif
        k.`$attribute.knot.valueColumnName$` AS `$attribute.knotValueColumnName$`
    FROM (
$/ endif
    -- the posit in effect for each nexus and positor, picked by a window: BigQuery cannot evaluate a subquery that
    -- refers to the outer row and takes the first row of an ordering
    SELECT
        x.*
    FROM (
        SELECT
            r.*$/ if attribute.isHistorized ,$/ endif
$/ if attribute.isHistorized
            -- the latest changing time with an assertion that is not a retraction, which supersedes those before it
            -- whatever its sign
            max(IF(r.`$attribute.assertionColumnName$` <> '?', r.`$attribute.changingColumnName$`, null)) OVER (
                PARTITION BY r.`$attribute.positorColumnName$`, r.`$attribute.entityReferenceName$`
            ) AS `inEffect`
$/ endif
        FROM
            $attribute.capsule$.`r$attribute.name$`(
                CAST(null AS $schema.metadata.positorRange$),
$/ if attribute.isHistorized
                CAST(changingTimepoint AS $attribute.timeRange$),
$/ endif
                CAST(positingTimepoint AS $schema.metadata.positingRange$)
            ) r
    ) x
    WHERE
        x.`$attribute.assertionColumnName$` = coalesce(assertion, x.`$attribute.assertionColumnName$`)
$/ if attribute.isHistorized
    AND ( -- asked for positive or negative assertions, only those at that changing time
        coalesce(assertion, '?') = '?'
    OR
        x.`$attribute.changingColumnName$` = x.`inEffect`
    )
$/ endif
    QUALIFY
        row_number() OVER (
            PARTITION BY x.`$attribute.positorColumnName$`, x.`$attribute.entityReferenceName$`
            ORDER BY
$/ if attribute.isHistorized
                x.`$attribute.changingColumnName$` DESC,
$/ endif
                x.`$attribute.positingColumnName$` DESC,
                x.`$attribute.reliabilityColumnName$` DESC
        ) = 1
$/ if attribute.isKnotted
    ) y
    LEFT JOIN
        $attribute.knot.capsule$.`$attribute.knot.name$` k
    ON
        k.`$attribute.knot.identityColumnName$` = y.`$attribute.knotReferenceName$`
$/ endif
) `$attribute.mnemonic$`
ON
    `$attribute.mnemonic$`.`$attribute.entityReferenceName$` = `$nexus.mnemonic$`.`$nexus.identityColumnName$`
AND
    `$attribute.mnemonic$`.`$attribute.positorColumnName$` = p.`$schema.metadata.positorSuffix$`
$/ endfor
WHERE
    p.`$schema.metadata.positorSuffix$` = positor
)
;
-- Latest perspective -------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $nexus.capsule$.`l$nexus.name$` AS
SELECT
    p.`$schema.metadata.positorSuffix$`,
    cast(null as $schema.metadata.reliabilityRange$) AS `$schema.metadata.reliabilitySuffix$`,
    `$nexus.mnemonic$`.*
FROM
    $schema.metadata.encapsulation$.`_$schema.metadata.positorSuffix$` p,
    $nexus.capsule$.`t$nexus.name$`(
        p.`$schema.metadata.positorSuffix$`,
        CAST($schema.EOT$ AS $schema.metadata.chronon$),
        CAST($schema.EOT$ AS $schema.metadata.positingRange$),
        '+'
    ) `$nexus.mnemonic$`
;
-- Point-in-time perspective ------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE TABLE FUNCTION $nexus.capsule$.`p$nexus.name$` (
    changingTimepoint $schema.metadata.chronon$
)
AS (
SELECT
    p.`$schema.metadata.positorSuffix$`,
    cast(null as $schema.metadata.reliabilityRange$) AS `$schema.metadata.reliabilitySuffix$`,
    `$nexus.mnemonic$`.`$nexus.identityColumnName$`,
$/ if schema.METADATA
    `$nexus.mnemonic$`.`$nexus.metadataColumnName$`,
$/ endif
$/ foreach role in nexus.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    `$nexus.mnemonic$`.`$role.knotChecksumColumnName$`,
$/ endif
    `$nexus.mnemonic$`.`$role.knotValueColumnName$`,
$/ if schema.METADATA
    `$nexus.mnemonic$`.`$role.knotMetadataColumnName$`,
$/ endif
$/ endif
    `$nexus.mnemonic$`.`$role.columnName$`,
$/ endfor
$/ foreach attribute in nexus.attributes
$/ if schema.IMPROVED
    `$nexus.mnemonic$`.`$attribute.entityReferenceName$`,
$/ endif
$/ if schema.METADATA
    `$nexus.mnemonic$`.`$attribute.metadataColumnName$`,
$/ endif
    `$nexus.mnemonic$`.`$attribute.identityColumnName$`,
$/ if attribute.timeRange
    `$nexus.mnemonic$`.`$attribute.changingColumnName$`,
$/ endif
    `$nexus.mnemonic$`.`$attribute.positingColumnName$`,
    `$nexus.mnemonic$`.`$attribute.positorColumnName$`,
    `$nexus.mnemonic$`.`$attribute.reliabilityColumnName$`,
    `$nexus.mnemonic$`.`$attribute.assertionColumnName$`,
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    `$nexus.mnemonic$`.`$attribute.knotChecksumColumnName$`,
$/ endif
    `$nexus.mnemonic$`.`$attribute.knotValueColumnName$`,
$/ if schema.METADATA
    `$nexus.mnemonic$`.`$attribute.knotMetadataColumnName$`,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    `$nexus.mnemonic$`.`$attribute.checksumColumnName$`,
$/ endif
    `$nexus.mnemonic$`.`$attribute.valueColumnName$`$/ if not attribute.last() ,$/ endif
$/ endfor
FROM
    $schema.metadata.encapsulation$.`_$schema.metadata.positorSuffix$` p,
    $nexus.capsule$.`t$nexus.name$`(
        p.`$schema.metadata.positorSuffix$`,
        CAST(changingTimepoint AS $schema.metadata.chronon$),
        CAST($schema.EOT$ AS $schema.metadata.positingRange$),
        '+'
    ) `$nexus.mnemonic$`
)
;
-- Now perspective ----------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $nexus.capsule$.`n$nexus.name$` AS
SELECT
    p.`$schema.metadata.positorSuffix$`,
    cast(null as $schema.metadata.reliabilityRange$) AS `$schema.metadata.reliabilitySuffix$`,
    `$nexus.mnemonic$`.*
FROM
    $schema.metadata.encapsulation$.`_$schema.metadata.positorSuffix$` p,
    $nexus.capsule$.`t$nexus.name$`(
        p.`$schema.metadata.positorSuffix$`,
        CAST($schema.metadata.now$ AS $schema.metadata.chronon$),
        CAST($schema.EOT$ AS $schema.metadata.positingRange$),
        '+'
    ) `$nexus.mnemonic$`
;
$/ if nexus.historizedAttributes
-- Difference perspective ---------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE TABLE FUNCTION $nexus.capsule$.`d$nexus.name$` (
    intervalStart $schema.metadata.chronon$,
    intervalEnd $schema.metadata.chronon$,
    selection string
)
AS (
-- each change in the interval, with what the time-traveling perspective shows then as it is known now, for each
-- positor: the posit shown at each changing time is joined with the changing time until which it holds, when the next
-- changing time with an assertion that is not a retraction is. BigQuery cannot call the time-traveling perspective
-- for each change, since it cannot evaluate a function with an outer join on its argument for each row of another
-- table.
SELECT
    p.`$schema.metadata.positorSuffix$`,
    tp.inspectedTimepoint,
    `$nexus.mnemonic$`.`$nexus.identityColumnName$`,
$/ if schema.METADATA
    `$nexus.mnemonic$`.`$nexus.metadataColumnName$`,
$/ endif
$/ foreach role in nexus.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    `k$role.name$`.`$role.knot.checksumColumnName$` AS `$role.knotChecksumColumnName$`,
$/ endif
    `k$role.name$`.`$role.knot.valueColumnName$` AS `$role.knotValueColumnName$`,
$/ if schema.METADATA
    `k$role.name$`.`$role.knot.metadataColumnName$` AS `$role.knotMetadataColumnName$`,
$/ endif
$/ endif
    `$nexus.mnemonic$`.`$role.columnName$`,
$/ endfor
$/ foreach attribute in nexus.attributes
$/ if schema.IMPROVED
    `$attribute.mnemonic$`.`$attribute.entityReferenceName$`,
$/ endif
$/ if schema.METADATA
    `$attribute.mnemonic$`.`$attribute.metadataColumnName$`,
$/ endif
    `$attribute.mnemonic$`.`$attribute.identityColumnName$`,
$/ if attribute.timeRange
    `$attribute.mnemonic$`.`$attribute.changingColumnName$`,
$/ endif
    `$attribute.mnemonic$`.`$attribute.positingColumnName$`,
    `$attribute.mnemonic$`.`$attribute.positorColumnName$`,
    `$attribute.mnemonic$`.`$attribute.reliabilityColumnName$`,
    `$attribute.mnemonic$`.`$attribute.assertionColumnName$`,
$/ if attribute.isKnotted
$/ if attribute.knot.hasChecksum
    `k$attribute.mnemonic$`.`$attribute.knot.checksumColumnName$` AS `$attribute.knotChecksumColumnName$`,
$/ endif
    `k$attribute.mnemonic$`.`$attribute.knot.valueColumnName$` AS `$attribute.knotValueColumnName$`,
$/ if schema.METADATA
    `k$attribute.mnemonic$`.`$attribute.knot.metadataColumnName$` AS `$attribute.knotMetadataColumnName$`,
$/ endif
$/ endif
$/ if attribute.hasChecksum
    `$attribute.mnemonic$`.`$attribute.checksumColumnName$`,
$/ endif
    `$attribute.mnemonic$`.`$attribute.valueColumnName$`$/ if not attribute.last() ,$/ endif
$/ endfor
FROM
    $schema.metadata.encapsulation$.`_$schema.metadata.positorSuffix$` p
JOIN (
$/ foreach historized in nexus.historizedAttributes
    SELECT DISTINCT
        `$historized.positorColumnName$` AS positor,
        `$historized.entityReferenceName$` AS `$nexus.identityColumnName$`,
        CAST(`$historized.changingColumnName$` AS $schema.metadata.chronon$) AS inspectedTimepoint,
        '$historized.mnemonic$' AS mnemonic
    FROM
        $historized.capsule$.`$historized.name$`
    WHERE
        (selection IS NULL OR selection LIKE '%$historized.mnemonic$%')
    AND
        `$historized.changingColumnName$` BETWEEN intervalStart AND intervalEnd
$/ if not historized.last()
    UNION DISTINCT
$/ endif
$/ endfor
) tp
ON
    tp.positor = p.`$schema.metadata.positorSuffix$`
JOIN
    $nexus.capsule$.`$nexus.name$` `$nexus.mnemonic$`
ON
    `$nexus.mnemonic$`.`$nexus.identityColumnName$` = tp.`$nexus.identityColumnName$`
$/ foreach role in nexus.knotRoles
LEFT JOIN
    $role.knot.capsule$.`$role.knot.name$` `k$role.name$`
ON
    `k$role.name$`.`$role.knot.identityColumnName$` = `$nexus.mnemonic$`.`$role.columnName$`
$/ endfor
$/ foreach attribute in nexus.attributes
LEFT JOIN (
$/ if attribute.isHistorized
    SELECT
        y.*,
        lead(y.`$attribute.changingColumnName$`) OVER (
            PARTITION BY y.`$attribute.positorColumnName$`, y.`$attribute.entityReferenceName$`
            ORDER BY y.`$attribute.changingColumnName$`
        ) AS `until`
    FROM (
        -- one posit for each changing time with an assertion that is not a retraction: the positive one that is shown
        -- if there is one, and otherwise a negative one, which means that nothing is shown from that time on
        SELECT
            r.*
        FROM
            $attribute.capsule$.`r$attribute.name$`(
                CAST(null AS $schema.metadata.positorRange$),
                CAST($schema.EOT$ AS $attribute.timeRange$),
                CAST($schema.EOT$ AS $schema.metadata.positingRange$)
            ) r
        WHERE
            r.`$attribute.assertionColumnName$` <> '?'
        QUALIFY
            row_number() OVER (
                PARTITION BY r.`$attribute.positorColumnName$`, r.`$attribute.entityReferenceName$`, r.`$attribute.changingColumnName$`
                ORDER BY
                    IF(r.`$attribute.assertionColumnName$` = '+', 0, 1),
                    r.`$attribute.positingColumnName$` DESC,
                    r.`$attribute.reliabilityColumnName$` DESC
            ) = 1
    ) y
$/ else
    SELECT
        r.*
    FROM
        $attribute.capsule$.`r$attribute.name$`(
            CAST(null AS $schema.metadata.positorRange$),
            CAST($schema.EOT$ AS $schema.metadata.positingRange$)
        ) r
    WHERE
        r.`$attribute.assertionColumnName$` = '+'
    QUALIFY
        row_number() OVER (
            PARTITION BY r.`$attribute.positorColumnName$`, r.`$attribute.entityReferenceName$`
            ORDER BY
                r.`$attribute.positingColumnName$` DESC,
                r.`$attribute.reliabilityColumnName$` DESC
        ) = 1
$/ endif
) `$attribute.mnemonic$`
ON
    `$attribute.mnemonic$`.`$attribute.entityReferenceName$` = `$nexus.mnemonic$`.`$nexus.identityColumnName$`
AND
    `$attribute.mnemonic$`.`$attribute.positorColumnName$` = tp.positor
$/ if attribute.isHistorized
AND
    `$attribute.mnemonic$`.`$attribute.assertionColumnName$` = '+'
AND
    `$attribute.mnemonic$`.`$attribute.changingColumnName$` <= CAST(tp.inspectedTimepoint AS $attribute.timeRange$)
AND (
    `$attribute.mnemonic$`.`until` IS NULL
OR
    `$attribute.mnemonic$`.`until` > CAST(tp.inspectedTimepoint AS $attribute.timeRange$)
)
$/ endif
$/ if attribute.isKnotted
LEFT JOIN
    $attribute.knot.capsule$.`$attribute.knot.name$` `k$attribute.mnemonic$`
ON
    `k$attribute.mnemonic$`.`$attribute.knot.identityColumnName$` = `$attribute.mnemonic$`.`$attribute.knotReferenceName$`
$/ endif
$/ endfor
)
;
$/ endif
$/ endif
$/ endfor
