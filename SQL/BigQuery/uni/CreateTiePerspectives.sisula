-- TIE TEMPORAL PERSPECTIVES ------------------------------------------------------------------------------------------
--
-- BigQuery tie perspectives: latest (l), point-in-time (p), now (n) and difference (d).
--
$/ foreach tie in schema.ties
-- Latest perspective -------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $tie.capsule$.`l$tie.name$` (
$/ if schema.METADATA
    `$tie.metadataColumnName$`,
$/ endif
$/ if tie.isHistorized
    `$tie.changingColumnName$`,
$/ endif
$- the column list mirrors the select list below, since view column descriptions are given here, with the view
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    `$role.knotChecksumColumnName$`,
$/ endif
    $/ if role.hasComment `$role.knotValueColumnName$` OPTIONS(description='$role.comment$')$/ else `$role.knotValueColumnName$`$/ endif,
$/ if role.knot.isEquivalent
    `$role.knotEquivalentColumnName$`,
$/ endif
$/ if schema.METADATA
    `$role.knotMetadataColumnName$`,
$/ endif
$/ endif
    $/ if role.hasComment `$role.columnName$` OPTIONS(description='$role.comment$')$/ else `$role.columnName$`$/ endif$/ if not role.last() ,$/ endif
$/ endfor
)
$/ if tie.hasComment
OPTIONS(description='$tie.comment$')
$/ endif
AS
SELECT
$/ if schema.METADATA
    tie.`$tie.metadataColumnName$`,
$/ endif
$/ if tie.isHistorized
    tie.`$tie.changingColumnName$`,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    `$role.name$`.`$role.knot.checksumColumnName$` AS `$role.knotChecksumColumnName$`,
$/ endif
    `$role.name$`.`$role.knot.valueColumnName$` AS `$role.knotValueColumnName$`,
$/ if role.knot.isEquivalent
    `$role.name$`.`$role.knot.equivalentColumnName$` AS `$role.knotEquivalentColumnName$`,
$/ endif
$/ if schema.METADATA
    `$role.name$`.`$role.knot.metadataColumnName$` AS `$role.knotMetadataColumnName$`,
$/ endif
$/ endif
    tie.`$role.columnName$`$/ if not role.last() ,$/ endif
$/ endfor
FROM
    $tie.capsule$.`$tie.name$` tie
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    $role.knot.capsule$.`e$role.knot.name$`(0) `$role.name$`
$/ else
    $role.knot.capsule$.`$role.knot.name$` `$role.name$`
$/ endif
ON
    `$role.name$`.`$role.knot.identityColumnName$` = tie.`$role.columnName$`
$/ endfor
$/ if tie.isHistorized
WHERE
    TRUE
QUALIFY -- picked by a window rather than by a subquery that refers to the outer row: for a tie without identifiers that
        -- subquery compares with OR, and then a database may keep rows that it should not
$/ if tie.identifiers
    -- the latest value for the identifiers
    tie.`$tie.changingColumnName$` = max(tie.`$tie.changingColumnName$`) OVER (
        PARTITION BY
$/ foreach role in tie.identifiers
            tie.`$role.columnName$`$/ if not role.last() ,$/ endif
$/ endfor
    )
$/ else
    -- a tie without identifiers is one to one: the latest value for each of its anchors
$/ foreach role in tie.anchorRoles
    tie.`$tie.changingColumnName$` = max(tie.`$tie.changingColumnName$`) OVER (PARTITION BY tie.`$role.columnName$`)
$/ if not role.last()
AND
$/ endif
$/ endfor
$/ endif
$/ endif
;
-- Point-in-time perspective ------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE TABLE FUNCTION $tie.capsule$.`p$tie.name$` (
    changingTimepoint $schema.metadata.chronon$
)
AS (
SELECT
$/ if schema.METADATA
    tie.`$tie.metadataColumnName$`,
$/ endif
$/ if tie.isHistorized
    tie.`$tie.changingColumnName$`,
$/ endif
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    `$role.name$`.`$role.knot.checksumColumnName$` AS `$role.knotChecksumColumnName$`,
$/ endif
    `$role.name$`.`$role.knot.valueColumnName$` AS `$role.knotValueColumnName$`,
$/ if role.knot.isEquivalent
    `$role.name$`.`$role.knot.equivalentColumnName$` AS `$role.knotEquivalentColumnName$`,
$/ endif
$/ if schema.METADATA
    `$role.name$`.`$role.knot.metadataColumnName$` AS `$role.knotMetadataColumnName$`,
$/ endif
$/ endif
    tie.`$role.columnName$`$/ if not role.last() ,$/ endif
$/ endfor
FROM
    $tie.capsule$.`$tie.name$` tie
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    $role.knot.capsule$.`e$role.knot.name$`(0) `$role.name$`
$/ else
    $role.knot.capsule$.`$role.knot.name$` `$role.name$`
$/ endif
ON
    `$role.name$`.`$role.knot.identityColumnName$` = tie.`$role.columnName$`
$/ endfor
$/ if tie.isHistorized
WHERE
    tie.`$tie.changingColumnName$` <= changingTimepoint
QUALIFY -- picked by a window rather than by a subquery that refers to the outer row: for a tie without identifiers that
        -- subquery compares with OR, and then a database may keep rows that it should not
$/ if tie.identifiers
    -- the latest value for the identifiers
    tie.`$tie.changingColumnName$` = max(tie.`$tie.changingColumnName$`) OVER (
        PARTITION BY
$/ foreach role in tie.identifiers
            tie.`$role.columnName$`$/ if not role.last() ,$/ endif
$/ endfor
    )
$/ else
    -- a tie without identifiers is one to one: the latest value for each of its anchors
$/ foreach role in tie.anchorRoles
    tie.`$tie.changingColumnName$` = max(tie.`$tie.changingColumnName$`) OVER (PARTITION BY tie.`$role.columnName$`)
$/ if not role.last()
AND
$/ endif
$/ endfor
$/ endif
$/ endif
)
;
-- Now perspective ----------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE VIEW $tie.capsule$.`n$tie.name$` AS
SELECT
    *
FROM
    $tie.capsule$.`p$tie.name$`(CAST($schema.metadata.now$ AS $schema.metadata.chronon$))
;
$/ if tie.isHistorized
-- Difference perspective ---------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------
CREATE OR REPLACE TABLE FUNCTION $tie.capsule$.`d$tie.name$` (
    intervalStart $schema.metadata.chronon$,
    intervalEnd $schema.metadata.chronon$
)
AS (
SELECT
$/ if schema.METADATA
    tie.`$tie.metadataColumnName$`,
$/ endif
    tie.`$tie.changingColumnName$`,
$/ foreach role in tie.roles
$/ if role.knot
$/ if role.knot.hasChecksum
    `$role.name$`.`$role.knot.checksumColumnName$` AS `$role.knotChecksumColumnName$`,
$/ endif
    `$role.name$`.`$role.knot.valueColumnName$` AS `$role.knotValueColumnName$`,
$/ if role.knot.isEquivalent
    `$role.name$`.`$role.knot.equivalentColumnName$` AS `$role.knotEquivalentColumnName$`,
$/ endif
$/ if schema.METADATA
    `$role.name$`.`$role.knot.metadataColumnName$` AS `$role.knotMetadataColumnName$`,
$/ endif
$/ endif
    tie.`$role.columnName$`$/ if not role.last() ,$/ endif
$/ endfor
FROM
    $tie.capsule$.`$tie.name$` tie
$/ foreach role in tie.knotRoles
LEFT JOIN
$/ if role.knot.isEquivalent
    $role.knot.capsule$.`e$role.knot.name$`(0) `$role.name$`
$/ else
    $role.knot.capsule$.`$role.knot.name$` `$role.name$`
$/ endif
ON
    `$role.name$`.`$role.knot.identityColumnName$` = tie.`$role.columnName$`
$/ endfor
WHERE
    tie.`$tie.changingColumnName$` BETWEEN intervalStart AND intervalEnd
)
;
$/ endif
$/ endfor
