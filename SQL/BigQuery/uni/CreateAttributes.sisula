-- ATTRIBUTES ---------------------------------------------------------------------------------------------------------
--
-- Attributes are mutable properties on anchors or nexuses.
-- Attributes have four flavors: static, historized, knotted static, and knotted historized.
--
$/ foreach attribute in schema.attributes
$/ if attribute.ignoredEncryptionGroup
-- $attribute.name$ is in the encryption group $attribute.ignoredEncryptionGroup$, which is not used: this database does not encrypt
-- in this temporalization, so the values are stored as they are
$/ endif
$/ if attribute.isHistorized and not attribute.isKnotted
-- Historized attribute table -----------------------------------------------------------------------------------------
-- $attribute.name$ table (on $attribute.parent.name$)
-----------------------------------------------------------------------------------------------------------------------
$/ if attribute.hasChecksum
-- the checksum is FARM_FINGERPRINT of the value, which the load fills in: a column cannot be computed from another
$/ endif
CREATE TABLE IF NOT EXISTS $attribute.capsule$.`$attribute.name$` (
    `$attribute.entityReferenceName$` $attribute.parent.identity$ not null,
$/ if attribute.isEquivalent
    `$attribute.equivalentColumnName$` $schema.metadata.equivalentRange$ not null,
$/ endif
    `$attribute.valueColumnName$` $attribute.dataRange$ not null,
$/ if attribute.hasChecksum
    `$attribute.checksumColumnName$` int64,
$/ endif
    `$attribute.changingColumnName$` $attribute.timeRange$ not null,
$/ if schema.METADATA
    `$attribute.metadataColumnName$` $schema.metadata.metadataType$ not null,
$/ endif
    PRIMARY KEY (
$/ if attribute.isEquivalent
        `$attribute.equivalentColumnName$`,
$/ endif
        `$attribute.entityReferenceName$`,
        `$attribute.changingColumnName$`
    ) NOT ENFORCED,
    CONSTRAINT `fk$attribute.name$` FOREIGN KEY (`$attribute.entityReferenceName$`) REFERENCES
        $attribute.parent.capsule$.`$attribute.parent.name$`(`$attribute.parent.identityColumnName$`) NOT ENFORCED
)
CLUSTER BY `$attribute.entityReferenceName$`, `$attribute.changingColumnName$`;
$/ endif
$/ if attribute.isHistorized and attribute.isKnotted
-- Knotted historized attribute table ---------------------------------------------------------------------------------
-- $attribute.name$ table (on $attribute.parent.name$)
-----------------------------------------------------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS $attribute.capsule$.`$attribute.name$` (
    `$attribute.entityReferenceName$` $attribute.parent.identity$ not null,
    `$attribute.knotReferenceName$` $attribute.knot.identity$ not null,
    `$attribute.changingColumnName$` $attribute.timeRange$ not null,
$/ if schema.METADATA
    `$attribute.metadataColumnName$` $schema.metadata.metadataType$ not null,
$/ endif
    PRIMARY KEY (
        `$attribute.entityReferenceName$`,
        `$attribute.changingColumnName$`
    ) NOT ENFORCED,
    CONSTRAINT `fk_A_$attribute.name$` FOREIGN KEY (`$attribute.entityReferenceName$`) REFERENCES
        $attribute.parent.capsule$.`$attribute.parent.name$`(`$attribute.parent.identityColumnName$`) NOT ENFORCED,
    CONSTRAINT `fk_K_$attribute.name$` FOREIGN KEY (`$attribute.knotReferenceName$`) REFERENCES
        $attribute.knot.capsule$.`$attribute.knot.name$`(`$attribute.knot.identityColumnName$`) NOT ENFORCED
)
CLUSTER BY `$attribute.entityReferenceName$`, `$attribute.changingColumnName$`;
$/ endif
$/ if not attribute.isHistorized and attribute.isKnotted
-- Knotted static attribute table -------------------------------------------------------------------------------------
-- $attribute.name$ table (on $attribute.parent.name$)
-----------------------------------------------------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS $attribute.capsule$.`$attribute.name$` (
    `$attribute.entityReferenceName$` $attribute.parent.identity$ not null,
    `$attribute.knotReferenceName$` $attribute.knot.identity$ not null,
$/ if schema.METADATA
    `$attribute.metadataColumnName$` $schema.metadata.metadataType$ not null,
$/ endif
    PRIMARY KEY (
        `$attribute.entityReferenceName$`
    ) NOT ENFORCED,
    CONSTRAINT `fk_A_$attribute.name$` FOREIGN KEY (`$attribute.entityReferenceName$`) REFERENCES
        $attribute.parent.capsule$.`$attribute.parent.name$`(`$attribute.parent.identityColumnName$`) NOT ENFORCED,
    CONSTRAINT `fk_K_$attribute.name$` FOREIGN KEY (`$attribute.knotReferenceName$`) REFERENCES
        $attribute.knot.capsule$.`$attribute.knot.name$`(`$attribute.knot.identityColumnName$`) NOT ENFORCED
)
CLUSTER BY `$attribute.entityReferenceName$`;
$/ endif
$/ if not attribute.isHistorized and not attribute.isKnotted
-- Static attribute table ---------------------------------------------------------------------------------------------
-- $attribute.name$ table (on $attribute.parent.name$)
-----------------------------------------------------------------------------------------------------------------------
$/ if attribute.hasChecksum
-- the checksum is FARM_FINGERPRINT of the value, which the load fills in: a column cannot be computed from another
$/ endif
CREATE TABLE IF NOT EXISTS $attribute.capsule$.`$attribute.name$` (
    `$attribute.entityReferenceName$` $attribute.parent.identity$ not null,
$/ if attribute.isEquivalent
    `$attribute.equivalentColumnName$` $schema.metadata.equivalentRange$ not null,
$/ endif
    `$attribute.valueColumnName$` $attribute.dataRange$ not null,
$/ if attribute.hasChecksum
    `$attribute.checksumColumnName$` int64,
$/ endif
$/ if schema.METADATA
    `$attribute.metadataColumnName$` $schema.metadata.metadataType$ not null,
$/ endif
    PRIMARY KEY (
$/ if attribute.isEquivalent
        `$attribute.equivalentColumnName$`,
$/ endif
        `$attribute.entityReferenceName$`
    ) NOT ENFORCED,
    CONSTRAINT `fk$attribute.name$` FOREIGN KEY (`$attribute.entityReferenceName$`) REFERENCES
        $attribute.parent.capsule$.`$attribute.parent.name$`(`$attribute.parent.identityColumnName$`) NOT ENFORCED
)
CLUSTER BY `$attribute.entityReferenceName$`;
$/ endif
$/ endfor
