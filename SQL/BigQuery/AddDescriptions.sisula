-- DESCRIPTIONS -------------------------------------------------------------------------------------------------------
--
-- Descriptions in the model are added as comments on the schema, tables, and the columns holding values and
-- references, making them available to catalogs and semantic layers.
--
$- comment is describe(x), from derive.js: the description escaped for a BigQuery string literal.
$/ if schema.hasComment
ALTER SCHEMA $schema.metadata.encapsulation$ SET OPTIONS(description='$schema.comment$');
$/ endif
$/ foreach knot in schema.knots
$/ if knot.hasComment
$/ if schema.UNI and knot.isEquivalent
ALTER TABLE $knot.capsule$.`$knot.identityName$` SET OPTIONS(description='$knot.comment$');
$/ else
ALTER TABLE $knot.capsule$.`$knot.name$` SET OPTIONS(description='$knot.comment$');
ALTER TABLE $knot.capsule$.`$knot.name$` ALTER COLUMN `$knot.valueColumnName$` SET OPTIONS(description='$knot.comment$');
$/ endif
$/ endif
$/ endfor
$- The original shares this script with crt and bi, where values live in posit tables.
$/ foreach attribute in schema.attributes
$/ if attribute.hasComment
$/ if schema.UNI
ALTER TABLE $attribute.capsule$.`$attribute.name$` ALTER COLUMN `$attribute.valueColumnName$` SET OPTIONS(description='$attribute.comment$');
$/ else
ALTER TABLE $attribute.capsule$.`$attribute.positName$` ALTER COLUMN `$attribute.valueColumnName$` SET OPTIONS(description='$attribute.comment$');
$/ endif
$/ endif
$/ endfor
$/ foreach anchor in schema.anchors
$/ if anchor.hasComment
ALTER TABLE $anchor.capsule$.`$anchor.name$` SET OPTIONS(description='$anchor.comment$');
$/ endif
$/ endfor
$/ foreach nexus in schema.nexuses
$/ if nexus.hasComment
ALTER TABLE $nexus.capsule$.`$nexus.name$` SET OPTIONS(description='$nexus.comment$');
$/ endif
$/ foreach role in nexus.roles
$/ if role.hasComment
ALTER TABLE $nexus.capsule$.`$nexus.name$` ALTER COLUMN `$role.columnName$` SET OPTIONS(description='$role.comment$');
$/ endif
$/ endfor
$/ endfor
$/ foreach tie in schema.ties
$/ if tie.hasComment
$/ if schema.UNI
ALTER TABLE $tie.capsule$.`$tie.name$` SET OPTIONS(description='$tie.comment$');
$/ else
ALTER TABLE $tie.capsule$.`$tie.positName$` SET OPTIONS(description='$tie.comment$');
$/ endif
$/ endif
$/ foreach role in tie.roles
$/ if role.hasComment
$/ if schema.UNI
ALTER TABLE $tie.capsule$.`$tie.name$` ALTER COLUMN `$role.columnName$` SET OPTIONS(description='$role.comment$');
$/ else
ALTER TABLE $tie.capsule$.`$tie.positName$` ALTER COLUMN `$role.columnName$` SET OPTIONS(description='$role.comment$');
$/ endif
$/ endif
$/ endfor
$/ endfor
