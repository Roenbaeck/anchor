# This is the processing directive for concurrent-reliance-temporal Anchor Modeling in SQL Server
#
# The templates are in the Sisula language (docs/SISULA.md) and render the JSON bindings that the
# modeler builds (Generate > JSON bindings). The scripts first in the list prepare the schema that the
# bindings are made from; they run once, before the templates. A line starting with # is not run.
# The original sisulets, which these replace, are listed in SQLServer_crt.legacy.directive.
SQL/Helpers.js
SQL/NamingConvention.js
SQL/SQLServer/NamingConvention.js
SQL/SQLServer/derive.js
SQL/SQLServer/clr/Anchor.sisula
SQL/SQLServer/crt/SetupPositorPartitioning.sisula
SQL/SQLServer/crt/CreatePositorAndDefault.sisula
SQL/SQLServer/crt/CreateKnots.sisula
SQL/SQLServer/crt/CreateAnchors.sisula
SQL/SQLServer/crt/CreateNexuses.sisula
SQL/SQLServer/crt/CreateAttributes.sisula
SQL/SQLServer/crt/CreateAttributeAssembledViews.sisula
SQL/SQLServer/crt/CreateAttributeRewinders.sisula
SQL/SQLServer/crt/AddAttributeRestatementConstraints.sisula
SQL/SQLServer/biz/DropAnchorBusinessPerspectives.sisula
SQL/SQLServer/crt/CreateAnchorPerspectives.sisula
SQL/SQLServer/biz/CreateAnchorBusinessPerspectives.sisula
SQL/SQLServer/biz/DropNexusBusinessPerspectives.sisula
SQL/SQLServer/crt/CreateNexusPerspectives.sisula
SQL/SQLServer/biz/CreateNexusBusinessPerspectives.sisula
SQL/SQLServer/crt/CreateKeyGenerators.sisula
SQL/SQLServer/crt/CreateAttributeTriggers.sisula
SQL/SQLServer/crt/CreateAnchorTriggers.sisula
SQL/SQLServer/crt/CreateNexusTriggers.sisula
SQL/SQLServer/crt/CreateTies.sisula
SQL/SQLServer/crt/CreateTieAssembledViews.sisula
SQL/SQLServer/crt/AddTieRestatementConstraints.sisula
SQL/SQLServer/crt/CreateTieRewinders.sisula
SQL/SQLServer/biz/DropTieBusinessPerspectives.sisula
SQL/SQLServer/crt/CreateTiePerspectives.sisula
SQL/SQLServer/biz/CreateTieBusinessPerspectives.sisula
SQL/SQLServer/crt/CreateTieTriggers.sisula
SQL/SQLServer/crt/CreateAttributeSheetStacks.sisula
SQL/SQLServer/CreateSchemaTracking.sisula
SQL/SQLServer/crt/AddDescriptions.sisula
